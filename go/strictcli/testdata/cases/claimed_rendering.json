[
  {
    "name": "claimed_rendering: unclaimed, the framework renders the log after the handler's output",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "build",
          "help": "build something",
          "effect": "mutating",
          "handler_effects": [
            {
              "method": "mkdir",
              "path": "build"
            },
            {
              "method": "write",
              "path": "VERSION",
              "content": "1.2.3"
            }
          ],
          "handler_prints": "summary"
        }
      ]
    },
    "argv": [
      "--dry-run",
      "build"
    ],
    "expect": {
      "exit_code": 0,
      "stdout_equals": "summary\nDRY RUN — no changes were made. Would do:\n  1. mkdir: build\n  2. write: VERSION (5 bytes)\n"
    }
  },
  {
    "name": "claimed_rendering: render_log puts the identical bytes before the handler's output",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "build",
          "help": "build something",
          "effect": "mutating",
          "handler_effects": [
            {
              "method": "mkdir",
              "path": "build"
            },
            {
              "method": "write",
              "path": "VERSION",
              "content": "1.2.3"
            }
          ],
          "handler_prints": "summary",
          "handler_renders_log": true
        }
      ]
    },
    "argv": [
      "--dry-run",
      "build"
    ],
    "expect": {
      "exit_code": 0,
      "stdout_equals": "DRY RUN — no changes were made. Would do:\n  1. mkdir: build\n  2. write: VERSION (5 bytes)\nsummary\n",
      "stderr_equals": ""
    }
  },
  {
    "name": "claimed_rendering: a rendered log is not repeated at the seam",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "build",
          "help": "build something",
          "effect": "mutating",
          "handler_effects": [
            {
              "method": "mkdir",
              "path": "build"
            },
            {
              "method": "write",
              "path": "VERSION",
              "content": "1.2.3"
            }
          ],
          "handler_renders_log": true
        }
      ]
    },
    "argv": [
      "--dry-run",
      "build"
    ],
    "expect": {
      "exit_code": 0,
      "stdout_equals": "DRY RUN — no changes were made. Would do:\n  1. mkdir: build\n  2. write: VERSION (5 bytes)\n"
    }
  },
  {
    "name": "claimed_rendering: claimed but never rendered is re-rendered at the seam",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "build",
          "help": "build something",
          "effect": "mutating",
          "handler_effects": [
            {
              "method": "mkdir",
              "path": "build"
            },
            {
              "method": "write",
              "path": "VERSION",
              "content": "1.2.3"
            }
          ],
          "handler_prints": "summary",
          "handler_claims_log": true
        }
      ]
    },
    "argv": [
      "--dry-run",
      "build"
    ],
    "expect": {
      "exit_code": 0,
      "stdout_equals": "summary\nDRY RUN — no changes were made. Would do:\n  1. mkdir: build\n  2. write: VERSION (5 bytes)\n"
    }
  },
  {
    "name": "claimed_rendering: a claim that never rendered survives an abort",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "build",
          "help": "build something",
          "effect": "mutating",
          "handler_effects": [
            {
              "method": "mkdir",
              "path": "build"
            },
            {
              "method": "write",
              "path": "VERSION",
              "content": "1.2.3"
            }
          ],
          "handler_claims_log": true,
          "handler_aborts": true
        }
      ]
    },
    "argv": [
      "--dry-run",
      "build"
    ],
    "expect": {
      "exit_code": 2,
      "stdout_equals": "DRY RUN — no changes were made. Would do:\n  1. mkdir: build\n  2. write: VERSION (5 bytes)\n",
      "stderr_contains": "error: dry-run preview ends at step 3: build aborted — the preview above may be incomplete"
    }
  },
  {
    "name": "claimed_rendering: render_log emits nothing outside dry mode",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "build",
          "help": "build something",
          "effect": "mutating",
          "handler_prints": "summary",
          "handler_renders_log": true
        }
      ]
    },
    "argv": [
      "build"
    ],
    "expect": {
      "exit_code": 0,
      "stdout_equals": "summary\n",
      "stderr_equals": ""
    }
  },
  {
    "name": "claimed_rendering: render_log renders the bare header when nothing was recorded",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "build",
          "help": "build something",
          "effect": "mutating",
          "handler_prints": "summary",
          "handler_renders_log": true
        }
      ]
    },
    "argv": [
      "--dry-run",
      "build"
    ],
    "expect": {
      "exit_code": 0,
      "stdout_equals": "DRY RUN — no changes were made. Would do:\nsummary\n",
      "stderr_equals": ""
    }
  },
  {
    "name": "claimed_rendering: render_log is a no-op in machine mode and the preview still rides the envelope",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "build",
          "help": "build something",
          "effect": "mutating",
          "handler_effects": [
            {
              "method": "mkdir",
              "path": "build"
            },
            {
              "method": "write",
              "path": "VERSION",
              "content": "1.2.3"
            }
          ],
          "handler_renders_log": true
        }
      ]
    },
    "argv": [
      "--json",
      "--dry-run",
      "build"
    ],
    "expect": {
      "exit_code": 0,
      "stdout_equals": "{\"interface_version\":3,\"app\":\"myapp\",\"app_version\":\"1.0.0\",\"command\":\"build\",\"exit_code\":0,\"payload\":null,\"output\":null,\"dry_run\":true,\"writes\":null,\"preview\":[{\"detail\":\"build\",\"kind\":\"file_write\",\"recorded\":true,\"seq\":1,\"verb\":\"mkdir\"},{\"bytes\":5,\"detail\":\"VERSION (5 bytes)\",\"kind\":\"file_write\",\"recorded\":true,\"seq\":2,\"verb\":\"write\"}],\"preview_error\":null,\"diagnostics\":[]}\n",
      "stdout_not_contains": "DRY RUN",
      "stderr_equals": ""
    }
  },
  {
    "name": "claimed_rendering: recorded() feeds the handler's own payload",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "build",
          "help": "build something",
          "effect": "mutating",
          "handler_effects": [
            {
              "method": "mkdir",
              "path": "build"
            },
            {
              "method": "write",
              "path": "VERSION",
              "content": "1.2.3"
            }
          ],
          "handler_payloads_recorded": true
        }
      ]
    },
    "argv": [
      "--json",
      "--dry-run",
      "build"
    ],
    "expect": {
      "exit_code": 0,
      "stdout_equals": "{\"interface_version\":3,\"app\":\"myapp\",\"app_version\":\"1.0.0\",\"command\":\"build\",\"exit_code\":0,\"payload\":[\"mkdir\",\"write\"],\"output\":null,\"dry_run\":true,\"writes\":null,\"preview\":[{\"detail\":\"build\",\"kind\":\"file_write\",\"recorded\":true,\"seq\":1,\"verb\":\"mkdir\"},{\"bytes\":5,\"detail\":\"VERSION (5 bytes)\",\"kind\":\"file_write\",\"recorded\":true,\"seq\":2,\"verb\":\"write\"}],\"preview_error\":null,\"diagnostics\":[]}\n"
    }
  },
