[
  {
    "name": "argv value order: a scoped occurrence typed first is the one reported",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "global_flags": [
        {
          "name": "jobs",
          "help": "how many workers",
          "type": "int",
          "presence": "optional"
        }
      ],
      "commands": [
        {
          "name": "run",
          "help": "run the job",
          "effect": "read_only",
          "handler_prints": "via={via}",
          "flags": [
            {
              "name": "before",
              "help": "a root flag declared before the selector",
              "type": "int",
              "presence": "optional"
            },
            {
              "name": "via",
              "help": "delivery channel",
              "presence": "required",
              "elect_by": "selector-token",
              "choices": [
                {
                  "name": "email",
                  "help": "deliver the notification as an email message",
                  "flags": [
                    {
                      "name": "retries",
                      "help": "delivery attempts before giving up",
                      "type": "int",
                      "presence": "optional"
                    }
                  ]
                },
                {
                  "name": "sms",
                  "help": "deliver the notification as a text message",
                  "flags": [
                    {
                      "name": "phone-number",
                      "help": "destination number",
                      "type": "str",
                      "presence": "optional"
                    }
                  ]
                }
              ]
            },
            {
              "name": "after",
              "help": "a root flag declared after the selector",
              "type": "int",
              "presence": "optional"
            }
          ]
        }
      ]
    },
    "argv": [
      "run",
      "--via",
      "email",
      "--retries",
      "nope",
      "--before",
      "nope"
    ],
    "expect": {
      "exit_code": 1,
      "stdout_equals": "",
      "stderr_contains": "--retries: expected integer, got 'nope'"
    }
  },
