  {
    "name": "argv value order: a coercion failure outranks a root callback refusal typed before it",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "run",
          "help": "run the job",
          "effect": "read_only",
          "handler_prints": "via={via}",
          "flags": [
            {
              "name": "before",
              "help": "a root flag declared before the selector",
              "type": "int",
              "presence": "optional",
              "validate": {
                "rejects": [
                  9
                ],
                "message": "nine is refused"
              }
            },
            {
              "name": "via",
              "help": "delivery channel",
              "presence": "required",
              "elect_by": "selector-token",
              "choices": [
                {
                  "name": "email",
                  "help": "deliver the notification as an email message",
                  "flags": [
                    {
                      "name": "retries",
                      "help": "delivery attempts before giving up",
                      "type": "int",
                      "presence": "optional"
                    }
                  ]
                },
                {
                  "name": "sms",
                  "help": "deliver the notification as a text message",
                  "flags": [
                    {
                      "name": "phone-number",
                      "help": "destination number",
                      "type": "str",
                      "presence": "optional"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    "argv": [
      "run",
      "--before",
      "9",
      "--via",
      "email",
      "--retries",
      "nope"
    ],
    "expect": {
      "exit_code": 1,
      "stdout_equals": "",
      "stderr_contains": "--retries: expected integer, got 'nope'"
    }
  },
