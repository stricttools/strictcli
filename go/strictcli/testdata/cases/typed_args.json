            {
              "name": "level",
              "help": "verbosity level",
              "presence": "required",
              "type": "int",
              "choices_int": [
                {
                  "value": 0
                },
                {
                  "value": 1
                },
                {
                  "value": 2
                }
              ]
            }
          ],
          "handler_prints": "level={level}"
        }
      ]
