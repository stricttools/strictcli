[
  {
    "name": "selector delivery: the selector's own key is the only key it adds",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "send",
          "help": "send one notification",
          "effect": "read_only",
          "flags": [
            {
              "name": "via",
              "help": "delivery channel",
              "presence": "required",
              "elect_by": "selector-token",
              "choices": [
                {
                  "name": "email",
                  "help": "deliver the notification as an email message",
                  "flags": [
                    {
                      "name": "subject",
                      "help": "subject line of the message",
                      "type": "str",
                      "presence": "required"
                    },
                    {
                      "name": "cc",
                      "help": "an optional carbon copy",
                      "type": "str",
                      "presence": "optional"
                    },
                    {
                      "name": "tags",
                      "help": "labels to attach",
                      "type": "list[str]",
                      "presence": "default",
                      "default": [],
                      "unique": false
                    },
                    {
                      "name": "headers",
                      "help": "extra headers",
                      "type": "dict[str,str]",
                      "presence": "default",
                      "default": {}
                    }
                  ]
                },
                {
                  "name": "sms",
                  "help": "deliver the notification as a text message",
                  "flags": [
                    {
                      "name": "phone-number",
                      "help": "destination number in E.164 form",
                      "type": "str",
                      "presence": "required"
                    }
                  ]
                }
              ]
            },
            {
              "name": "dry",
              "type": "bool",
              "help": "print what would be sent",
              "presence": "default",
              "default": false
            }
          ],
          "handler_prints": "via={via} dry={dry}"
        }
      ]
    },
    "argv": [
      "send",
      "--via",
      "sms",
      "--phone-number",
      "+15550100"
    ],
    "expect": {
      "exit_code": 0,
      "stdout_equals": "via=sms(phone_number=+15550100) dry=false"
    }
  },
