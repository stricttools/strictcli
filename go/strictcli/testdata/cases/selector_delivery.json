  {
    "name": "selector delivery: provided-ness is answered at every depth",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "publish",
          "help": "publish one entry",
          "effect": "read_only",
          "flags": [
            {
              "name": "visibility",
              "help": "who the entry is for",
              "presence": "required",
              "elect_by": "selector-token",
              "choices": [
                {
                  "name": "internal",
                  "help": "not published to users"
                },
                {
                  "name": "user-facing",
                  "help": "published to users",
                  "flags": [
                    {
                      "name": "type",
                      "help": "the kind of change",
                      "presence": "required",
                      "elect_by": "selector-token",
                      "choices": [
                        {
                          "name": "feature",
                          "help": "a new capability",
                          "flags": [
                            {
                              "name": "description",
                              "help": "what it does for users",
                              "type": "str",
                              "presence": "required"
                            },
                            {
                              "name": "breaking",
                              "help": "whether it breaks callers",
                              "type": "bool",
                              "presence": "default",
                              "default": false
                            }
                          ]
                        },
                        {
                          "name": "fix",
                          "help": "a corrected defect",
                          "flags": [
                            {
                              "name": "symptom",
                              "help": "the user-visible symptom",
                              "type": "str",
                              "presence": "required"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ],
          "handler_prints": "d={provided:visibility.type.description} b={provided:visibility.type.breaking}"
        }
      ]
    },
    "argv": [
      "publish",
      "--visibility",
      "user-facing",
      "--type",
      "feature",
      "--description",
      "x"
    ],
    "expect": {
      "exit_code": 0,
      "stdout_equals": "d=true b=false"
    }
  },
