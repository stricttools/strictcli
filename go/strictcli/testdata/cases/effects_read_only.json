[
  {
    "name": "effects_read_only: a mutating method in a read-only command is a call-time error",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "show",
          "help": "show something",
          "effect": "read_only",
          "handler_effects": [
            {
              "method": "write",
              "path": "out.txt",
              "content": "nope"
            }
          ]
        }
      ]
    },
    "argv": [
      "show"
    ],
    "expect": {
      "exit_code": 2,
      "stderr_contains": "command \"show\" is classified read_only; effects.write is a mutating operation"
    }
  },
  {
