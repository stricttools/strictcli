  {
    "name": "effects_read_only: a non-allowlisted run is refused in a read-only command",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "proc_observe_allowlist": [
        [
          "git",
          "status"
        ]
      ],
      "commands": [
        {
          "name": "show",
          "help": "show something",
          "effect": "read_only",
          "handler_effects": [
            {
              "method": "run",
              "argv": [
                "git",
                "push",
                "origin",
                "main"
              ]
            }
          ]
        }
      ]
    },
    "argv": [
      "show"
    ],
    "expect": {
      "exit_code": 2,
      "stderr_contains": "command \"show\" is classified read_only; effects.run argv git push origin main is not on the app's proc_observe_allowlist"
    }
  },
  {
    "name": "effects_read_only: a run is refused when the app declares no allowlist at all",
