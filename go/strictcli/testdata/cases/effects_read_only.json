  },
  {
    "name": "effects_read_only: an allowlisted run is an observe and executes",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "proc_observe_allowlist": [
        [
          "echo"
        ]
      ],
      "commands": [
        {
          "name": "show",
          "help": "observe something",
          "effect": "read_only",
          "handler_prints": "done",
          "handler_effects": [
            {
              "method": "run",
              "argv": [
                "echo",
                "observed"
              ]
            }
          ]
        }
      ]
    },
    "argv": [
      "show"
    ],
    "expect": {
      "exit_code": 0,
      "stdout_equals": "done\n"
    }
  },
  {
    "name": "effects_read_only: an observe executes in dry mode and is never logged",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "proc_observe_allowlist": [
        [
          "echo"
        ]
      ],
      "commands": [
        {
          "name": "show",
          "help": "observe something",
          "effect": "read_only",
          "handler_prints": "done",
          "handler_effects": [
            {
              "method": "run",
              "argv": [
                "echo",
                "observed"
              ]
            }
          ]
        }
      ]
    },
    "argv": [
      "--dry-run",
      "show"
    ],
    "expect": {
      "exit_code": 0,
      "stdout_equals": "done\nDRY RUN — no changes were made. Would do:\n"
    }
  },
  {
    "name": "effects_read_only: the allowlist matches an argv prefix, not the whole argv",
