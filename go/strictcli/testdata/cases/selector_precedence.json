  {
    "name": "selector precedence: an unknown flag beats a coercion failure on a selector-free command",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "run",
          "help": "run it",
          "effect": "read_only",
          "handler_prints": "count={count}",
          "flags": [
            {
              "name": "count",
              "help": "how many",
              "type": "int",
              "presence": "required"
            },
            {
              "name": "name",
              "help": "a name",
              "type": "str",
              "presence": "optional",
              "validate": {
                "rejects": [
                  "bad"
                ],
                "message": "that name is refused"
              }
            }
          ]
        }
      ]
    },
    "argv": [
      "run",
      "--count",
      "abc",
      "--nosuch"
    ],
    "expect": {
      "exit_code": 1,
      "stderr_equals": "error: unknown flag '--nosuch'\ntry 'myapp run --help'"
    }
  },
