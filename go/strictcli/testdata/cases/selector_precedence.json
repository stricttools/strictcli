[
  {
    "name": "selector precedence: an unknown choice is reported before a scope violation",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "send",
          "help": "send one notification",
          "effect": "read_only",
          "flags": [
            {
              "name": "via",
              "help": "delivery channel",
              "presence": "required",
              "elect_by": "selector-token",
              "choices": [
                {
                  "name": "email",
                  "help": "deliver as an email message",
                  "flags": [
                    {
                      "name": "subject",
                      "help": "subject line of the message",
                      "type": "str",
                      "presence": "required"
                    },
                    {
                      "name": "retries",
                      "help": "delivery attempts",
                      "type": "int",
                      "presence": "optional"
                    }
                  ]
                },
                {
                  "name": "sms",
                  "help": "deliver as a text message",
                  "flags": [
                    {
                      "name": "phone-number",
                      "help": "destination number",
                      "type": "str",
                      "presence": "required"
                    }
                  ]
                }
              ]
            }
          ],
          "handler_prints": "via={via}"
        }
      ]
    },
    "argv": [
      "send",
      "--via",
      "carrier-pigeon",
      "--subject",
      "hi"
    ],
    "expect": {
      "exit_code": 1,
      "stderr_equals": "error: --via: invalid value 'carrier-pigeon', must be one of: email, sms\ntry 'myapp send --help'"
    }
  },
