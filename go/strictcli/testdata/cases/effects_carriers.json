  {
    "name": "effects_carriers: a settled forwarded content still renders a real byte count",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "proc_observe_allowlist": [
        [
          "echo"
        ]
      ],
      "commands": [
        {
          "name": "stamp",
          "help": "observe first, then write what it produced",
          "effect": "mutating",
          "handler_effects": [
            {
              "method": "run",
              "argv": [
                "echo",
                "v1.2.3"
              ]
            },
            {
              "method": "write",
              "path": "VERSION",
              "content": "unused",
              "forward_from": 1
            }
          ]
        }
      ]
    },
    "argv": [
      "--dry-run",
      "stamp"
    ],
    "expect": {
      "exit_code": 0,
      "stdout_equals": "DRY RUN — no changes were made. Would do:\n  1. write: VERSION (6 bytes)\n",
      "effects_equals": [
        {
          "seq": 1,
          "kind": "file_write",
          "verb": "write",
          "detail": "VERSION (6 bytes)",
          "bytes": 6,
          "recorded": true
        }
      ]
    }
  },
  {
    "name": "effects_carriers: branching on a settled pre-mutation observe does not truncate",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "proc_observe_allowlist": [
        [
          "echo"
        ]
      ],
      "commands": [
        {
          "name": "sync",
          "help": "branch on a real value, then record",
          "effect": "mutating",
          "handler_effects": [
            {
              "method": "run",
              "argv": [
                "echo",
                "current"
              ]
            },
            {
              "method": "run",
              "argv": [
                "git",
                "push"
              ],
              "extract_from": 1
            }
          ]
        }
      ]
    },
    "argv": [
      "--dry-run",
      "sync"
    ],
    "expect": {
      "exit_code": 0,
      "stdout_equals": "DRY RUN — no changes were made. Would do:\n",
      "stderr_equals": ""
    }
  }
