          "help": "forward the same carrier twice",
          "effect": "mutating",
          "handler_effects": [
            {
              "method": "run",
              "argv": [
                "git",
                "rev-parse",
                "HEAD"
              ]
            },
            {
              "method": "run",
              "argv": [
                "echo",
                "first"
              ],
              "forward_from": 1
            },
            {
              "method": "run",
              "argv": [
                "echo",
                "second"
              ],
              "forward_from": 1
            }
          ]
        }
      ]
    },
    "argv": [
      "--dry-run",
      "chain"
    ],
    "expect": {
      "exit_code": 0,
      "stdout_equals": "DRY RUN — no changes were made. Would do:\n  1. run: git rev-parse HEAD\n  2. run: echo first «step 1 output»\n  3. run: echo second «step 1 output»\n"
    }
  },
  {
    "name": "effects_carriers: an unsettled content brand replaces the byte count",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "stamp",
          "help": "write a computed version",
          "effect": "mutating",
          "handler_effects": [
            {
              "method": "run",
              "argv": [
                "git",
                "describe",
                "--tags"
              ]
            },
            {
              "method": "write",
              "path": "VERSION",
              "content": "unused",
              "forward_from": 1
            }
          ]
        }
      ]
    },
    "argv": [
      "--dry-run",
      "stamp"
    ],
    "expect": {
      "exit_code": 0,
      "stdout_equals": "DRY RUN — no changes were made. Would do:\n  1. run: git describe --tags\n  2. write: VERSION («step 1 output»)\n"
    }
  },
  {
    "name": "effects_carriers: a carrier forwards into every accepting position",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "positions",
          "help": "forward a carrier into path, dst, url and mode-bearing calls",
          "effect": "mutating",
          "handler_effects": [
            {
              "method": "run",
              "argv": [
                "git",
                "rev-parse",
                "HEAD"
              ]
            },
            {
              "method": "mkdir",
              "path": "unused",
              "forward_from": 1
            },
            {
              "method": "remove",
              "path": "unused",
              "forward_from": 1
            },
            {
              "method": "rename",
              "path": "old.txt",
              "to": "unused",
              "forward_from": 1
            },
            {
              "method": "chmod",
              "path": "unused",
              "mode": "600",
              "forward_from": 1
            },
            {
              "method": "http",
              "http_method": "GET",
              "url": "unused",
              "forward_from": 1
            }
          ]
        }
      ]
    },
    "argv": [
      "--dry-run",
      "positions"
    ],
    "expect": {
      "exit_code": 0,
      "stdout_equals": "DRY RUN — no changes were made. Would do:\n  1. run: git rev-parse HEAD\n  2. mkdir: «step 1 output»\n  3. remove: «step 1 output»\n  4. rename: old.txt -> «step 1 output»\n  5. chmod: «step 1 output» 0600\n  6. net: GET «step 1 output»\n"
    }
  },
  {
    "name": "effects_carriers: an http response forwards into a later argv",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "publish",
          "help": "publish then inspect",
          "effect": "mutating",
          "handler_effects": [
            {
              "method": "http",
              "http_method": "POST",
              "url": "https://api.example.com/releases"
            },
            {
              "method": "run",
              "argv": [
                "gh",
                "release",
                "view"
              ],
              "forward_from": 1
            }
          ]
        }
      ]
    },
    "argv": [
      "--dry-run",
      "publish"
    ],
    "expect": {
      "exit_code": 0,
      "stdout_equals": "DRY RUN — no changes were made. Would do:\n  1. net: POST https://api.example.com/releases\n  2. run: gh release view «step 1 output»\n"
    }
  },
  {
    "name": "effects_carriers: a post-mutation observe yields a stale-branded carrier",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "proc_observe_allowlist": [
        [
          "git",
          "status"
        ]
      ],
      "commands": [
        {
          "name": "report",
          "help": "mutate, then observe, then record the observation",
          "effect": "mutating",
          "handler_effects": [
            {
              "method": "mkdir",
              "path": "build"
            },
            {
              "method": "run",
              "argv": [
                "git",
                "status",
                "--porcelain"
              ]
            },
            {
              "method": "write",
              "path": "report.txt",
              "content": "unused",
              "forward_from": 2
            }
          ]
        }
      ]
    },
    "argv": [
      "--dry-run",
      "report"
    ],
    "expect": {
      "exit_code": 0,
      "stdout_equals": "DRY RUN — no changes were made. Would do:\n  1. mkdir: build\n  2. write: report.txt («stale: git status --porcelain»)\n"
    }
  },
  {
    "name": "effects_carriers: extracting from a carrier truncates the preview",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "chain",
          "help": "branch on an unsettled result",
          "effect": "mutating",
          "handler_effects": [
            {
              "method": "run",
              "argv": [
                "git",
                "tag",
                "v1.2.3"
              ]
            },
            {
              "method": "run",
              "argv": [
                "git",
                "push",
                "origin",
                "v1.2.3"
              ]
            },
            {
              "method": "run",
              "argv": [
                "never",
                "reached"
              ],
              "extract_from": 2
            },
            {
              "method": "mkdir",
              "path": "unreachable"
            }
          ]
        }
      ]
    },
    "argv": [
      "--dry-run",
      "chain"
    ],
    "expect": {
      "exit_code": 1,
      "stdout_equals": "DRY RUN — no changes were made. Would do:\n  1. run: git tag v1.2.3\n  2. run: git push origin v1.2.3\n",
      "stderr_equals": "error: dry-run preview ends at step 3: chain branched on unsettled value «step 2 output» — cannot preview past this point\n"
    }
  },
