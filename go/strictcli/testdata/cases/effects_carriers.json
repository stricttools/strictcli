[
  {
    "name": "effects_carriers: a forwarded carrier renders its brand in a later argv",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "chain",
          "help": "forward one effect's result into the next",
          "effect": "mutating",
          "handler_effects": [
            {
              "method": "run",
              "argv": [
                "git",
                "rev-parse",
                "HEAD"
              ]
            },
            {
              "method": "run",
              "argv": [
                "gh",
                "release",
                "create"
              ],
              "forward_from": 1
            }
          ]
        }
      ]
    },
    "argv": [
      "--dry-run",
      "chain"
    ],
    "expect": {
      "exit_code": 0,
      "stdout_equals": "DRY RUN — no changes were made. Would do:\n  1. run: git rev-parse HEAD\n  2. run: gh release create «step 1 output»\n"
    }
  },
  {
    "name": "effects_carriers: the brand names the step that produced the carrier",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "chain",
          "help": "forward an earlier step's result past later ones",
          "effect": "mutating",
          "handler_effects": [
            {
              "method": "run",
              "argv": [
                "git",
                "rev-parse",
                "HEAD"
              ]
            },
            {
              "method": "mkdir",
              "path": "build"
            },
            {
              "method": "run",
              "argv": [
                "git",
                "describe"
              ]
            },
            {
              "method": "run",
              "argv": [
                "echo"
              ],
              "forward_from": 1
            },
            {
              "method": "run",
              "argv": [
                "echo"
              ],
              "forward_from": 3
            }
          ]
        }
      ]
    },
    "argv": [
      "--dry-run",
      "chain"
    ],
    "expect": {
      "exit_code": 0,
      "stdout_equals": "DRY RUN — no changes were made. Would do:\n  1. run: git rev-parse HEAD\n  2. mkdir: build\n  3. run: git describe\n  4. run: echo «step 1 output»\n  5. run: echo «step 3 output»\n"
    }
  },
  {
    "name": "effects_carriers: forwarding does not consume the carrier",
