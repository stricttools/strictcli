      "json"
    ],
    "expect": {
      "exit_code": 0,
      "stdout_equals": "format=json"
    }
  },
  {
    "name": "flags: required str flag missing produces error",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "cmd",
          "help": "a command",
          "effect": "read_only",
          "flags": [
            {
              "name": "target",
              "type": "str",
              "help": "the target",
              "presence": "required"
            }
          ],
          "handler_prints": "target={target}"
        }
      ]
    },
    "argv": [
      "cmd"
    ],
    "expect": {
      "exit_code": 1,
      "stderr_contains": "required",
      "stderr_equals": "error: flag '--target' is required\ntry 'myapp cmd --help'"
    }
  },
  {
    "name": "flags: bool flag=value syntax is rejected",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "cmd",
          "help": "a command",
          "effect": "read_only",
          "flags": [
            {
              "name": "chatter",
              "type": "bool",
              "help": "be chatter",
              "presence": "default",
              "default": false
            }
          ],
          "handler_prints": "chatter={chatter}"
        }
      ]
    },
    "argv": [
      "cmd",
      "--chatter=true"
    ],
    "expect": {
      "exit_code": 1,
      "stderr_contains": "boolean flag",
      "stderr_equals": "error: flag '--chatter' is a boolean flag and does not take a value\ntry 'myapp cmd --help'"
    }
  },
  {
    "name": "flags: negatable false rejects --no-flag",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "cmd",
          "help": "a command",
          "effect": "read_only",
          "flags": [
            {
              "name": "chatter",
              "type": "bool",
              "help": "be chatter",
              "presence": "default",
              "negatable": false,
              "default": false
            }
          ],
          "handler_prints": "chatter={chatter}"
        }
      ]
    },
    "argv": [
      "cmd",
      "--no-chatter"
    ],
    "expect": {
      "exit_code": 1,
      "stderr_contains": "unknown flag",
      "stderr_equals": "error: unknown flag '--no-chatter'\ntry 'myapp cmd --help'"
    }
  },
  {
    "name": "flags: negatable true allows --no-flag",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "cmd",
          "help": "a command",
          "effect": "read_only",
          "flags": [
            {
              "name": "chatter",
              "type": "bool",
              "help": "be chatter",
              "presence": "default",
              "negatable": true,
              "default": false
            }
          ],
          "handler_prints": "chatter={chatter}"
        }
      ]
    },
    "argv": [
      "cmd",
      "--no-chatter"
    ],
    "expect": {
      "exit_code": 0,
      "stdout_equals": "chatter=false"
    }
  }
]
