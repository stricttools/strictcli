              "type": "str",
              "help": "the target",
              "presence": "required"
            }
          ],
          "handler_prints": "target={target}"
        }
      ]
    },
    "argv": [
      "cmd",
      "--target=bar"
    ],
    "expect": {
      "exit_code": 0,
      "stdout_equals": "target=bar"
    }
  },
