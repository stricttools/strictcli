[
  {
    "name": "flags: str flag with space syntax",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "cmd",
          "help": "a command",
          "effect": "read_only",
          "flags": [
            {
              "name": "target",
              "type": "str",
              "help": "the target",
              "presence": "required"
            }
          ],
          "handler_prints": "target={target}"
        }
      ]
    },
    "argv": [
      "cmd",
      "--target",
      "foo"
    ],
    "expect": {
      "exit_code": 0,
      "stdout_equals": "target=foo"
    }
  },
  {
    "name": "flags: str flag with equals syntax",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
