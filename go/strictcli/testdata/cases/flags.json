  },
  {
    "name": "flags: str flag with default, provided overrides default",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "cmd",
          "help": "a command",
          "effect": "read_only",
          "flags": [
            {
              "name": "format",
              "type": "str",
              "help": "output format",
              "presence": "default",
              "default": "text"
            }
          ],
          "handler_prints": "format={format}"
        }
      ]
    },
    "argv": [
