[
  {
    "name": "update clear: --unset-<prop> delivers absence, reports provided true and answers ctx.unset",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "update-record",
          "help": "change one DNS record in place",
          "effect": "mutating",
          "update_of": {
            "resource": "dns-record",
            "write_mode": "sparse",
            "identity": [
              "zone"
            ],
            "properties": [
              "content",
              "ttl"
            ]
          },
          "flags": [
            {
              "name": "zone",
              "help": "the zone",
              "presence": "required",
              "type": "str"
            },
            {
              "name": "content",
              "help": "record content",
              "presence": "optional",
              "type": "str"
            },
            {
              "name": "ttl",
              "help": "time to live in seconds",
              "presence": "optional",
              "type": "int",
              "nullable": true
            }
          ],
          "handler_prints": "content={content} ttl={ttl} unset_ttl={unset:ttl} provided_ttl={provided:ttl} unset_content={unset:content}"
        }
      ]
    },
    "argv": [
      "update-record",
      "--zone",
      "z1",
      "--unset-ttl"
    ],
    "expect": {
      "exit_code": 0,
      "stdout_equals": "content=None ttl=None unset_ttl=true provided_ttl=true unset_content=false\n",
      "stderr_equals": ""
    }
  },
