  {
    "name": "choices: env var with valid choice accepted",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "env_prefix": "MYAPP",
      "commands": [
        {
          "name": "cmd",
          "help": "a command",
          "effect": "read_only",
          "flags": [
            {
              "name": "format",
              "type": "str",
              "help": "output format",
              "presence": "default",
              "choices_str": [
                {
                  "value": "text"
                },
                {
                  "value": "json"
                }
              ],
              "default": "text",
              "env": "MYAPP_FORMAT"
            }
          ],
          "handler_prints": "format={format}"
        }
      ]
    },
    "argv": [
      "cmd"
    ],
    "env": {
      "MYAPP_FORMAT": "json"
    },
    "expect": {
      "exit_code": 0,
      "stdout_equals": "format=json"
    }
  },
