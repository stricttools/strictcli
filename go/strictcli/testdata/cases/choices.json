  {
    "name": "choices: a choices flag in an unelected scope is never validated",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "cmd",
          "help": "a command",
          "effect": "read_only",
          "flags": [
            {
              "name": "sink",
              "help": "where output goes",
              "presence": "required",
              "elect_by": "selector-token",
              "choices": [
                {
                  "name": "rendered",
                  "help": "a rendered document",
                  "flags": [
                    {
                      "name": "format",
                      "type": "str",
                      "help": "output format",
                      "presence": "optional",
                      "choices_str": [
                        {
                          "value": "text"
                        },
                        {
                          "value": "json"
                        }
                      ]
                    }
                  ]
                },
                {
                  "name": "path",
                  "help": "a file on disk",
                  "flags": [
                    {
                      "name": "output",
                      "type": "str",
                      "help": "output path",
                      "presence": "optional"
                    }
                  ]
                }
              ]
            }
          ],
          "handler_prints": "sink={sink}"
        }
      ]
    },
    "argv": [
      "cmd",
      "--sink",
      "path",
      "--output",
      "out.txt"
    ],
    "expect": {
      "exit_code": 0,
      "stdout_equals": "sink=path(output=out.txt)"
    }
  }
]
