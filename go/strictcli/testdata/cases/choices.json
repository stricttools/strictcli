[
  {
    "name": "choices: valid str choice accepted",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "cmd",
          "help": "a command",
          "effect": "read_only",
          "flags": [
            {
              "name": "format",
              "type": "str",
              "help": "output format",
              "presence": "required",
              "choices_str": [
                {
                  "value": "text"
                },
                {
                  "value": "json"
                }
              ]
            }
          ],
          "handler_prints": "format={format}"
        }
      ]
    },
    "argv": [
      "cmd",
      "--format",
      "json"
    ],
    "expect": {
      "exit_code": 0,
      "stdout_equals": "format=json"
    }
  },
  {
    "name": "choices: invalid str choice rejected",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "cmd",
          "help": "a command",
          "effect": "read_only",
          "flags": [
            {
              "name": "format",
              "type": "str",
              "help": "output format",
              "presence": "required",
              "choices_str": [
                {
                  "value": "text"
                },
                {
                  "value": "json"
                }
              ]
            }
          ],
          "handler_prints": "format={format}"
        }
      ]
    },
    "argv": [
      "cmd",
      "--format",
      "xml"
    ],
    "expect": {
      "exit_code": 1,
      "stderr_contains": [
        "invalid value",
        "'xml'",
        "text",
        "json"
      ],
      "stderr_equals": "error: --format: invalid value 'xml', must be one of: text, json\ntry 'myapp cmd --help'"
    }
  },
  {
    "name": "choices: shown in help output",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "cmd",
          "help": "a command",
          "effect": "read_only",
          "flags": [
            {
              "name": "format",
              "type": "str",
              "help": "output format",
              "presence": "default",
              "choices_str": [
                {
                  "value": "text"
                },
                {
                  "value": "json"
                }
              ],
              "default": "text"
            }
          ],
          "handler_prints": "ok"
        }
      ]
    },
    "argv": [
      "cmd",
      "--help"
    ],
    "expect": {
      "exit_code": 0,
      "stdout_contains": "choices: text, json",
      "stdout_equals": "myapp cmd -- a command\n\nFlags:\n  --format <str>    output format [choices: text, json] [default: text]"
    }
  },
  {
    "name": "choices: valid int choice accepted",
