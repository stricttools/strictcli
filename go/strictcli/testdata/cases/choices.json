  {
    "name": "choices: optional arg with choices not passed succeeds",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "cmd",
          "help": "a command",
          "effect": "read_only",
          "args": [
            {
              "name": "env",
              "help": "target env",
              "presence": "optional",
              "choices_str": [
                {
                  "value": "dev"
                },
                {
                  "value": "prod"
                }
              ]
            }
          ],
          "handler_prints": "env={env}"
        }
      ]
    },
    "argv": [
      "cmd"
    ],
    "expect": {
      "exit_code": 0,
      "stdout_equals": "env=None"
    }
  },
  {
    "name": "choices: optional arg with choices and no default not passed succeeds",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "cmd",
          "help": "a command",
          "effect": "read_only",
          "args": [
            {
              "name": "env",
              "help": "target env",
              "presence": "optional",
              "choices_str": [
                {
                  "value": "dev"
                },
                {
                  "value": "prod"
                }
              ]
            }
          ],
          "handler_prints": "env={env}"
        }
