                {
                  "value": 443
                },
                {
                  "value": 8080
                }
              ]
            }
          ],
          "handler_prints": "port={port}"
        }
      ]
    },
    "argv": [
      "cmd",
      "--port",
      "443"
    ],
    "expect": {
      "exit_code": 0,
      "stdout_equals": "port=443"
    }
  },
  {
