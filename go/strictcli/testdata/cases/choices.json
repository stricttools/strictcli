      "stdout_equals": "env=None"
    }
  },
  {
    "name": "choices: optional arg with choices invalid value rejected",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "cmd",
          "help": "a command",
          "effect": "read_only",
          "args": [
            {
              "name": "env",
              "help": "target env",
              "presence": "optional",
              "choices_str": [
                {
                  "value": "dev"
                },
                {
                  "value": "prod"
                }
              ]
            }
          ],
          "handler_prints": "env={env}"
        }
