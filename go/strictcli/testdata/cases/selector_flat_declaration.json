                      "type": "str",
                      "presence": "optional"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "name": "noop",
          "help": "a command the case argv can run without output",
          "effect": "read_only",
          "handler_returns": {
            "kind": "exit",
            "code": 0
          }
        }
      ]
    },
    "argv": [
      "noop"
    ],
    "expect": {
      "exit_code": 0,
      "stdout_equals": "fmt=json prov=false\ncall ok: send\n",
      "stderr_equals": ""
