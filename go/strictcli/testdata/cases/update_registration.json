[
  {
    "name": "update registration: update_of on a read_only command",
    "skip_schema_validation": true,
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "cmd",
          "help": "a command",
          "effect": "read_only",
          "handler_prints": "ok",
          "update_of": {
            "resource": "dns-record",
            "write_mode": "sparse",
            "identity": [],
            "properties": [
              "content"
            ]
          },
          "flags": [
            {
              "name": "content",
              "help": "record content",
              "presence": "optional",
              "type": "str"
            }
          ]
        }
      ]
    },
    "argv": [
      "cmd"
    ],
    "expect": {
      "exit_code": 1,
      "stdout_equals": "",
      "stderr_equals": "error: command \"cmd\": a read_only command cannot declare update_of (a command that changes nothing writes no properties)\n"
    }
  },
