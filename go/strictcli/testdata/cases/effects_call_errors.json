[
  {
    "name": "effects_call_errors: an option the method does not accept is a call-time error",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "build",
          "help": "build something",
          "effect": "mutating",
          "handler_effects": [
            {
              "method": "mkdir",
              "path": "d",
              "stream": true
            }
          ]
        }
      ]
    },
    "argv": [
      "--dry-run",
      "build"
    ],
    "expect": {
      "exit_code": 2,
      "stderr_contains": "command \"build\": effects.mkdir does not accept option 'stream'"
    }
  },
  {
    "name": "effects_call_errors: stream is refused by write as well",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "build",
          "help": "build something",
          "effect": "mutating",
          "handler_effects": [
            {
              "method": "write",
              "path": "out.txt",
              "content": "hi",
              "stream": true
            }
          ]
        }
      ]
    },
    "argv": [
      "--dry-run",
      "build"
    ],
    "expect": {
      "exit_code": 2,
      "stderr_contains": "command \"build\": effects.write does not accept option 'stream'"
    }
  },
  {
    "name": "effects_call_errors: stream is refused by http as well",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "publish",
          "help": "publish something",
          "effect": "mutating",
          "handler_effects": [
            {
              "method": "http",
              "http_method": "POST",
              "url": "https://api.example.com/x",
              "stream": true
            }
          ]
        }
      ]
    },
    "argv": [
      "--dry-run",
      "publish"
    ],
    "expect": {
      "exit_code": 2,
      "stderr_contains": "command \"publish\": effects.http does not accept option 'stream'"
    }
  },
  {
    "name": "effects_call_errors: stream is accepted by run",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "build",
          "help": "build something",
          "effect": "mutating",
          "handler_effects": [
            {
              "method": "run",
              "argv": [
                "make",
                "all"
              ],
              "stream": true
            }
          ]
        }
      ]
    },
    "argv": [
      "--dry-run",
      "build"
    ],
    "expect": {
      "exit_code": 0,
      "stdout_equals": "DRY RUN — no changes were made. Would do:\n  1. run: make all\n"
    }
  },
  {
    "name": "effects_call_errors: a void result is not forwardable",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "build",
          "help": "build something",
          "effect": "mutating",
          "handler_effects": [
            {
              "method": "mkdir",
              "path": "build"
            },
            {
              "method": "run",
              "argv": [
                "echo"
              ],
              "forward_from": 1
            }
          ]
        }
      ]
    },
    "argv": [
      "--dry-run",
      "build"
    ],
    "expect": {
      "exit_code": 2,
      "stderr_contains": "command \"build\": effects.run parameter 'argv[1]' does not accept an unsettled value"
    }
  },
  {
    "name": "effects_call_errors: a void result is not forwardable into a path either",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "build",
          "help": "build something",
          "effect": "mutating",
          "handler_effects": [
            {
              "method": "write",
              "path": "a.txt",
              "content": "hi"
            },
            {
              "method": "mkdir",
              "path": "unused",
              "forward_from": 1
            }
          ]
        }
      ]
    },
    "argv": [
      "--dry-run",
      "build"
    ],
    "expect": {
      "exit_code": 2,
      "stderr_contains": "command \"build\": effects.mkdir parameter 'path' does not accept an unsettled value"
    }
  },
  {
    "name": "effects_call_errors: a spawned handle has no scalar projection",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "build",
          "help": "build something",
          "effect": "mutating",
          "handler_effects": [
            {
              "method": "spawn",
              "argv": [
                "worker"
              ]
            },
            {
              "method": "run",
              "argv": [
                "echo"
              ],
              "forward_from": 1
            }
          ]
        }
      ]
    },
    "argv": [
      "--dry-run",
      "build"
    ],
    "expect": {
      "exit_code": 2,
      "stderr_contains": "command \"build\": effects.run parameter 'argv[1]' does not accept an unsettled value"
    }
  },
  {
    "name": "effects_call_errors: an empty argv is a call-time error",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "build",
          "help": "build something",
          "effect": "mutating",
          "handler_effects": [
            {
              "method": "run",
              "argv": []
            }
          ]
        }
      ]
    },
    "argv": [
      "--dry-run",
      "build"
    ],
    "expect": {
      "exit_code": 2,
      "stderr_contains": "command \"build\": effects.run argv must not be empty"
    }
  },
  {
    "name": "effects_call_errors: a nonzero exit fails the run call",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "build",
          "help": "build something",
          "effect": "mutating",
          "handler_effects": [
            {
              "method": "run",
              "argv": [
                "sh",
                "-c",
                "exit 3"
              ]
            }
          ]
        }
      ]
    },
    "argv": [
      "build"
    ],
    "expect": {
      "exit_code": 2,
      "stderr_contains": "command \"build\": effects.run failed: sh -c exit 3 exited 3"
    }
  },
  {
    "name": "effects_call_errors: a nonzero exit fails an allowlisted observe too",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "proc_observe_allowlist": [
        [
          "sh"
        ]
      ],
      "commands": [
        {
          "name": "show",
          "help": "observe something",
          "effect": "read_only",
          "handler_effects": [
            {
              "method": "run",
              "argv": [
                "sh",
                "-c",
                "exit 7"
              ]
            }
          ]
        }
      ]
    },
    "argv": [
      "show"
    ],
    "expect": {
      "exit_code": 2,
      "stderr_contains": "command \"show\": effects.run failed: sh -c exit 7 exited 7"
    }
  },
  {
    "name": "effects_call_errors: captured output that is not valid UTF-8 fails the call",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "proc_observe_allowlist": [
        [
          "sh"
        ]
      ],
      "commands": [
        {
          "name": "show",
          "help": "observe something",
          "effect": "read_only",
          "handler_effects": [
            {
              "method": "run",
              "argv": [
                "sh",
                "-c",
                "printf '\\377'"
              ]
            }
          ]
        }
      ]
    },
    "argv": [
      "show"
    ],
    "expect": {
      "exit_code": 2,
      "stderr_contains": "command \"show\": effects.run produced output that is not valid UTF-8"
    }
  }
]
