[
  {
    "name": "required_bools: missing required bool (negatable) errors",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "cmd",
          "help": "a command",
          "effect": "read_only",
          "flags": [
            {
              "name": "chatter",
              "type": "bool",
              "help": "be chatter",
              "presence": "required"
            }
          ],
          "handler_prints": "chatter={chatter}"
        }
      ]
    },
    "argv": [
      "cmd"
    ],
    "expect": {
      "exit_code": 1,
      "stderr_contains": "flag '--chatter' must be passed as --chatter or --no-chatter"
    }
  },
  {
    "name": "required_bools: missing required bool (non-negatable) errors",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "cmd",
          "help": "a command",
          "effect": "read_only",
          "flags": [
            {
              "name": "chatter",
              "type": "bool",
              "help": "be chatter",
              "presence": "required",
              "negatable": false
            }
          ],
          "handler_prints": "chatter={chatter}"
        }
      ]
    },
    "argv": [
      "cmd"
    ],
    "expect": {
      "exit_code": 1,
      "stderr_contains": "flag '--chatter' must be passed as --chatter"
    }
  },
  {
    "name": "required_bools: required bool with --flag receives true",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "cmd",
          "help": "a command",
          "effect": "read_only",
          "flags": [
            {
              "name": "chatter",
              "type": "bool",
              "help": "be chatter",
              "presence": "required"
            }
          ],
          "handler_prints": "chatter={chatter}"
        }
      ]
    },
    "argv": [
      "cmd",
      "--chatter"
    ],
    "expect": {
      "exit_code": 0,
      "stdout_equals": "chatter=true"
    }
  },
  {
    "name": "required_bools: required bool with --no-flag receives false",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "cmd",
          "help": "a command",
          "effect": "read_only",
          "flags": [
            {
              "name": "chatter",
              "type": "bool",
              "help": "be chatter",
              "presence": "required"
            }
          ],
          "handler_prints": "chatter={chatter}"
        }
      ]
    },
    "argv": [
      "cmd",
      "--no-chatter"
    ],
    "expect": {
      "exit_code": 0,
      "stdout_equals": "chatter=false"
    }
  },
  {
    "name": "required_bools: required bool satisfied by env var",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "env_prefix": "MYAPP",
      "commands": [
        {
          "name": "cmd",
          "help": "a command",
          "effect": "read_only",
          "flags": [
            {
              "name": "chatter",
              "type": "bool",
              "help": "be chatter",
              "presence": "required",
              "env": "MYAPP_CHATTER"
            }
          ],
          "handler_prints": "chatter={chatter}"
        }
      ]
    },
    "argv": [
      "cmd"
    ],
    "env": {
      "MYAPP_CHATTER": "true"
    },
    "expect": {
      "exit_code": 0,
      "stdout_equals": "chatter=true"
    }
  },
  {
    "name": "required_bools: required bool with short form -v receives true",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "cmd",
          "help": "a command",
          "effect": "read_only",
          "flags": [
            {
              "name": "chatter",
              "type": "bool",
              "short": "v",
              "help": "be chatter",
              "presence": "required"
            }
          ],
          "handler_prints": "chatter={chatter}"
        }
      ]
    },
    "argv": [
      "cmd",
      "-v"
    ],
    "expect": {
      "exit_code": 0,
      "stdout_equals": "chatter=true"
    }
  },
  {
    "name": "required_bools: optional bool with default false not passed",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "cmd",
          "help": "a command",
          "effect": "read_only",
          "flags": [
            {
              "name": "chatter",
              "type": "bool",
              "help": "be chatter",
              "presence": "default",
              "default": false
            }
          ],
          "handler_prints": "chatter={chatter}"
        }
      ]
    },
    "argv": [
      "cmd"
    ],
    "expect": {
      "exit_code": 0,
      "stdout_equals": "chatter=false"
    }
  }
]
