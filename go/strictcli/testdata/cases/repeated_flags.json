[
  {
    "name": "repeated flag: a str flag given twice in the space form is refused",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "global_flags": [
        {
          "name": "region",
          "type": "str",
          "help": "the region",
          "presence": "default",
          "default": "eu",
          "short": "r"
        }
      ],
      "commands": [
        {
          "name": "run",
          "help": "run it",
          "effect": "read_only",
          "flags": [
            {
              "name": "commits",
              "type": "str",
              "help": "the commit range",
              "presence": "optional",
              "short": "c",
              "env": "MYAPP_COMMITS"
            },
            {
              "name": "cache",
              "type": "bool",
              "help": "use the cache",
              "presence": "default",
              "default": true,
              "short": "k"
            },
            {
              "name": "count",
              "type": "int",
              "help": "a count",
              "presence": "optional"
            }
          ],
          "handler_prints": "commits={commits} cache={cache} region={region}"
        }
      ]
    },
    "argv": [
      "run",
      "--commits",
      "a",
      "--commits",
      "b"
    ],
    "expect": {
      "exit_code": 1,
      "stdout_equals": "",
      "stderr_equals": "error: --commits: given more than once, as '--commits a' and '--commits b'; it takes one value\ntry 'myapp run --help'"
    }
  },
