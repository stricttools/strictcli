[
  {
    "name": "mcp_legacy: the handshake advertises the elicitation-era revision and the declared feature",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "release",
          "help": "a consequential command",
          "effect": "mutating",
          "consequential": true,
          "handler_returns": {
            "kind": "data",
            "data": {
              "released": true
            }
          }
        },
        {
          "name": "look",
          "help": "a read-only command",
          "effect": "read_only",
          "handler_returns": {
            "kind": "data",
            "data": {
              "looked": true
            }
          }
        }
      ]
    },
    "argv": [
      "--mcp"
    ],
    "protocol_script": [
      {
        "send": "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{\"capabilities\":{\"elicitation\":{\"form\":{}}},\"clientInfo\":{\"name\":\"cli\",\"version\":\"1.0.0\"}}}",
        "expect_line": {
          "json_equals": {
            "jsonrpc": "2.0",
            "id": 1,
            "result": {
              "protocolVersion": "2025-11-25",
              "capabilities": {
                "tools": {},
                "experimental": {
                  "dev.smmh.strictcli/consequential-confirmation": {}
                }
              },
              "serverInfo": {
                "name": "myapp",
                "version": "1.0.0"
              }
            }
          }
        }
      },
      {
        "send": "{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"tools/call\",\"params\":{\"name\":\"look\",\"arguments\":{}}}",
        "expect_line": {
          "json_equals": {
            "jsonrpc": "2.0",
            "id": 2,
            "result": {
              "content": [
                {
                  "type": "text",
                  "text": "$ANY"
                }
              ]
            }
          }
        }
      }
    ],
    "expect": {
      "exit_code": 0,
      "stderr_equals": "",
      "stdout_contains": [
        "looked"
      ]
    }
  },
  {
    "name": "mcp_legacy: an unconsented consequential call is asked over a server-initiated elicitation, and the answer lets it run",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "release",
          "help": "a consequential command",
          "effect": "mutating",
          "consequential": true,
          "handler_returns": {
            "kind": "data",
            "data": {
              "released": true
            }
          }
        },
        {
          "name": "look",
          "help": "a read-only command",
          "effect": "read_only",
          "handler_returns": {
            "kind": "data",
            "data": {
              "looked": true
            }
          }
        }
      ]
    },
    "argv": [
      "--mcp"
    ],
    "protocol_script": [
      {
        "send": "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{\"capabilities\":{\"elicitation\":{\"form\":{}}},\"clientInfo\":{\"name\":\"cli\",\"version\":\"1.0.0\"}}}",
        "expect_line": {
          "json_equals": {
            "jsonrpc": "2.0",
            "id": 1,
            "result": {
              "protocolVersion": "2025-11-25",
              "capabilities": {
                "tools": {},
                "experimental": {
                  "dev.smmh.strictcli/consequential-confirmation": {}
                }
              },
              "serverInfo": {
                "name": "myapp",
                "version": "1.0.0"
              }
            }
          }
        }
      },
      {
        "send": "{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"tools/call\",\"params\":{\"name\":\"release\",\"arguments\":{}}}",
        "capture": {
          "ask": "id"
        },
        "expect_line": {
          "json_equals": {
            "jsonrpc": "2.0",
            "id": "$ANY",
            "method": "elicitation/create",
            "params": {
              "mode": "form",
              "message": "about to run consequential command 'release'. Proceed?",
              "requestedSchema": {
                "type": "object",
                "properties": {
                  "proceed": {
                    "type": "boolean",
                    "title": "Proceed",
                    "description": "Whether to run the consequential command."
                  }
                },
                "required": [
                  "proceed"
                ]
              }
            }
          }
        }
      },
      {
        "send": "{\"jsonrpc\":\"2.0\",\"id\":\"{{ask}}\",\"result\":{\"action\":\"accept\",\"content\":{\"proceed\":true}}}",
        "expect_line": {
          "json_equals": {
            "jsonrpc": "2.0",
            "id": 2,
            "result": {
              "content": [
                {
                  "type": "text",
                  "text": "$ANY"
                }
              ]
            }
          }
        }
      }
    ],
    "expect": {
      "exit_code": 0,
      "stderr_equals": "",
      "stdout_contains": [
        "released"
      ]
    }
  },
