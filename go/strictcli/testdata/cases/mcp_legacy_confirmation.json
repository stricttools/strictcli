                }
              },
              "serverInfo": {
                "name": "myapp",
                "version": "1.0.0"
              }
            }
          }
        }
      },
      {
        "send": "{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"tools/call\",\"params\":{\"name\":\"release\",\"arguments\":{}}}",
        "capture": {
          "ask": "id"
        },
        "expect_line": {
          "json_equals": {
            "jsonrpc": "2.0",
            "id": "$ANY",
            "method": "elicitation/create",
            "params": {
              "mode": "form",
              "message": "about to run consequential command 'release'. Proceed?",
              "requestedSchema": {
                "type": "object",
                "properties": {
                  "proceed": {
                    "type": "boolean",
                    "title": "Proceed",
                    "description": "Whether to run the consequential command."
                  }
                },
                "required": [
                  "proceed"
                ]
              }
            }
          }
        }
      },
      {
        "send": "{\"jsonrpc\":\"2.0\",\"id\":\"{{ask}}\",\"error\":{\"code\":-32601,\"message\":\"Method not found\"}}",
        "expect_line": {
          "json_equals": {
            "jsonrpc": "2.0",
