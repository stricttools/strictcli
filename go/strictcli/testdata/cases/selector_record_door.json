[
  {
    "name": "record door: a root value refusal outranks a scoped one when the root flag is declared first",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "pre_call": [
        {
          "command": "send",
          "kwargs": {
            "before": "nope",
            "via": {
              "choice": "email",
              "subject": "hi",
              "retries": "nope"
            }
          }
        }
      ],
      "commands": [
        {
          "name": "send",
          "help": "send one notification through exactly one channel",
          "effect": "read_only",
          "handler_prints": "via={via} before={before} after={after}",
          "flags": [
            {
              "name": "before",
              "help": "a root flag declared before the selector",
              "type": "int",
              "presence": "optional"
            },
            {
              "name": "via",
              "help": "delivery channel",
              "presence": "required",
              "elect_by": "selector-token",
              "choices": [
                {
                  "name": "email",
                  "help": "deliver the notification as an email message",
                  "flags": [
                    {
                      "name": "subject",
                      "help": "subject line of the message",
                      "type": "str",
                      "presence": "required"
                    },
                    {
                      "name": "retries",
                      "help": "delivery attempts before giving up",
                      "type": "int",
                      "presence": "default",
                      "default": 3
                    }
                  ]
                },
                {
                  "name": "sms",
                  "help": "deliver the notification as a text message",
                  "flags": [
                    {
                      "name": "phone-number",
                      "help": "destination number",
                      "type": "str",
                      "presence": "required"
                    }
                  ]
                }
              ]
            },
            {
              "name": "after",
              "help": "a root flag declared after the selector",
              "type": "int",
              "presence": "optional"
            }
          ]
        },
        {
          "name": "noop",
          "help": "a command the case argv can run without output",
          "effect": "read_only",
          "handler_returns": {
            "kind": "exit",
            "code": 0
          }
        }
      ]
    },
    "argv": [
      "noop"
    ],
    "expect": {
      "exit_code": 0,
      "stdout_equals": "",
      "stderr_equals": "call error: --before: expected integer, got str\n"
    }
  },
