[
  {
    "name": "repeatable global: given before the command only",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "global_flags": [
        {
          "name": "label",
          "type": "str",
          "help": "labels",
          "presence": "optional",
          "repeatable": true,
          "unique": false,
          "short": "l",
          "env": "MYAPP_LABEL",
          "env_separator": ","
        },
        {
          "name": "port",
          "type": "int",
          "help": "ports",
          "presence": "optional",
          "repeatable": true,
          "unique": true
        },
        {
          "name": "zone",
          "type": "list[str]",
          "help": "zones",
          "presence": "default",
          "default": [],
          "unique": false
        },
        {
          "name": "meta",
          "type": "dict[str,str]",
          "help": "metadata",
          "presence": "default",
          "default": {}
        },
        {
          "name": "region",
          "type": "str",
          "help": "the region",
          "presence": "default",
          "default": "eu",
          "short": "r"
        }
      ],
      "commands": [
        {
          "name": "run",
          "help": "run it",
          "effect": "read_only",
          "flags": [
            {
              "name": "commits",
              "type": "str",
              "help": "the commit range",
              "presence": "optional"
            }
          ],
          "handler_prints": "label={label} port={port} zone={zone} meta={meta} region={region} source={source:label}"
        }
      ]
    },
    "argv": [
      "--label",
      "a",
      "run"
    ],
    "expect": {
      "exit_code": 0,
      "stdout_equals": "label=a port=None zone= meta= region=eu source=cli",
      "stderr_equals": ""
    }
  },
