  {
    "name": "record door divergence: go and typescript cannot see that a native integral number was written with a point",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "pre_call": [
        {
          "command": "run",
          "kwargs": {
            "retries": 7.0
          }
        }
      ],
      "commands": [
        {
          "name": "run",
          "help": "run the job",
          "effect": "read_only",
          "handler_prints": "retries={retries}",
          "flags": [
            {
              "name": "retries",
              "help": "attempts before giving up",
              "type": "int",
              "presence": "default",
              "default": 3
            }
          ]
        },
        {
          "name": "noop",
          "help": "a command the case argv can run without output",
          "effect": "read_only",
          "handler_returns": {
            "kind": "exit",
            "code": 0
          }
        }
      ]
    },
    "argv": [
      "noop"
    ],
    "expect": {
      "exit_code": 0,
      "stdout_equals": "retries=7\ncall ok: run\n",
      "stderr_equals": ""
    }
  },
