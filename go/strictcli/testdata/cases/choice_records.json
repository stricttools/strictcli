  {
    "name": "choice records: the dump carries the enum in value_schema and the records in choices",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "push",
          "help": "push refs",
          "effect": "read_only",
          "handler_prints": "what={what}",
          "flags": [
            {
              "name": "what",
              "help": "what to push",
              "type": "str",
              "presence": "required",
              "choices_str": [
                {
                  "value": "head",
                  "help": "push only the current HEAD branch"
                },
                {
                  "value": "branches",
                  "help": "push every local branch"
                },
                {
                  "value": "tags"
                }
              ]
            }
          ]
        }
      ]
    },
    "argv": [
      "help",
      "--json"
    ],
    "expect": {
      "exit_code": 0,
      "schema_command_keys": {
        "push": {
          "flags": [
            {
              "name": "what",
              "help": "what to push",
              "value_schema": {
                "type": "string",
                "enum": [
                  "head",
                  "branches",
                  "tags"
                ]
              },
              "presence": "required",
              "choices": [
                {
                  "value": "head",
                  "help": "push only the current HEAD branch"
                },
                {
                  "value": "branches",
                  "help": "push every local branch"
                },
                {
                  "value": "tags"
                }
              ]
            }
          ]
        }
      }
    }
  },
  {
    "name": "choice records: a bare flag entry is refused, index 0-based (go)",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "push",
