          "handler_prints": "ok",
          "flags": [
            {
              "name": "ident",
              "help": "an identifier",
              "type": "int",
              "presence": "required",
              "choices_int": [
                {
                  "value": 9007199254740994
                },
                {
                  "value": 1
                }
              ]
            }
          ]
        }
      ]
    },
    "argv": [
      "push"
    ],
    "expect": {
      "exit_code": 1,
      "stderr_equals": "error: Flag \"ident\": choice 9007199254740994: the number's magnitude exceeds 2^53 (declare a big identifier as a string)"
    }
  },
