          "flags": [
            {
              "name": "what",
              "help": "what to push",
              "type": "str",
              "presence": "required",
              "choices_str": [
                {
                  "value": "head",
                  "help": "push only the current HEAD branch"
                },
                {
                  "value": "branches",
                  "help": "push every local branch"
                },
