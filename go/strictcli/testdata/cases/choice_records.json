          "flags": [
            {
              "name": "what",
              "help": "what to push",
              "type": "str",
              "presence": "required",
              "choices_str": [
                "head",
                {
                  "value": "branches"
                }
              ]
            }
          ]
        }
      ]
    },
    "argv": [
      "push"
    ],
    "skip_schema_validation": true,
    "expect": {
      "exit_code": 1,
      "stderr_equals": "error: Flag \"what\": choices entry 0 is a bare value: declare it as Ch(<value>, \"<help>\")"
    }
  },
