[
  {
    "name": "choice records: a flag whose entries carry help renders as a block",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "push",
          "help": "push refs",
          "effect": "read_only",
          "handler_prints": "ok",
          "flags": [
            {
              "name": "what",
              "help": "what to push",
              "type": "str",
              "presence": "required",
              "choices_str": [
                {
                  "value": "head",
                  "help": "push only the current HEAD branch"
                },
                {
                  "value": "branches",
                  "help": "push every local branch"
                },
                {
                  "value": "tags"
                }
              ]
            }
          ]
        }
      ]
    },
    "argv": [
      "push",
      "--help"
    ],
    "expect": {
      "exit_code": 0,
      "stdout_equals": "myapp push -- push refs\n\nFlags:\n  --what <str>    what to push [required]\n    head          push only the current HEAD branch\n    branches      push every local branch\n    tags"
    }
  },
  {
    "name": "choice records: a flag whose entries carry no help keeps the one-line form",
