[
  {
    "name": "mcp_modern: server/discover advertises the supported versions, capabilities and identity",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "status",
          "help": "show status",
          "effect": "read_only",
          "handler_returns": {
            "kind": "data",
            "data": {
              "ok": true
            }
          }
        }
      ]
    },
    "argv": [
      "--mcp"
    ],
    "protocol_script": [
      {
        "send": "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"server/discover\",\"params\":{\"_meta\":{\"io.modelcontextprotocol/protocolVersion\":\"2026-07-28\",\"io.modelcontextprotocol/clientCapabilities\":{}}}}",
        "expect_line": {
          "json_equals": {
            "jsonrpc": "2.0",
            "id": 1,
            "result": {
              "resultType": "complete",
              "supportedVersions": [
                "2026-07-28"
              ],
              "capabilities": {
                "tools": {},
                "extensions": {
                  "dev.smmh.strictcli/consequential-confirmation": {}
                }
              },
              "instructions": "test app",
              "ttlMs": 3600000,
              "cacheScope": "public",
              "_meta": {
                "io.modelcontextprotocol/serverInfo": {
                  "name": "myapp",
                  "version": "1.0.0"
                }
              }
            }
          }
        }
      }
    ],
    "expect": {
      "exit_code": 0,
      "stderr_equals": ""
    }
  },
  {
    "name": "mcp_modern: per-request metadata is validated key by key",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "status",
          "help": "show status",
          "effect": "read_only",
          "handler_returns": {
            "kind": "data",
            "data": {
              "ok": true
            }
          }
        }
      ]
    },
    "argv": [
      "--mcp"
    ],
    "protocol_script": [
      {
        "send": "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/list\",\"params\":{}}",
        "expect_line": {
          "json_equals": {
            "jsonrpc": "2.0",
            "id": 1,
            "error": {
              "code": -32602,
              "message": "missing required request metadata: _meta['io.modelcontextprotocol/protocolVersion']"
            }
          }
        }
      },
      {
        "send": "{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"tools/list\",\"params\":{\"_meta\":[]}}",
        "expect_line": {
          "json_equals": {
            "jsonrpc": "2.0",
            "id": 2,
            "error": {
              "code": -32602,
              "message": "parameter '_meta' must be an object"
            }
          }
        }
      },
      {
        "send": "{\"jsonrpc\":\"2.0\",\"id\":3,\"method\":\"tools/list\",\"params\":{\"_meta\":{\"io.modelcontextprotocol/protocolVersion\":2026,\"io.modelcontextprotocol/clientCapabilities\":{}}}}",
        "expect_line": {
          "json_equals": {
            "jsonrpc": "2.0",
            "id": 3,
            "error": {
              "code": -32602,
              "message": "_meta['io.modelcontextprotocol/protocolVersion'] must be a string"
            }
          }
        }
      },
      {
        "send": "{\"jsonrpc\":\"2.0\",\"id\":4,\"method\":\"tools/list\",\"params\":{\"_meta\":{\"io.modelcontextprotocol/protocolVersion\":\"2026-07-28\",\"io.modelcontextprotocol/clientCapabilities\":{},\"-bad./key\":1}}}",
        "expect_line": {
          "json_equals": {
            "jsonrpc": "2.0",
            "id": 4,
            "error": {
              "code": -32602,
              "message": "invalid _meta key name: '-bad./key'"
            }
          }
        }
      },
      {
        "send": "{\"jsonrpc\":\"2.0\",\"id\":5,\"method\":\"tools/list\",\"params\":{\"_meta\":{\"io.modelcontextprotocol/protocolVersion\":\"2026-07-28\",\"io.modelcontextprotocol/clientCapabilities\":{},\"io.modelcontextprotocol/whatever\":1}}}",
        "expect_line": {
          "json_equals": {
            "jsonrpc": "2.0",
            "id": 5,
            "error": {
              "code": -32602,
              "message": "unrecognized reserved _meta key: 'io.modelcontextprotocol/whatever'"
            }
          }
        }
      },
      {
        "send": "{\"jsonrpc\":\"2.0\",\"id\":6,\"method\":\"tools/list\",\"params\":{\"_meta\":{\"io.modelcontextprotocol/protocolVersion\":\"2026-07-28\",\"io.modelcontextprotocol/clientCapabilities\":{},\"io.modelcontextprotocol/clientInfo\":\"ExampleClient\"}}}",
        "expect_line": {
          "json_equals": {
            "jsonrpc": "2.0",
            "id": 6,
            "error": {
              "code": -32602,
              "message": "_meta['io.modelcontextprotocol/clientInfo'] must be an object"
            }
          }
        }
      },
      {
        "send": "{\"jsonrpc\":\"2.0\",\"id\":7,\"method\":\"tools/list\",\"params\":{\"_meta\":{\"io.modelcontextprotocol/protocolVersion\":\"2026-07-28\",\"io.modelcontextprotocol/clientCapabilities\":{},\"z!bad\":1,\"a!bad\":1}}}",
        "expect_line": {
          "json_equals": {
            "jsonrpc": "2.0",
            "id": 7,
            "error": {
              "code": -32602,
              "message": "invalid _meta key name: 'a!bad'"
            }
          }
        }
      },
      {
        "send": "{\"jsonrpc\":\"2.0\",\"id\":8,\"method\":\"tools/list\",\"params\":{\"_meta\":{\"io.modelcontextprotocol/protocolVersion\":\"2026-07-28\",\"io.modelcontextprotocol/clientCapabilities\":{},\"z!bad\":1,\"io.mcp/whatever\":1}}}",
        "expect_line": {
          "json_equals": {
            "jsonrpc": "2.0",
            "id": 8,
            "error": {
              "code": -32602,
              "message": "unrecognized reserved _meta key: 'io.mcp/whatever'"
            }
          }
        }
      }
    ],
    "expect": {
      "exit_code": 0,
      "stderr_equals": ""
    }
  },
  {
    "name": "mcp_modern: the client declares its capabilities on every request",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "status",
          "help": "show status",
          "effect": "read_only",
          "handler_returns": {
            "kind": "data",
            "data": {
              "ok": true
            }
          }
        }
      ]
    },
    "argv": [
      "--mcp"
    ],
    "protocol_script": [
      {
        "send": "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/list\",\"params\":{\"_meta\":{\"io.modelcontextprotocol/protocolVersion\":\"2026-07-28\"}}}",
        "expect_line": {
          "json_equals": {
            "jsonrpc": "2.0",
            "id": 1,
            "error": {
              "code": -32602,
              "message": "missing required request metadata: _meta['io.modelcontextprotocol/clientCapabilities']"
            }
          }
        }
      },
      {
        "send": "{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"tools/list\",\"params\":{\"_meta\":{\"io.modelcontextprotocol/protocolVersion\":\"2026-07-28\",\"io.modelcontextprotocol/clientCapabilities\":\"yes\"}}}",
        "expect_line": {
          "json_equals": {
            "jsonrpc": "2.0",
            "id": 2,
            "error": {
              "code": -32602,
              "message": "_meta['io.modelcontextprotocol/clientCapabilities'] must be an object"
            }
          }
        }
      },
      {
        "send": "{\"jsonrpc\":\"2.0\",\"id\":3,\"method\":\"tools/call\",\"params\":{\"_meta\":{\"io.modelcontextprotocol/protocolVersion\":\"2026-07-28\",\"io.modelcontextprotocol/clientCapabilities\":{\"elicitation\":{\"form\":{}}},\"io.modelcontextprotocol/clientInfo\":{\"name\":\"ExampleClient\",\"version\":\"1.0.0\"},\"io.modelcontextprotocol/logLevel\":\"debug\",\"com.example.mcp/thing\":1,\"traceparent\":\"00-0af7651916cd43dd8448eb211c80319c-00f067aa0ba902b7-01\"},\"name\":\"status\",\"arguments\":{}}}",
        "expect_line": {
          "json_equals": {
            "jsonrpc": "2.0",
            "id": 3,
            "result": {
              "resultType": "complete",
              "content": [
                {
                  "type": "text",
                  "text": "$ANY"
                }
              ],
              "_meta": {
                "io.modelcontextprotocol/serverInfo": {
                  "name": "myapp",
                  "version": "1.0.0"
                }
              }
            }
          }
        }
      }
    ],
    "expect": {
      "exit_code": 0,
      "stderr_equals": ""
    }
  },
  {
    "name": "mcp_modern: a version this server does not speak is refused with the code the protocol assigns",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "status",
          "help": "show status",
          "effect": "read_only",
          "handler_returns": {
            "kind": "data",
            "data": {
              "ok": true
            }
          }
        }
      ]
    },
    "argv": [
      "--mcp"
    ],
    "protocol_script": [
      {
        "send": "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/list\",\"params\":{\"_meta\":{\"io.modelcontextprotocol/protocolVersion\":\"1900-01-01\",\"io.modelcontextprotocol/clientCapabilities\":{}}}}",
        "expect_line": {
          "json_equals": {
            "jsonrpc": "2.0",
            "id": 1,
            "error": {
              "code": -32022,
              "message": "Unsupported protocol version",
              "data": {
                "supported": [
                  "2026-07-28"
                ],
                "requested": "1900-01-01"
              }
            }
          }
        }
      },
      {
        "send": "{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"resources/list\",\"params\":{\"_meta\":{\"io.modelcontextprotocol/protocolVersion\":\"2026-07-28\",\"io.modelcontextprotocol/clientCapabilities\":{}}}}",
        "expect_line": {
          "json_equals": {
            "jsonrpc": "2.0",
            "id": 2,
            "error": {
              "code": -32601,
              "message": "Method not found: resources/list"
            }
          }
        }
      }
    ],
    "expect": {
      "exit_code": 0,
      "stderr_equals": ""
    }
  },
  {
    "name": "mcp_modern: one process serves both eras, and the handshake selects the legacy one",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "status",
          "help": "show status",
          "effect": "read_only",
          "handler_returns": {
            "kind": "data",
            "data": {
              "ok": true
            }
          }
        }
      ]
    },
    "argv": [
      "--mcp"
    ],
    "protocol_script": [
      {
        "send": "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{}}",
        "expect_line": {
          "json_equals": {
            "jsonrpc": "2.0",
            "id": 1,
            "result": {
              "protocolVersion": "2025-11-25",
              "capabilities": {
                "tools": {},
                "experimental": {
                  "dev.smmh.strictcli/consequential-confirmation": {}
                }
              },
              "serverInfo": {
                "name": "myapp",
                "version": "1.0.0"
              }
            }
          }
        }
      },
      {
        "send": "{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"tools/list\",\"params\":{}}",
        "expect_line": {
          "json_equals": {
            "jsonrpc": "2.0",
            "id": 2,
            "result": {
              "tools": [
                {
                  "name": "status",
                  "description": "show status",
                  "effect": "read_only",
                  "inputSchema": {
                    "type": "object",
                    "properties": {},
                    "required": [],
                    "additionalProperties": false
                  }
                }
              ]
            }
          }
        }
      },
      {
        "send": "{\"jsonrpc\":\"2.0\",\"id\":3,\"method\":\"tools/list\",\"params\":{\"_meta\":{\"io.modelcontextprotocol/protocolVersion\":\"2026-07-28\",\"io.modelcontextprotocol/clientCapabilities\":{}}}}",
        "expect_line": {
          "json_equals": {
            "jsonrpc": "2.0",
            "id": 3,
            "result": {
              "resultType": "complete",
              "tools": [
                {
                  "name": "status",
                  "description": "show status",
                  "effect": "read_only",
                  "inputSchema": {
                    "type": "object",
                    "properties": {},
                    "required": [],
                    "additionalProperties": false
                  }
                }
              ],
              "ttlMs": 3600000,
              "cacheScope": "public",
              "_meta": {
                "io.modelcontextprotocol/serverInfo": {
                  "name": "myapp",
                  "version": "1.0.0"
                }
              }
            }
          }
        }
      },
      {
        "send": "{\"jsonrpc\":\"2.0\",\"id\":4,\"method\":\"server/discover\",\"params\":{}}",
        "expect_line": {
          "json_equals": {
            "jsonrpc": "2.0",
            "id": 4,
            "error": {
              "code": -32601,
              "message": "Method not found: server/discover"
            }
          }
        }
      }
    ],
    "expect": {
      "exit_code": 0,
      "stderr_equals": ""
    }
  }
]
