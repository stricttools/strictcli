[
  {
    "name": "boundary: empty string as flag value",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "cmd",
          "help": "a command",
          "effect": "read_only",
          "flags": [
            {
              "name": "name",
              "type": "str",
              "help": "a name",
              "presence": "default",
              "default": "fallback"
            }
          ],
          "handler_prints": "name={name}"
        }
      ]
    },
    "argv": [
      "cmd",
      "--name",
      ""
    ],
    "expect": {
      "exit_code": 0,
      "stdout_equals": "name="
    }
  },
  {
    "name": "boundary: string with spaces",
