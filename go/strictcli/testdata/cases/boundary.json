  {
    "name": "boundary: empty argv shows help",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "greet",
          "help": "say hello",
          "effect": "read_only",
          "handler_prints": "hello"
        }
      ]
    },
    "argv": [],
    "expect": {
      "exit_code": 0,
      "stdout_contains": [
        "myapp v1.0.0",
        "Commands:",
        "greet"
