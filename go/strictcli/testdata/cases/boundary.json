          "name": "cmd",
          "help": "a command",
          "effect": "read_only",
          "flags": [
            {
              "name": "name",
              "type": "str",
              "help": "a name",
              "presence": "default",
              "default": "fallback"
            }
          ],
          "handler_prints": "name={name}"
