  {
    "name": "requirements: a requirement name follows the naming rule",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "render",
          "help": "render a frame",
          "effect": "read_only",
          "handler_prints": "rendered",
          "requires": [
            {
              "name": "Vulkan",
              "help": "the Vulkan loader library",
              "install": "sudo dnf install vulkan-loader",
              "available": true
            }
          ]
        },
        {
          "name": "plain",
          "help": "needs nothing",
          "effect": "read_only",
          "handler_prints": "plain"
        }
      ]
    },
    "argv": [
      "plain"
    ],
    "expect": {
      "exit_code": 1,
      "stdout_equals": "",
      "stderr_equals": "error: requirement name \"Vulkan\" must be lowercase kebab-case of at least two characters: [a-z][a-z0-9]*(-[a-z0-9]+)*\n"
    }
  },
