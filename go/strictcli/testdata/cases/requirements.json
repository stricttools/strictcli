[
  {
    "name": "requirements: an available requirement runs the handler",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "render",
          "help": "render a frame",
          "effect": "read_only",
          "handler_prints": "rendered",
          "requires": [
            {
              "name": "vulkan-loader",
              "help": "the Vulkan loader library",
              "install": "sudo dnf install vulkan-loader",
              "available": true
            }
          ]
        },
        {
          "name": "plain",
          "help": "needs nothing",
          "effect": "read_only",
          "handler_prints": "plain"
        }
      ]
    },
    "argv": [
      "render"
    ],
    "expect": {
      "exit_code": 0,
      "stdout_equals": "rendered\n",
      "stderr_equals": ""
    }
  },
  {
    "name": "requirements: a missing requirement ends the command naming what to install",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "render",
          "help": "render a frame",
          "effect": "read_only",
          "handler_prints": "rendered",
          "requires": [
            {
              "name": "vulkan-loader",
              "help": "the Vulkan loader library",
              "install": "sudo dnf install vulkan-loader",
              "available": false,
              "reason": "libvulkan.so.1: cannot open shared object file"
            }
          ]
        },
        {
          "name": "plain",
          "help": "needs nothing",
          "effect": "read_only",
          "handler_prints": "plain"
        }
      ]
    },
    "argv": [
      "render"
    ],
    "expect": {
      "exit_code": 1,
      "stdout_equals": "",
      "stderr_equals": "error: command 'render' needs vulkan-loader (the Vulkan loader library), which is not available: libvulkan.so.1: cannot open shared object file; install it: sudo dnf install vulkan-loader\n"
    }
  },
  {
    "name": "requirements: a command that does not need it runs",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "render",
          "help": "render a frame",
          "effect": "read_only",
          "handler_prints": "rendered",
          "requires": [
            {
              "name": "vulkan-loader",
              "help": "the Vulkan loader library",
              "install": "sudo dnf install vulkan-loader",
              "available": false,
              "reason": "libvulkan.so.1: cannot open shared object file"
            }
          ]
        },
        {
          "name": "plain",
          "help": "needs nothing",
          "effect": "read_only",
          "handler_prints": "plain"
        }
      ]
    },
    "argv": [
      "plain"
    ],
    "expect": {
      "exit_code": 0,
      "stdout_equals": "plain\n"
    }
  },
