  {
    "name": "requirements: the machine door refuses a missing requirement as an exit result",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "render",
          "help": "render a frame",
          "effect": "read_only",
          "handler_prints": "rendered",
          "requires": [
            {
              "name": "vulkan-loader",
              "help": "the Vulkan loader library",
              "install": "sudo dnf install vulkan-loader",
              "available": false,
              "reason": "libvulkan.so.1: cannot open shared object file"
            }
          ]
        },
        {
          "name": "plain",
          "help": "needs nothing",
          "effect": "read_only",
          "handler_prints": "plain"
        }
      ]
    },
    "argv": [
      "--mcp"
    ],
    "protocol_script": [
      {
        "send": "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/call\",\"params\":{\"name\":\"render\",\"arguments\":{},\"_meta\":{\"io.modelcontextprotocol/protocolVersion\":\"2026-07-28\",\"io.modelcontextprotocol/clientCapabilities\":{}}}}",
        "expect_line": {
          "json_equals": {
            "jsonrpc": "2.0",
            "id": 1,
            "result": {
              "resultType": "complete",
              "content": [
                {
                  "type": "text",
                  "text": "exit code 1: command 'render' needs vulkan-loader (the Vulkan loader library), which is not available: libvulkan.so.1: cannot open shared object file; install it: sudo dnf install vulkan-loader"
                }
              ],
              "isError": true,
              "_meta": {
                "io.modelcontextprotocol/serverInfo": {
                  "name": "myapp",
                  "version": "1.0.0"
                }
              }
            }
          }
        }
      }
    ],
    "expect": {
      "exit_code": 0,
      "stderr_equals": ""
    }
  }
]
