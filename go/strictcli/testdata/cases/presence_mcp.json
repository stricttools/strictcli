[
  {
    "name": "mcp presence: a tool schema's required array is exactly the declared-required parameters",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "deploy",
          "help": "deploy it",
          "effect": "read_only",
          "args": [
            {
              "name": "target",
              "help": "the target",
              "presence": "required"
            },
            {
              "name": "note",
              "help": "a note",
              "presence": "optional"
            }
          ],
          "flags": [
            {
              "name": "env",
              "help": "the environment",
              "presence": "required"
            },
            {
              "name": "force-yes",
              "type": "bool",
              "help": "a required bool",
              "presence": "required"
            },
            {
              "name": "chatter",
              "type": "bool",
              "help": "an optional bool",
              "presence": "optional"
            },
            {
              "name": "retries",
              "type": "int",
              "help": "retries",
              "presence": "default",
              "default": 3
            }
          ],
          "handler_prints": "x"
        }
      ]
    },
    "argv": [
      "--mcp"
    ],
    "protocol_script": [
      {
        "send": "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/list\",\"params\":{\"_meta\":{\"io.modelcontextprotocol/protocolVersion\":\"2026-07-28\",\"io.modelcontextprotocol/clientCapabilities\":{}}}}",
        "expect_line": {
          "json_equals": {
            "jsonrpc": "2.0",
            "id": 1,
            "result": {
              "resultType": "complete",
              "tools": [
                {
                  "name": "deploy",
                  "description": "deploy it",
                  "effect": "read_only",
                  "inputSchema": {
                    "type": "object",
                    "properties": {
                      "env": {
                        "type": "string",
                        "description": "the environment"
                      },
                      "force_yes": {
                        "type": "boolean",
                        "description": "a required bool"
                      },
                      "chatter": {
                        "type": "boolean",
                        "description": "an optional bool"
                      },
                      "retries": {
                        "type": "integer",
                        "description": "retries"
                      },
                      "target": {
                        "type": "string",
                        "description": "the target"
                      },
                      "note": {
                        "type": "string",
                        "description": "a note"
                      }
                    },
                    "required": [
                      "env",
                      "force_yes",
                      "target"
                    ],
                    "additionalProperties": false
                  }
                }
              ],
              "ttlMs": 3600000,
              "cacheScope": "public",
              "_meta": {
                "io.modelcontextprotocol/serverInfo": {
                  "name": "myapp",
                  "version": "1.0.0"
                }
              }
            }
          }
        }
      }
    ],
    "expect": {
      "exit_code": 0,
      "stderr_equals": ""
    }
  },
  {
    "name": "mcp presence: optional and defaulted parameters leave the required array empty",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "show",
          "help": "show it",
          "effect": "read_only",
          "args": [
            {
              "name": "note",
              "help": "a note",
              "presence": "optional"
            }
          ],
          "flags": [
            {
              "name": "chatter",
              "type": "bool",
              "help": "an optional bool",
              "presence": "optional"
            },
            {
              "name": "retries",
              "type": "int",
              "help": "retries",
              "presence": "default",
              "default": 3
            }
          ],
          "handler_prints": "x"
        }
      ]
    },
    "argv": [
      "--mcp"
    ],
    "protocol_script": [
      {
        "send": "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/list\",\"params\":{\"_meta\":{\"io.modelcontextprotocol/protocolVersion\":\"2026-07-28\",\"io.modelcontextprotocol/clientCapabilities\":{}}}}",
        "expect_line": {
          "json_equals": {
            "jsonrpc": "2.0",
            "id": 1,
            "result": {
              "resultType": "complete",
              "tools": [
                {
                  "name": "show",
                  "description": "show it",
                  "effect": "read_only",
                  "inputSchema": {
                    "type": "object",
                    "properties": {
                      "chatter": {
                        "type": "boolean",
                        "description": "an optional bool"
                      },
                      "retries": {
                        "type": "integer",
                        "description": "retries"
                      },
                      "note": {
                        "type": "string",
                        "description": "a note"
                      }
                    },
                    "required": [],
                    "additionalProperties": false
                  }
                }
              ],
              "ttlMs": 3600000,
              "cacheScope": "public",
              "_meta": {
                "io.modelcontextprotocol/serverInfo": {
                  "name": "myapp",
                  "version": "1.0.0"
                }
              }
            }
          }
        }
      }
    ],
    "expect": {
      "exit_code": 0,
      "stderr_equals": ""
    }
  }
]
