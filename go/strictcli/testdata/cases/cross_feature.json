[
  {
    "name": "cross_feature: a bool member beside a payload-carrying one, the payload elected",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "cmd",
          "help": "a command",
          "effect": "read_only",
          "flags": [
            {
              "name": "mode",
              "help": "how to run",
              "presence": "required",
              "elect_by": "member-flags",
              "choices": [
                {
                  "name": "force-mode",
                  "help": "force mode"
                },
                {
                  "name": "target",
                  "help": "target name",
                  "value": {
                    "type": "str",
                    "help": "target name"
                  }
                }
              ]
            }
          ],
          "handler_prints": "mode={mode}"
        }
      ]
    },
    "argv": [
      "cmd",
      "--target",
      "prod"
    ],
    "expect": {
      "exit_code": 0,
      "stdout_equals": "mode=target(value=prod)"
    }
  },
  {
    "name": "cross_feature: a bool member beside a payload-carrying one, neither elected is an error",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "cmd",
          "help": "a command",
          "effect": "read_only",
          "flags": [
            {
              "name": "mode",
              "help": "how to run",
              "presence": "required",
              "elect_by": "member-flags",
              "choices": [
                {
                  "name": "force-mode",
                  "help": "force mode"
                },
                {
                  "name": "target",
                  "help": "target name",
                  "value": {
                    "type": "str",
                    "help": "target name"
                  }
                }
              ]
            }
          ],
          "handler_prints": "mode={mode}"
        }
      ]
    },
    "argv": [
      "cmd"
    ],
    "expect": {
      "exit_code": 1,
      "stderr_contains": [
        "one of",
        "is required"
      ],
      "stderr_equals": "error: one of --force-mode, --target is required\ntry 'myapp cmd --help'"
    }
  },
  {
    "name": "cross_feature: a bool member beside a payload-carrying one, the bool elected",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "cmd",
          "help": "a command",
          "effect": "read_only",
          "flags": [
            {
              "name": "mode",
              "help": "how to run",
              "presence": "required",
              "elect_by": "member-flags",
              "choices": [
                {
                  "name": "force-mode",
                  "help": "force mode"
                },
                {
                  "name": "target",
                  "help": "target name",
                  "value": {
                    "type": "str",
                    "help": "target name"
                  }
                }
              ]
            }
          ],
          "handler_prints": "mode={mode}"
        }
      ]
    },
    "argv": [
      "cmd",
      "--force-mode"
    ],
    "expect": {
      "exit_code": 0,
      "stdout_equals": "mode=force-mode"
    }
  },
  {
    "name": "cross_feature: required bool global flag satisfied by env var",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "env_prefix": "MYAPP",
      "global_flags": [
        {
          "name": "force-mode",
          "type": "bool",
          "help": "force mode",
          "presence": "required",
          "env": "MYAPP_FORCE_MODE"
        }
      ],
      "commands": [
        {
          "name": "cmd",
          "help": "a command",
          "effect": "read_only",
          "handler_prints": "force-mode={force-mode}"
        }
      ]
    },
    "argv": [
      "cmd"
    ],
    "env": {
      "MYAPP_FORCE_MODE": "true"
    },
    "expect": {
      "exit_code": 0,
      "stdout_equals": "force-mode=true"
    }
  },
  {
    "name": "cross_feature: required bool global flag missing without env var",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "env_prefix": "MYAPP",
      "global_flags": [
        {
          "name": "force-mode",
          "type": "bool",
          "help": "force mode",
          "presence": "required",
          "env": "MYAPP_FORCE_MODE"
        }
      ],
      "commands": [
        {
          "name": "cmd",
          "help": "a command",
          "effect": "read_only",
          "handler_prints": "force-mode={force-mode}"
        }
      ]
    },
    "argv": [
      "cmd"
    ],
    "expect": {
      "exit_code": 1,
      "stderr_contains": "must be passed"
    }
  },
  {
    "name": "cross_feature: tag contract requires a required bool flag, invoked without flag",
    "app": {
