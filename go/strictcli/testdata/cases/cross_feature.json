          "flags": [
            {
              "name": "strict",
              "type": "bool",
              "help": "strict mode",
              "presence": "required"
            }
          ],
          "handler_prints": "strict={strict}"
        }
      ]
    },
    "argv": [
      "lint"
    ],
    "expect": {
      "exit_code": 1,
      "stderr_contains": "must be passed"
    }
  },
