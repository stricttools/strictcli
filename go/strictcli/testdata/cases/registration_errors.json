  {
    "name": "registration: a constraint member naming nothing declared",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "cmd",
          "help": "a command",
          "effect": "read_only",
          "flags": [
            {
              "name": "output",
              "type": "str",
              "help": "output file",
              "presence": "default",
              "default": "none"
            },
            {
              "name": "format",
              "type": "str",
              "help": "format",
              "presence": "default",
              "default": "none"
            }
          ],
          "handler_prints": "ok",
          "constraints": [
            {
              "type": "all_or_none",
              "name": "output-format",
              "members": [
                {
                  "name": "output"
                },
                {
                  "name": "missing"
                }
              ]
            }
          ]
        }
      ]
    },
    "argv": [
      "cmd"
    ],
    "expect": {
      "exit_code": 1,
      "stderr_equals": "error: command \"cmd\": constraint \"output-format\" references unknown member \"missing\""
    }
  },
