  {
    "name": "registration: repeatable bool flag",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "cmd",
          "help": "a command",
          "effect": "read_only",
          "flags": [
            {
              "name": "chatter",
              "type": "bool",
              "help": "be chatter",
              "presence": "default",
              "repeatable": true,
              "default": false
            }
          ],
          "handler_prints": "ok"
        }
      ]
