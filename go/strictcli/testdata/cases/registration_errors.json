  {
    "name": "registration: a name reused by simultaneously electable scopes",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "cmd",
          "help": "a command",
          "effect": "read_only",
          "flags": [
            {
              "name": "format",
              "help": "output format",
              "presence": "required",
              "elect_by": "selector-token",
              "choices": [
                {
                  "name": "table",
                  "help": "a rendered table",
                  "flags": [
                    {
                      "name": "width",
                      "help": "column width",
                      "type": "int",
                      "presence": "required"
                    }
                  ]
                },
                {
                  "name": "raw",
                  "help": "unrendered output"
                }
              ]
            },
            {
              "name": "sink",
              "help": "where output goes",
              "presence": "required",
              "elect_by": "selector-token",
              "choices": [
                {
                  "name": "file",
                  "help": "write to a file",
                  "flags": [
                    {
                      "name": "width",
                      "help": "line width",
                      "type": "int",
                      "presence": "required"
                    }
                  ]
                },
                {
                  "name": "stdout",
                  "help": "write to stdout"
                }
              ]
            }
          ],
          "handler_prints": "ok"
        }
      ]
    },
    "argv": [
      "cmd"
    ],
    "expect": {
      "exit_code": 1,
      "stderr_contains": "simultaneously electable scopes may not reuse a flag name",
      "stderr_equals": "error: command \"cmd\": flag '--width' is declared under '--format table' and under '--sink file', which can be elected at the same time: simultaneously electable scopes may not reuse a flag name"
    }
  },
