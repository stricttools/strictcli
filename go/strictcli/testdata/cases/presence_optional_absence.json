  {
    "name": "optional absence: an optional arg after a required one omitted delivers absence",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "cmd",
          "help": "a command",
          "effect": "read_only",
          "args": [
            {
              "name": "src",
              "help": "source",
              "presence": "required"
            },
            {
              "name": "dst",
              "help": "destination",
              "presence": "optional"
            }
          ],
          "handler_prints": "src={src} dst={dst}"
        }
      ]
    },
    "argv": [
      "cmd",
      "a"
    ],
    "expect": {
      "exit_code": 0,
      "stdout_equals": "src=a dst=None"
    }
  },
  {
    "name": "optional absence: an optional flag-set member omitted delivers absence",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "cmd",
          "help": "a command",
          "effect": "read_only",
          "flag_sets": [
            {
              "name": "output",
              "flags": [
                {
                  "name": "format",
                  "help": "the format",
                  "presence": "optional"
                },
                {
                  "name": "width",
                  "type": "int",
                  "help": "the width",
                  "presence": "default",
                  "default": 80
                }
              ]
            }
          ],
          "handler_prints": "format={format} width={width}"
        }
      ]
    },
    "argv": [
      "cmd"
    ],
    "expect": {
      "exit_code": 0,
      "stdout_equals": "format=None width=80"
    }
  },
  {
    "name": "optional absence: an optional global flag omitted delivers absence",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "global_flags": [
        {
          "name": "profile",
          "help": "the profile",
          "presence": "optional"
        }
      ],
      "commands": [
        {
          "name": "cmd",
          "help": "a command",
          "effect": "read_only",
          "handler_prints": "profile={profile}"
        }
      ]
    },
    "argv": [
      "cmd"
    ],
    "expect": {
      "exit_code": 0,
      "stdout_equals": "profile=None"
    }
  },
  {
    "name": "optional absence: an optional flag with choices is never matched against them when absent",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "cmd",
          "help": "a command",
          "effect": "read_only",
          "flags": [
            {
              "name": "mode",
              "help": "the mode",
              "presence": "optional",
              "choices_str": [
                {
                  "value": "fast"
                },
                {
                  "value": "slow"
                }
              ]
            }
          ],
          "handler_prints": "mode={mode}"
        }
      ]
    },
    "argv": [
      "cmd"
    ],
    "expect": {
      "exit_code": 0,
      "stdout_equals": "mode=None"
    }
  },
  {
    "name": "optional absence: an optional flag declaring env with the variable unset is absent",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "cmd",
          "help": "a command",
          "effect": "read_only",
          "flags": [
            {
              "name": "level",
              "help": "the level",
              "presence": "optional",
              "env": "MYAPP_LEVEL"
            }
          ],
          "handler_prints": "level={level}"
        }
      ],
      "env_prefix": "MYAPP"
    },
    "argv": [
      "cmd"
    ],
    "expect": {
      "exit_code": 0,
      "stdout_equals": "level=None"
    }
  },
  {
    "name": "optional absence: a required flag omitted is still the required error",
