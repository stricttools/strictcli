      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "cmd",
          "help": "a command",
          "effect": "read_only",
          "flags": [
            {
              "name": "target",
              "help": "the target",
              "presence": "required"
