[
  {
    "name": "optional absence: a plain optional flag omitted delivers absence to the handler",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "cmd",
          "help": "a command",
          "effect": "read_only",
          "flags": [
            {
              "name": "target",
              "help": "the target",
              "presence": "optional"
            }
          ],
          "handler_prints": "target={target}"
        }
      ]
    },
    "argv": [
      "cmd"
    ],
    "expect": {
      "exit_code": 0,
      "stdout_equals": "target=None"
    }
  },
  {
    "name": "optional absence: a supplied optional flag delivers its value",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "cmd",
          "help": "a command",
          "effect": "read_only",
          "flags": [
            {
              "name": "target",
              "help": "the target",
              "presence": "optional"
            }
          ],
          "handler_prints": "target={target}"
        }
      ]
    },
    "argv": [
      "cmd",
      "--target",
      "prod"
    ],
    "expect": {
      "exit_code": 0,
      "stdout_equals": "target=prod"
    }
  },
  {
    "name": "optional absence: an optional flag delivers the empty string as a value, not as absence",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "cmd",
          "help": "a command",
          "effect": "read_only",
          "flags": [
            {
              "name": "target",
              "help": "the target",
              "presence": "optional"
            }
          ],
          "handler_prints": "target=[{target}]"
        }
      ]
    },
    "argv": [
      "cmd",
      "--target",
      ""
    ],
    "expect": {
      "exit_code": 0,
      "stdout_equals": "target=[]"
    }
  },
  {
    "name": "optional absence: an optional bool is a real tri-state",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "cmd",
          "help": "a command",
          "effect": "read_only",
          "flags": [
            {
              "name": "chatter",
              "type": "bool",
              "help": "chatter",
              "presence": "optional"
            }
          ],
          "handler_prints": "chatter={chatter}"
        }
      ]
    },
    "argv": [
      "cmd"
    ],
    "expect": {
      "exit_code": 0,
      "stdout_equals": "chatter=None"
    }
  },
  {
    "name": "optional absence: an optional bool passed positively is true",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "cmd",
          "help": "a command",
          "effect": "read_only",
          "flags": [
            {
              "name": "chatter",
              "type": "bool",
              "help": "chatter",
              "presence": "optional"
            }
          ],
          "handler_prints": "chatter={chatter}"
        }
      ]
    },
    "argv": [
      "cmd",
      "--chatter"
    ],
    "expect": {
      "exit_code": 0,
      "stdout_equals": "chatter=true"
    }
  },
  {
    "name": "optional absence: an optional bool negated is false, which is not absence",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "cmd",
          "help": "a command",
          "effect": "read_only",
          "flags": [
            {
              "name": "chatter",
              "type": "bool",
              "help": "chatter",
              "presence": "optional"
            }
          ],
          "handler_prints": "chatter={chatter} provided={provided:chatter}"
        }
      ]
    },
    "argv": [
      "cmd",
      "--no-chatter"
    ],
    "expect": {
      "exit_code": 0,
      "stdout_equals": "chatter=false provided=true"
    }
  },
  {
