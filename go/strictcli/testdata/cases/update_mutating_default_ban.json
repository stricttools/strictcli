[
  {
    "name": "mutating-default ban: a str default is the measured TTL-300 class (go)",
    "skip_schema_validation": true,
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "cmd",
          "help": "a command",
          "effect": "mutating",
          "handler_prints": "ok",
          "flags": [
            {
              "name": "target",
              "help": "where to deploy",
              "presence": "default",
              "type": "str",
              "default": "prod"
            }
          ]
        }
      ]
    },
    "argv": [
      "cmd"
    ],
    "expect": {
      "exit_code": 1,
      "stdout_equals": "",
      "stderr_equals": "error: command \"cmd\": flag '--target' declares Default(prod) on a mutating command: absence would write a value the invocation never stated (declare Required() or Optional(), or apply the fallback in the handler and say so in its help)\n"
    }
  },
