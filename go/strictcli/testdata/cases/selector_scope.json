[
  {
    "name": "selector scope: a flag of an unelected sibling scope names both sides",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "send",
          "help": "send one notification through exactly one channel",
          "effect": "read_only",
          "flags": [
            {
              "name": "via",
              "help": "delivery channel",
              "presence": "required",
              "elect_by": "selector-token",
              "choices": [
                {
                  "name": "email",
                  "help": "deliver the notification as an email message",
                  "flags": [
                    {
                      "name": "subject",
                      "help": "subject line of the message",
                      "type": "str",
                      "presence": "required"
                    },
                    {
                      "name": "recipient",
                      "help": "destination email address",
                      "type": "str",
                      "presence": "required"
                    }
                  ]
                },
                {
                  "name": "sms",
                  "help": "deliver the notification as a text message",
                  "flags": [
                    {
                      "name": "phone-number",
                      "help": "destination number in E.164 form",
                      "type": "str",
                      "presence": "required"
                    }
                  ]
                },
                {
                  "name": "webhook",
                  "help": "post the notification to a URL",
                  "flags": [
                    {
                      "name": "url",
                      "help": "where to post",
                      "type": "str",
                      "presence": "required"
                    },
                    {
                      "name": "retries",
                      "help": "delivery attempts before giving up",
                      "type": "int",
                      "presence": "default",
                      "default": 3
                    }
                  ]
                }
              ]
            }
          ],
          "handler_prints": "via={via}"
        }
      ]
    },
    "argv": [
      "send",
      "--via",
      "sms",
      "--subject",
      "hi"
    ],
    "expect": {
      "exit_code": 1,
      "stderr_equals": "error: flag '--subject' is only valid under '--via email', but '--via sms' was elected\ntry 'myapp send --help'"
    }
  },
