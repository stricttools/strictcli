          "flags": [
            {
              "name": "mode",
              "help": "how to run",
              "presence": "required",
              "elect_by": "selector-token",
              "choices": [
                {
                  "name": "simple",
                  "help": "the simple way"
                },
                {
                  "name": "advanced",
                  "help": "the advanced way",
                  "flags": [
                    {
                      "name": "target",
                      "help": "which profiles to operate on",
                      "presence": "required",
                      "elect_by": "member-flags",
                      "choices": [
                        {
                          "name": "profile",
                          "help": "one named profile",
                          "value": {
                            "type": "str",
                            "help": "the profile"
                          }
                        },
                        {
                          "name": "all-profiles",
                          "help": "every profile"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    "argv": [
      "run",
      "--mode",
      "advanced"
    ],
    "expect": {
      "exit_code": 1,
      "stderr_equals": "error: one of --profile, --all-profiles is required under '--mode advanced'\ntry 'myapp run --help'"
    }
  },
