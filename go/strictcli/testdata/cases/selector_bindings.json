[
  {
    "name": "selector bindings: an env var bound to an elected scope's flag IS consulted",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "send",
          "help": "send one notification through exactly one channel",
          "effect": "read_only",
          "flags": [
            {
              "name": "via",
              "help": "delivery channel",
              "presence": "required",
              "elect_by": "selector-token",
              "choices": [
                {
                  "name": "email",
                  "help": "deliver the notification as an email message",
                  "flags": [
                    {
                      "name": "subject",
                      "help": "subject line of the message",
                      "type": "str",
                      "presence": "default",
                      "default": "(none)",
                      "env": "NOTIFY_SUBJECT"
                    }
                  ]
                },
                {
                  "name": "sms",
                  "help": "deliver the notification as a text message",
                  "flags": [
                    {
                      "name": "phone-number",
                      "help": "destination number in E.164 form",
                      "type": "str",
                      "presence": "default",
                      "default": "(none)",
                      "env": "NOTIFY_PHONE"
                    }
                  ]
                }
              ]
            }
          ],
          "handler_prints": "via={via}"
        }
      ]
    },
    "argv": [
      "send",
      "--via",
      "email"
    ],
    "env": {
      "NOTIFY_SUBJECT": "from-env"
    },
    "expect": {
      "exit_code": 0,
      "stdout_equals": "via=email(subject=from-env)"
    }
  },
