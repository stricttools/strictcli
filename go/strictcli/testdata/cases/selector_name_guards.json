[
  {
    "name": "selector names: a member flag colliding with a root flag is a duplicate flag name",
    "skip_schema_validation": true,
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "send",
          "help": "send one notification through exactly one channel",
          "effect": "read_only",
          "handler_prints": "ok",
          "flags": [
            {
              "name": "profile",
              "help": "which profile to use",
              "type": "str",
              "presence": "optional"
            },
            {
              "name": "target",
              "help": "which profiles to operate on",
              "presence": "required",
              "elect_by": "member-flags",
              "choices": [
                {
                  "name": "profile",
                  "help": "operate on one named profile",
                  "value": {
                    "type": "str",
                    "help": "profile name"
                  }
                },
                {
                  "name": "all-profiles",
                  "help": "operate on every profile"
                }
              ]
            }
          ]
        }
      ]
    },
    "argv": [
      "send"
    ],
    "expect": {
      "exit_code": 1,
      "stdout_equals": "",
      "stderr_contains": "duplicate flag name \"profile\""
    }
  },
  {
    "name": "selector names: a token-spelled choice name must match the flag-name charset",
    "skip_schema_validation": true,
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "send",
          "help": "send one notification through exactly one channel",
          "effect": "read_only",
          "handler_prints": "ok",
          "flags": [
            {
              "name": "via",
              "help": "delivery channel",
              "presence": "required",
              "elect_by": "selector-token",
              "choices": [
                {
                  "name": "Email",
                  "help": "deliver the notification as an email message"
                },
                {
                  "name": "sms",
                  "help": "deliver the notification as a text message"
                }
              ]
            }
          ]
        }
      ]
    },
    "argv": [
      "send"
    ],
    "expect": {
      "exit_code": 1,
      "stdout_equals": "",
      "stderr_equals": "error: Flag \"via\": choice name \"Email\" must be lowercase kebab-case of at least two characters: [a-z][a-z0-9]*(-[a-z0-9]+)*"
    }
  },
  {
    "name": "selector names: a member-spelled choice name must match it too",
    "skip_schema_validation": true,
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "send",
          "help": "send one notification through exactly one channel",
          "effect": "read_only",
          "handler_prints": "ok",
          "flags": [
            {
              "name": "target",
              "help": "which profiles to operate on",
              "presence": "required",
              "elect_by": "member-flags",
              "choices": [
                {
                  "name": "via_email",
                  "help": "operate on one named profile",
                  "value": {
                    "type": "str",
                    "help": "profile name"
                  }
                },
                {
                  "name": "all-profiles",
                  "help": "operate on every profile"
                }
              ]
            }
          ]
        }
      ]
    },
    "argv": [
      "send"
    ],
    "expect": {
      "exit_code": 1,
      "stdout_equals": "",
      "stderr_equals": "error: flag name \"via_email\" must be lowercase kebab-case of at least two characters: [a-z][a-z0-9]*(-[a-z0-9]+)*"
    }
  },
  {
    "name": "selector names: the one name that fails both the charset and the ban list is refused everywhere",
    "skip_schema_validation": true,
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "send",
          "help": "send one notification through exactly one channel",
          "effect": "read_only",
          "handler_prints": "ok",
          "flags": [
            {
              "name": "target",
              "help": "which profiles to operate on",
              "presence": "required",
              "elect_by": "member-flags",
              "choices": [
                {
                  "name": "approve_consequential",
                  "help": "operate on one named profile",
                  "value": {
                    "type": "str",
                    "help": "profile name"
                  }
                },
                {
                  "name": "all-profiles",
                  "help": "operate on every profile"
                }
              ]
            }
          ]
        }
      ]
    },
    "argv": [
