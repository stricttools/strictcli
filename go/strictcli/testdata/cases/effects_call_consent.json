  {
    "name": "effects_call_consent: a non-boolean MCP consent is a protocol error",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "release",
          "help": "a consequential command",
          "effect": "mutating",
          "consequential": true,
          "handler_returns": {
            "kind": "data",
            "data": {
              "released": true
            }
          }
        }
      ]
    },
    "argv": [
      "--mcp"
    ],
    "stdin": "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/call\",\"params\":{\"_meta\":{\"io.modelcontextprotocol/protocolVersion\":\"2026-07-28\",\"io.modelcontextprotocol/clientCapabilities\":{}},\"name\":\"release\",\"approve_consequential\":\"yes\"}}\n",
    "expect": {
      "exit_code": 0,
      "stdout_matches": [
        "\"code\":\\s*-32602",
        "parameter 'approve_consequential' must be a boolean"
      ],
      "stdout_not_contains": [
        "released"
      ],
      "stderr_equals": ""
    }
  },
  {
    "name": "effects_call_consent: the consent name inside arguments is an unknown parameter of the command's own namespace",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "build",
          "help": "a plain mutating command",
          "effect": "mutating",
          "handler_returns": {
            "kind": "data",
            "data": {
              "built": true
            }
          }
        }
      ]
    },
    "argv": [
      "--mcp"
    ],
    "stdin": "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/call\",\"params\":{\"_meta\":{\"io.modelcontextprotocol/protocolVersion\":\"2026-07-28\",\"io.modelcontextprotocol/clientCapabilities\":{}},\"name\":\"build\",\"arguments\":{\"approve_consequential\":true}}}\n",
    "expect": {
      "exit_code": 0,
      "stdout_matches": [
        "\"isError\":\\s*true",
        "unknown parameter ['\\\\\"]{1,2}approve_consequential"
      ],
      "stdout_not_contains": [
        "built"
      ],
      "stderr_equals": ""
    }
  }
