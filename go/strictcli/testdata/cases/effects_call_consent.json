[
  {
    "name": "effects_call_consent: exported tool descriptors carry the effects classification",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "dump_tools": true,
      "commands": [
        {
          "name": "look",
          "help": "a read_only command",
          "effect": "read_only",
          "handler_returns": {
            "kind": "exit",
            "code": 0
          }
        },
        {
          "name": "build",
          "help": "a mutating command",
          "effect": "mutating",
          "handler_returns": {
            "kind": "exit",
            "code": 0
          }
        },
        {
          "name": "release",
          "help": "a consequential command",
          "effect": "mutating",
          "consequential": true,
          "handler_returns": {
            "kind": "exit",
            "code": 0
          }
        }
      ]
    },
    "argv": [
      "look"
    ],
    "expect": {
      "exit_code": 0,
      "stdout_equals": "tool: look effect=read_only consequential=false\ntool: build effect=mutating consequential=false\ntool: release effect=mutating consequential=true\ntool: myapp effect=mutating consequential=false\n",
      "stderr_equals": ""
    }
  },
  {
    "name": "effects_call_consent: an unconsented programmatic call to a consequential command is refused",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "pre_call": [
        {
          "command": "release"
        }
      ],
      "commands": [
        {
          "name": "look",
          "help": "a read_only command",
          "effect": "read_only",
          "handler_returns": {
            "kind": "exit",
            "code": 0
          }
        },
        {
          "name": "release",
          "help": "a consequential command",
          "effect": "mutating",
          "consequential": true,
          "handler_returns": {
            "kind": "exit",
            "code": 0
          }
        }
      ]
    },
    "argv": [
      "look"
    ],
    "expect": {
      "exit_code": 0,
      "stdout_equals": "",
      "stderr_equals": "call error: command 'release' is consequential: the call must carry confirmation\n"
    }
  },
  {
    "name": "effects_call_consent: a consented programmatic call proceeds",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "pre_call": [
        {
          "command": "release",
          "approve_consequential": true
        }
      ],
      "commands": [
        {
          "name": "look",
          "help": "a read_only command",
          "effect": "read_only",
          "handler_returns": {
            "kind": "exit",
            "code": 0
          }
        },
        {
          "name": "release",
          "help": "a consequential command",
          "effect": "mutating",
          "consequential": true,
          "handler_returns": {
            "kind": "exit",
            "code": 0
          }
        }
      ]
    },
    "argv": [
      "look"
    ],
    "expect": {
      "exit_code": 0,
      "stdout_equals": "call ok: release\n",
      "stderr_equals": ""
    }
  },
  {
    "name": "effects_call_consent: read_only and plain mutating calls need no consent",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "pre_call": [
        {
          "command": "look"
        },
        {
          "command": "build"
        }
      ],
      "commands": [
        {
          "name": "look",
          "help": "a read_only command",
          "effect": "read_only",
          "handler_returns": {
            "kind": "exit",
            "code": 0
          }
        },
        {
          "name": "build",
          "help": "a mutating command",
          "effect": "mutating",
          "handler_returns": {
            "kind": "exit",
            "code": 0
          }
        }
      ]
    },
    "argv": [
      "look"
    ],
    "expect": {
      "exit_code": 0,
      "stdout_equals": "call ok: look\ncall ok: build\n",
      "stderr_equals": ""
    }
  },
  {
    "name": "effects_call_consent: a consented call with kwargs proceeds and the flag reaches the handler",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "pre_call": [
        {
          "command": "release",
          "kwargs": {
            "target": "prod"
          },
          "approve_consequential": true
        }
      ],
      "commands": [
        {
          "name": "look",
          "help": "a read_only command",
          "effect": "read_only",
          "handler_returns": {
            "kind": "exit",
            "code": 0
          }
        },
        {
          "name": "release",
          "help": "a consequential command",
          "effect": "mutating",
          "consequential": true,
          "flags": [
            {
              "name": "target",
              "type": "str",
              "help": "where to",
              "presence": "required"
            }
          ],
          "handler_returns": {
            "kind": "exit",
            "code": 0
          }
        }
      ]
    },
    "argv": [
      "look"
    ],
    "expect": {
      "exit_code": 0,
      "stdout_equals": "call ok: release\n",
      "stderr_equals": ""
    }
  },
  {
    "name": "effects_call_consent: MCP tools/call refuses a consequential tool the client cannot be asked about",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "release",
          "help": "a consequential command",
          "effect": "mutating",
          "consequential": true,
          "handler_returns": {
            "kind": "data",
            "data": {
              "released": true
            }
          }
        }
      ]
    },
    "argv": [
      "--mcp"
    ],
    "stdin": "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/call\",\"params\":{\"_meta\":{\"io.modelcontextprotocol/protocolVersion\":\"2026-07-28\",\"io.modelcontextprotocol/clientCapabilities\":{}},\"name\":\"release\"}}\n",
    "expect": {
      "exit_code": 0,
      "stdout_matches": [
        "\"code\":\\s*-32021",
        "Server requires the elicitation capability for this request",
        "\"requiredCapabilities\":\\s*\\{\"elicitation\":\\s*\\{\"form\":\\s*\\{\\}\\}\\}"
      ],
      "stderr_equals": "",
      "stdout_not_contains": [
        "released"
      ]
    }
  },
  {
    "name": "effects_call_consent: MCP tools/call proceeds when the call states consent",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "release",
          "help": "a consequential command",
          "effect": "mutating",
          "consequential": true,
          "handler_returns": {
            "kind": "data",
            "data": {
              "released": true
            }
          }
        }
      ]
    },
    "argv": [
      "--mcp"
    ],
    "stdin": "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/call\",\"params\":{\"_meta\":{\"io.modelcontextprotocol/protocolVersion\":\"2026-07-28\",\"io.modelcontextprotocol/clientCapabilities\":{}},\"name\":\"release\",\"approve_consequential\":true}}\n",
    "expect": {
      "exit_code": 0,
      "stdout_matches": [
        "released"
      ],
      "stdout_not_contains": [
        "isError"
      ],
      "stderr_equals": ""
    }
  },
