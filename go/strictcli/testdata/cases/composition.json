[
  {
    "name": "composition: member spelling + env, an env value elects nothing",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "env_prefix": "MYAPP",
      "commands": [
        {
          "name": "cmd",
          "help": "a command",
          "effect": "read_only",
          "flags": [
            {
              "name": "source",
              "help": "where to read from",
              "presence": "required",
              "elect_by": "member-flags",
              "choices": [
                {
                  "name": "file",
                  "help": "read from file",
                  "value": {
                    "type": "str",
                    "help": "the path"
                  }
                },
                {
                  "name": "url",
                  "help": "read from URL",
                  "value": {
                    "type": "str",
                    "help": "the url"
                  }
                }
              ]
            }
          ],
          "handler_prints": "source={source}"
        }
      ]
    },
    "argv": [
      "cmd"
    ],
    "env": {
      "MYAPP_FILE": "data.txt"
    },
    "expect": {
      "exit_code": 1,
      "stderr_contains": [
        "--file",
        "--url",
        "is required"
      ],
      "stderr_equals": "error: one of --file, --url is required\ntry 'myapp cmd --help'"
    }
  },
