[
  {
    "name": "float: basic float flag parses",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "cmd",
          "help": "a command",
          "effect": "read_only",
          "flags": [
            {
              "name": "rate",
              "type": "float",
              "help": "the rate",
              "presence": "required"
            }
          ],
          "handler_prints": "rate={rate}"
        }
      ]
    },
    "argv": [
      "cmd",
      "--rate",
      "3.14"
    ],
    "expect": {
      "exit_code": 0,
      "stdout_equals": "rate=3.14"
    }
  },
  {
    "name": "float: equals syntax",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "cmd",
          "help": "a command",
          "effect": "read_only",
          "flags": [
            {
              "name": "rate",
              "type": "float",
              "help": "the rate",
              "presence": "required"
            }
          ],
          "handler_prints": "rate={rate}"
        }
      ]
    },
    "argv": [
      "cmd",
      "--rate=3.14"
    ],
    "expect": {
      "exit_code": 0,
      "stdout_equals": "rate=3.14"
    }
  },
  {
    "name": "float: default value used when omitted",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "cmd",
          "help": "a command",
          "effect": "read_only",
          "flags": [
            {
              "name": "rate",
              "type": "float",
              "help": "the rate",
              "presence": "default",
              "default": 2.5
            }
          ],
          "handler_prints": "rate={rate}"
        }
      ]
    },
    "argv": [
      "cmd"
    ],
    "expect": {
      "exit_code": 0,
      "stdout_equals": "rate=2.5"
    }
  },
  {
    "name": "float: env var coerced to float",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "env_prefix": "MYAPP",
      "commands": [
        {
          "name": "cmd",
          "help": "a command",
          "effect": "read_only",
          "flags": [
            {
              "name": "rate",
              "type": "float",
              "help": "the rate",
              "presence": "default",
              "default": 1.5,
              "env": "MYAPP_RATE"
            }
          ],
          "handler_prints": "rate={rate}"
        }
      ]
    },
    "argv": [
      "cmd"
    ],
    "env": {
      "MYAPP_RATE": "9.99"
    },
    "expect": {
      "exit_code": 0,
      "stdout_equals": "rate=9.99"
    }
  },
  {
    "name": "float: required float flag missing produces error",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "cmd",
          "help": "a command",
          "effect": "read_only",
          "flags": [
            {
              "name": "rate",
              "type": "float",
              "help": "the rate",
              "presence": "required"
            }
          ],
          "handler_prints": "rate={rate}"
        }
      ]
    },
    "argv": [
      "cmd"
    ],
    "expect": {
      "exit_code": 1,
      "stderr_contains": "required",
      "stderr_equals": "error: flag '--rate' is required\ntry 'myapp cmd --help'"
    }
  },
  {
    "name": "float: reject non-numeric string",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "cmd",
          "help": "a command",
          "effect": "read_only",
          "flags": [
            {
              "name": "rate",
              "type": "float",
              "help": "the rate",
              "presence": "required"
            }
          ],
          "handler_prints": "rate={rate}"
        }
      ]
    },
    "argv": [
      "cmd",
      "--rate",
      "abc"
    ],
    "expect": {
      "exit_code": 1,
      "stderr_contains": [
        "expected float",
        "'abc'"
      ],
      "stderr_equals": "error: --rate: expected float, got 'abc'\ntry 'myapp cmd --help'"
    }
  },
  {
    "name": "float: reject NaN",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "cmd",
          "help": "a command",
          "effect": "read_only",
          "flags": [
            {
              "name": "rate",
              "type": "float",
              "help": "the rate",
              "presence": "required"
            }
          ],
          "handler_prints": "rate={rate}"
        }
      ]
    },
    "argv": [
      "cmd",
      "--rate",
      "NaN"
    ],
    "expect": {
      "exit_code": 1,
      "stderr_contains": "NaN is not allowed"
    }
  },
  {
    "name": "float: reject Inf",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "cmd",
          "help": "a command",
          "effect": "read_only",
          "flags": [
            {
              "name": "rate",
              "type": "float",
              "help": "the rate",
              "presence": "required"
            }
          ],
          "handler_prints": "rate={rate}"
        }
      ]
    },
    "argv": [
      "cmd",
      "--rate",
      "Inf"
    ],
    "expect": {
      "exit_code": 1,
      "stderr_contains": "Inf is not allowed"
    }
  },
  {
    "name": "float: choices valid value accepted",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "cmd",
          "help": "a command",
          "effect": "read_only",
          "flags": [
            {
              "name": "rate",
              "type": "float",
              "help": "the rate",
              "presence": "required",
              "choices_float": [
                {
                  "value": 1.5
                },
                {
                  "value": 2.5
                },
                {
                  "value": 3.5
                }
              ]
            }
          ],
          "handler_prints": "rate={rate}"
        }
      ]
    },
    "argv": [
      "cmd",
      "--rate",
      "2.5"
    ],
    "expect": {
      "exit_code": 0,
      "stdout_equals": "rate=2.5"
    }
  },
  {
    "name": "float: choices invalid value rejected",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "cmd",
          "help": "a command",
          "effect": "read_only",
          "flags": [
            {
              "name": "rate",
              "type": "float",
              "help": "the rate",
              "presence": "required",
              "choices_float": [
                {
                  "value": 1.5
                },
                {
                  "value": 2.5
                },
                {
                  "value": 3.5
                }
              ]
            }
          ],
          "handler_prints": "rate={rate}"
        }
      ]
    },
    "argv": [
      "cmd",
      "--rate",
      "4.5"
    ],
    "expect": {
      "exit_code": 1,
      "stderr_contains": [
        "invalid value",
        "4.5"
      ]
    }
  },
  {
    "name": "float: negative value",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "cmd",
          "help": "a command",
          "effect": "read_only",
          "flags": [
            {
              "name": "temp",
              "type": "float",
              "help": "temperature",
              "presence": "required"
            }
          ],
          "handler_prints": "temp={temp}"
        }
      ]
    },
    "argv": [
      "cmd",
      "--temp",
      "-40.5"
    ],
    "expect": {
      "exit_code": 0,
      "stdout_equals": "temp=-40.5"
    }
  },
  {
    "name": "float: reject NaN from env var",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "cmd",
          "help": "a command",
          "effect": "read_only",
          "flags": [
            {
              "name": "rate",
              "type": "float",
              "help": "the rate",
              "presence": "required",
              "env": "MYAPP_RATE"
            }
          ],
          "handler_prints": "rate={rate}"
        }
      ]
    },
    "argv": [
      "cmd"
    ],
    "env": {
      "MYAPP_RATE": "nan"
    },
    "expect": {
      "exit_code": 1,
      "stderr_contains": "NaN is not allowed (from env var 'MYAPP_RATE')"
    }
  },
  {
    "name": "float: reject overflow to infinity",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "cmd",
          "help": "a command",
          "effect": "read_only",
          "flags": [
            {
              "name": "rate",
              "type": "float",
              "help": "the rate",
              "presence": "required"
            }
          ],
          "handler_prints": "rate={rate}"
        }
      ]
    },
    "argv": [
      "cmd",
      "--rate",
      "1e999"
    ],
    "expect": {
      "exit_code": 1,
      "stderr_contains": [
        "expected float",
        "'1e999'"
      ],
      "stderr_equals": "error: --rate: expected float, got '1e999'\ntry 'myapp cmd --help'"
    }
  },
  {
    "name": "float: an unelected member contributes nothing to the delivered record",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "cmd",
          "help": "a command",
          "effect": "read_only",
          "flags": [
            {
              "name": "source",
              "help": "where the value comes from",
              "presence": "required",
              "elect_by": "member-flags",
              "choices": [
                {
                  "name": "rate",
                  "help": "the rate",
                  "value": {
                    "type": "float",
                    "help": "the rate"
                  }
                },
                {
                  "name": "preset",
                  "help": "a named preset",
                  "value": {
                    "type": "str",
                    "help": "a named preset"
                  }
                }
              ]
            }
          ],
          "handler_prints": "source={source}"
        }
      ]
    },
    "argv": [
      "cmd",
      "--preset",
      "fast"
    ],
    "expect": {
      "exit_code": 0,
      "stdout_equals": "source=preset(value=fast)"
    }
  },
  {
    "name": "float: optional float arg omitted delivers None",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "cmd",
          "help": "a command",
          "effect": "read_only",
          "args": [
            {
              "name": "ratio",
              "type": "float",
              "help": "the ratio",
              "presence": "optional"
            }
          ],
          "handler_prints": "ratio={ratio}"
        }
      ]
    },
    "argv": [
      "cmd"
    ],
    "expect": {
      "exit_code": 0,
      "stdout_equals": "ratio=None"
    }
  }
]
