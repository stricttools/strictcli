[
  {
    "name": "effects_dry_run_log: every verb renders in the pinned line format",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "everything",
          "help": "issue one effect of every verb",
          "effect": "mutating",
          "handler_effects": [
            {
              "method": "run",
              "argv": [
                "git",
                "tag",
                "v1.2.3"
              ]
            },
            {
              "method": "spawn",
              "argv": [
                "worker",
                "--daemon"
              ]
            },
            {
              "method": "write",
              "path": "CHANGELOG.md",
              "content": "hello"
            },
            {
              "method": "mkdir",
              "path": "build/out"
            },
            {
              "method": "remove",
              "path": "build/stale"
            },
            {
              "method": "rename",
              "path": "old.txt",
              "to": "new.txt"
            },
            {
              "method": "chmod",
              "path": "run.sh",
              "mode": "755"
            },
            {
              "method": "http",
              "http_method": "POST",
              "url": "https://api.example.com/releases"
            }
          ]
        }
      ]
    },
    "argv": [
      "--dry-run",
      "everything"
    ],
    "expect": {
      "exit_code": 0,
      "stdout_equals": "DRY RUN — no changes were made. Would do:\n  1. run: git tag v1.2.3\n  2. spawn: worker --daemon\n  3. write: CHANGELOG.md (5 bytes)\n  4. mkdir: build/out\n  5. remove: build/stale\n  6. rename: old.txt -> new.txt\n  7. chmod: run.sh 0755\n  8. net: POST https://api.example.com/releases\n"
    }
  },
  {
    "name": "effects_dry_run_log: chmod renders its mode as leading-zero octal",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "modes",
          "help": "chmod a few paths",
          "effect": "mutating",
          "handler_effects": [
            {
              "method": "chmod",
              "path": "a.sh",
              "mode": "755"
            },
            {
              "method": "chmod",
              "path": "b.txt",
              "mode": "644"
            },
            {
              "method": "chmod",
              "path": "c.key",
              "mode": "600"
            },
            {
              "method": "chmod",
              "path": "d.tmp",
              "mode": "7"
            }
          ]
        }
      ]
    },
    "argv": [
      "--dry-run",
      "modes"
    ],
    "expect": {
      "exit_code": 0,
      "stdout_equals": "DRY RUN — no changes were made. Would do:\n  1. chmod: a.sh 0755\n  2. chmod: b.txt 0644\n  3. chmod: c.key 0600\n  4. chmod: d.tmp 07\n"
    }
  },
  {
    "name": "effects_dry_run_log: write renders the encoded byte count, not the character count",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "writes",
          "help": "write a few files",
          "effect": "mutating",
          "handler_effects": [
            {
              "method": "write",
              "path": "empty.txt",
              "content": ""
            },
            {
              "method": "write",
              "path": "ascii.txt",
              "content": "abc"
            },
            {
              "method": "write",
              "path": "utf8.txt",
              "content": "héllo"
            }
          ]
        }
      ]
    },
    "argv": [
      "--dry-run",
      "writes"
    ],
    "expect": {
      "exit_code": 0,
      "stdout_equals": "DRY RUN — no changes were made. Would do:\n  1. write: empty.txt (0 bytes)\n  2. write: ascii.txt (3 bytes)\n  3. write: utf8.txt (6 bytes)\n"
    }
  },
  {
    "name": "effects_dry_run_log: the grant suffix renders name and reason",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "release",
          "help": "push a release",
          "effect": "mutating",
          "grants": [
            {
              "name": "push",
              "reason": "release engine owns remote refs",
              "kind": "proc_mutate"
            }
          ],
          "handler_effects": [
            {
              "method": "run",
              "argv": [
                "git",
                "tag",
                "v1.2.3"
              ]
            },
            {
              "method": "run",
              "argv": [
                "git",
                "push",
                "origin",
                "v1.2.3"
              ],
              "grant": "push"
            }
          ]
        }
      ]
    },
    "argv": [
      "--dry-run",
      "release"
    ],
    "expect": {
      "exit_code": 0,
      "stdout_equals": "DRY RUN — no changes were made. Would do:\n  1. run: git tag v1.2.3\n  2. run: git push origin v1.2.3 (granted: push — release engine owns remote refs)\n"
    }
  },
  {
    "name": "effects_dry_run_log: skip_if_current renders the conditional suffix",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "publish",
          "help": "publish a release",
          "effect": "mutating",
          "handler_effects": [
            {
              "method": "http",
              "http_method": "POST",
              "url": "https://api.github.com/repos/o/r/releases",
              "skip_if_current": "gh-release:v1.2.3"
            }
          ]
        }
      ]
    },
    "argv": [
      "--dry-run",
      "publish"
    ],
    "expect": {
      "exit_code": 0,
      "stdout_equals": "DRY RUN — no changes were made. Would do:\n  1. net: POST https://api.github.com/repos/o/r/releases [unless resource 'gh-release:v1.2.3' already current]\n"
    }
  },
  {
    "name": "effects_dry_run_log: the grant suffix precedes the conditional suffix",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "sync",
          "help": "sync the remote",
          "effect": "mutating",
          "grants": [
            {
              "name": "push",
              "reason": "release engine owns remote refs",
              "kind": "proc_mutate"
            }
          ],
          "handler_effects": [
            {
              "method": "run",
              "argv": [
                "git",
                "push",
                "origin",
                "main"
              ],
              "resource": "remote:origin/main",
              "skip_if_current": "remote:origin/main",
              "grant": "push"
            }
          ]
        }
      ]
    },
    "argv": [
      "--dry-run",
      "sync"
    ],
    "expect": {
      "exit_code": 0,
      "stdout_equals": "DRY RUN — no changes were made. Would do:\n  1. run: git push origin main (granted: push — release engine owns remote refs) [unless resource 'remote:origin/main' already current]\n"
    }
  },
  {
    "name": "effects_dry_run_log: resource alone adds no suffix",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "tag",
          "help": "tag a release",
          "effect": "mutating",
          "handler_effects": [
            {
              "method": "run",
              "argv": [
                "git",
                "tag",
                "v1.2.3"
              ],
              "resource": "tag:v1.2.3"
            }
          ]
        }
      ]
    },
    "argv": [
      "--dry-run",
      "tag"
    ],
    "expect": {
      "exit_code": 0,
      "stdout_equals": "DRY RUN — no changes were made. Would do:\n  1. run: git tag v1.2.3\n"
    }
  },
  {
    "name": "effects_dry_run_log: a read-only command's would-do body is always empty",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "show",
          "help": "show something",
          "effect": "read_only",
          "handler_prints": "shown"
        }
      ]
    },
    "argv": [
      "--dry-run",
      "show"
    ],
    "expect": {
      "exit_code": 0,
      "stdout_equals": "shown\nDRY RUN — no changes were made. Would do:\n"
    }
  },
  {
    "name": "effects_dry_run_log: quiet never suppresses the would-do log",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "build",
          "help": "build something",
          "effect": "mutating",
          "handler_effects": [
            {
              "method": "mkdir",
              "path": "build"
            },
            {
              "method": "write",
              "path": "build/out.txt",
              "content": "ok"
            }
          ]
        }
      ]
    },
    "argv": [
      "--quiet",
      "--dry-run",
      "build"
    ],
    "expect": {
      "exit_code": 0,
      "stdout_equals": "DRY RUN — no changes were made. Would do:\n  1. mkdir: build\n  2. write: build/out.txt (2 bytes)\n"
    }
  },
  {
    "name": "effects_dry_run_log: the handler's own exit code survives dry mode",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "build",
          "help": "build something",
          "effect": "mutating",
          "handler_exit_code": 3,
          "handler_effects": [
            {
              "method": "mkdir",
              "path": "build"
            }
          ]
        }
      ]
    },
    "argv": [
      "--dry-run",
      "build"
    ],
    "expect": {
      "exit_code": 3,
      "stdout_equals": "DRY RUN — no changes were made. Would do:\n  1. mkdir: build\n"
    }
  },
  {
    "name": "effects_dry_run_log: dry mode does not prompt for a mutating command",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "wipe",
          "help": "wipe something",
          "effect": "mutating",
          "handler_effects": [
            {
              "method": "remove",
              "path": "state"
            }
          ]
        }
      ]
    },
    "argv": [
      "--dry-run",
      "wipe"
    ],
    "expect": {
      "exit_code": 0,
      "stdout_equals": "DRY RUN — no changes were made. Would do:\n  1. remove: state\n",
      "stderr_equals": ""
    }
  },
  {
    "name": "effects_dry_run_log: an aborted dispatch still renders the log, marked incomplete",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "build",
          "help": "build something",
          "effect": "mutating",
          "handler_effects": [
            {
              "method": "mkdir",
              "path": "build"
            },
            {
              "method": "write",
              "path": "VERSION",
              "content": "1.2.3"
            }
          ],
          "handler_aborts": true
        }
      ]
    },
    "argv": [
      "--dry-run",
      "build"
    ],
    "expect": {
      "exit_code": 2,
      "stdout_equals": "DRY RUN — no changes were made. Would do:\n  1. mkdir: build\n  2. write: VERSION (5 bytes)\n",
      "stdout_not_contains": "aborted",
      "stderr_contains": "error: dry-run preview ends at step 3: build aborted — the preview above may be incomplete"
    }
  },
  {
    "name": "effects_dry_run_log: an aborted read-only preview is still header with empty body",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "show",
          "help": "show something",
          "effect": "read_only",
          "handler_aborts": true
        }
      ]
    },
    "argv": [
      "--dry-run",
      "show"
    ],
    "expect": {
      "exit_code": 2,
      "stdout_equals": "DRY RUN — no changes were made. Would do:\n",
      "stderr_contains": "show aborted — the preview above may be incomplete"
    }
  },
  {
    "name": "effects_dry_run_log: an aborted dispatch outside dry mode renders neither log nor marker",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "show",
          "help": "show something",
          "effect": "read_only",
          "handler_aborts": true
        }
      ]
    },
    "argv": [
      "show"
    ],
    "expect": {
      "exit_code": 2,
      "stdout_equals": "",
      "stderr_not_contains": "the preview above may be incomplete"
    }
  }
]
