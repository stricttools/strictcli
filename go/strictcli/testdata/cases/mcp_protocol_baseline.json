      ],
      "groups": [
        {
          "name": "dns",
          "help": "manage DNS",
          "commands": [
            {
              "name": "zone-list",
              "help": "list DNS zones",
              "effect": "read_only",
              "handler_returns": {
                "kind": "data",
                "data": {
                  "zones": 1
