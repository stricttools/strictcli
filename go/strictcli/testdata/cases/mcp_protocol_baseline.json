      "commands": [
        {
          "name": "status",
          "help": "show status",
          "effect": "read_only",
          "handler_returns": {
            "kind": "data",
            "data": {
              "ok": true
            }
          }
        }
      ],
      "groups": [
        {
          "name": "dns",
          "help": "manage DNS",
          "commands": [
            {
              "name": "zone-list",
              "help": "list DNS zones",
              "effect": "read_only",
              "handler_returns": {
                "kind": "data",
                "data": {
                  "zones": 1
                }
              }
            }
          ],
          "groups": [
            {
              "name": "zone",
              "help": "manage zones",
              "commands": [
                {
                  "name": "create",
                  "help": "create a zone",
                  "effect": "read_only",
                  "handler_returns": {
                    "kind": "data",
                    "data": {
                      "created": true
                    }
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    "argv": [
      "--mcp"
    ],
    "protocol_script": [
      {
        "send": "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/call\",\"params\":{\"_meta\":{\"io.modelcontextprotocol/protocolVersion\":\"2026-07-28\",\"io.modelcontextprotocol/clientCapabilities\":{}},\"name\":\"no_such_tool\",\"arguments\":{}}}",
        "expect_line": {
          "json_equals": {
            "jsonrpc": "2.0",
            "id": 1,
            "result": {
              "resultType": "complete",
              "content": [
                {
                  "type": "text",
                  "text": "unknown command 'no_such_tool'"
                }
              ],
              "isError": true,
              "_meta": {
                "io.modelcontextprotocol/serverInfo": {
                  "name": "myapp",
                  "version": "1.0.0"
