[
  {
    "name": "mcp_baseline: tools/list publishes one tool per leaf command, named by its dotted path",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "status",
          "help": "show status",
          "effect": "read_only",
          "handler_returns": {
            "kind": "data",
            "data": {
              "ok": true
            }
          }
        }
      ],
      "groups": [
        {
          "name": "dns",
          "help": "manage DNS",
          "commands": [
            {
              "name": "zone-list",
              "help": "list DNS zones",
              "effect": "read_only",
              "handler_returns": {
                "kind": "data",
                "data": {
                  "zones": 1
                }
              }
            }
          ],
          "groups": [
            {
              "name": "zone",
              "help": "manage zones",
              "commands": [
                {
                  "name": "create",
                  "help": "create a zone",
                  "effect": "read_only",
                  "handler_returns": {
                    "kind": "data",
                    "data": {
                      "created": true
                    }
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    "argv": [
      "--mcp"
    ],
    "protocol_script": [
      {
        "send": "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/list\",\"params\":{\"_meta\":{\"io.modelcontextprotocol/protocolVersion\":\"2026-07-28\",\"io.modelcontextprotocol/clientCapabilities\":{}}}}",
        "expect_line": {
          "json_equals": {
            "jsonrpc": "2.0",
            "id": 1,
            "result": {
              "resultType": "complete",
              "tools": [
                {
                  "name": "status",
                  "description": "show status",
                  "effect": "read_only",
                  "inputSchema": {
                    "type": "object",
                    "properties": {},
                    "required": [],
                    "additionalProperties": false
                  }
                },
                {
                  "name": "dns.zone-list",
                  "description": "list DNS zones",
                  "effect": "read_only",
                  "inputSchema": {
                    "type": "object",
                    "properties": {},
                    "required": [],
                    "additionalProperties": false
                  }
                },
                {
                  "name": "dns.zone.create",
                  "description": "create a zone",
                  "effect": "read_only",
                  "inputSchema": {
                    "type": "object",
                    "properties": {},
                    "required": [],
                    "additionalProperties": false
                  }
                }
              ],
              "ttlMs": 3600000,
              "cacheScope": "public",
              "_meta": {
                "io.modelcontextprotocol/serverInfo": {
                  "name": "myapp",
                  "version": "1.0.0"
                }
              }
            }
          }
        }
      }
    ],
    "expect": {
      "exit_code": 0,
      "stderr_equals": ""
    }
  },
