    "argv": [
      "--port",
      "8080",
      "cmd"
    ],
    "expect": {
      "exit_code": 0,
      "stdout_equals": "port=8080"
    }
  },
  {
    "name": "global_flags: global flags shown in app help",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "global_flags": [
        {
          "name": "chatter",
          "type": "bool",
          "help": "enable chatter output",
          "presence": "default",
          "default": false
        },
        {
          "name": "settings",
          "type": "str",
          "help": "settings directory",
          "presence": "default",
          "default": "/etc/myapp"
        }
      ],
      "commands": [
        {
          "name": "run",
          "help": "run something",
          "effect": "read_only",
          "handler_prints": "ok"
        }
      ]
    },
    "argv": [
      "--help"
    ],
    "expect": {
      "exit_code": 0,
      "stdout_contains": [
        "Global flags:",
        "--chatter",
        "--settings",
        "enable chatter output"
      ],
      "stdout_equals": "myapp v1.0.0 -- test app\n\nCommands:\n  run    run something\n\nGlobal flags:\n  --chatter     enable chatter output\n  --settings    settings directory\n\nUse 'myapp help <command>' for more information."
    }
  },
  {
    "name": "global_flags: global flag shown in command help",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "global_flags": [
        {
          "name": "chatter",
          "type": "bool",
          "help": "enable chatter output",
          "presence": "default",
          "default": false
        }
      ],
      "commands": [
        {
          "name": "cmd",
          "help": "a command",
          "effect": "read_only",
          "handler_prints": "ok"
        }
      ]
    },
    "argv": [
      "cmd",
      "--help"
    ],
    "expect": {
      "exit_code": 0,
      "stdout_contains": [
        "--chatter",
        "enable chatter output"
      ],
      "stdout_equals": "myapp cmd -- a command\n\nGlobal flags:\n  --chatter, --no-chatter    enable chatter output [default: false]"
    }
  },
  {
    "name": "global_flags: global flag with env var",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "env_prefix": "MYAPP",
      "global_flags": [
        {
          "name": "chatter",
          "type": "bool",
          "help": "enable chatter output",
          "presence": "default",
          "env": "MYAPP_CHATTER",
          "default": false
        }
      ],
      "commands": [
        {
          "name": "cmd",
          "help": "a command",
          "effect": "read_only",
          "handler_prints": "chatter={chatter}"
        }
      ]
    },
    "argv": [
      "cmd"
    ],
    "env": {
      "MYAPP_CHATTER": "true"
    },
    "expect": {
      "exit_code": 0,
      "stdout_equals": "chatter=true"
    }
  },
  {
    "name": "global_flags: global flag and command flag together",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "global_flags": [
        {
          "name": "chatter",
          "type": "bool",
          "help": "enable chatter output",
          "presence": "default",
          "default": false
        }
      ],
      "commands": [
        {
          "name": "deploy",
          "help": "deploy the app",
          "effect": "read_only",
          "flags": [
            {
              "name": "target",
              "type": "str",
              "help": "deploy target",
              "presence": "required"
            }
          ],
          "handler_prints": "chatter={chatter} target={target}"
        }
      ]
    },
    "argv": [
      "--chatter",
      "deploy",
      "--target",
      "prod"
    ],
    "expect": {
      "exit_code": 0,
      "stdout_equals": "chatter=true target=prod"
    }
  },
  {
    "name": "global_flags: global flag default when not provided",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "global_flags": [
        {
          "name": "chatter",
          "type": "bool",
          "help": "enable chatter output",
          "presence": "default",
          "default": false
        },
        {
          "name": "settings",
          "type": "str",
          "help": "settings path",
          "presence": "default",
          "default": "/etc/myapp"
        }
      ],
      "commands": [
        {
          "name": "cmd",
          "help": "a command",
          "effect": "read_only",
          "handler_prints": "chatter={chatter} settings={settings}"
        }
      ]
    },
    "argv": [
      "cmd"
    ],
    "expect": {
      "exit_code": 0,
      "stdout_equals": "chatter=false settings=/etc/myapp"
    }
  },
  {
    "name": "global_flags: handler prints both global and command flag values",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "global_flags": [
        {
          "name": "chatter",
          "type": "bool",
          "help": "enable chatter output",
          "presence": "default",
          "default": false
        },
        {
          "name": "settings",
          "type": "str",
          "help": "settings path",
          "presence": "default",
          "default": "/etc/myapp"
        }
      ],
      "commands": [
        {
          "name": "deploy",
          "help": "deploy the app",
          "effect": "read_only",
          "flags": [
            {
              "name": "force-deploy",
              "type": "bool",
              "help": "force deploy",
              "presence": "default",
              "default": false
            }
          ],
          "handler_prints": "chatter={chatter} settings={settings} force-deploy={force-deploy}"
        }
      ]
    },
    "argv": [
      "--chatter",
      "--settings",
      "/tmp/cfg",
      "deploy",
      "--force-deploy"
    ],
    "expect": {
      "exit_code": 0,
      "stdout_equals": "chatter=true settings=/tmp/cfg force-deploy=true"
    }
  }
]
