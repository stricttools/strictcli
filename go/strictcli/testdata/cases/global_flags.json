[
  {
    "name": "global_flags: global bool flag before command name",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "global_flags": [
        {
          "name": "chatter",
          "type": "bool",
          "help": "enable chatter output",
          "presence": "default",
          "default": false
        }
      ],
      "commands": [
        {
          "name": "cmd",
          "help": "a command",
          "effect": "read_only",
          "handler_prints": "chatter={chatter}"
        }
      ]
    },
    "argv": [
      "--chatter",
      "cmd"
    ],
    "expect": {
      "exit_code": 0,
      "stdout_equals": "chatter=true"
    }
  },
  {
    "name": "global_flags: global bool flag after command name",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "global_flags": [
        {
          "name": "chatter",
          "type": "bool",
          "help": "enable chatter output",
          "presence": "default",
          "default": false
        }
      ],
      "commands": [
        {
          "name": "cmd",
          "help": "a command",
          "effect": "read_only",
          "handler_prints": "chatter={chatter}"
        }
      ]
    },
    "argv": [
      "cmd",
      "--chatter"
    ],
    "expect": {
      "exit_code": 0,
      "stdout_equals": "chatter=true"
    }
  },
  {
    "name": "global_flags: global bool flag negation",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "global_flags": [
        {
          "name": "chatter",
          "type": "bool",
          "help": "enable chatter output",
          "presence": "default",
          "default": false
        }
      ],
      "commands": [
        {
          "name": "cmd",
          "help": "a command",
          "effect": "read_only",
          "handler_prints": "chatter={chatter}"
        }
      ]
    },
    "argv": [
      "--no-chatter",
      "cmd"
    ],
    "expect": {
      "exit_code": 0,
      "stdout_equals": "chatter=false"
    }
  },
  {
    "name": "global_flags: global str flag",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "global_flags": [
        {
          "name": "settings",
          "type": "str",
          "help": "settings directory",
          "presence": "default",
          "default": "/etc/myapp"
        }
      ],
      "commands": [
        {
          "name": "cmd",
          "help": "a command",
          "effect": "read_only",
          "handler_prints": "settings={settings}"
        }
      ]
    },
    "argv": [
      "--settings",
      "/tmp",
      "cmd"
    ],
    "expect": {
      "exit_code": 0,
      "stdout_equals": "settings=/tmp"
    }
  },
  {
    "name": "global_flags: global int flag",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "global_flags": [
        {
          "name": "port",
          "type": "int",
          "help": "server port",
          "presence": "default",
          "default": 3000
        }
      ],
      "commands": [
        {
          "name": "cmd",
          "help": "a command",
          "effect": "read_only",
          "handler_prints": "port={port}"
        }
      ]
