[
  {
    "name": "unwaited child: a child still running when the handler returns is killed and fails the run",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "start",
          "help": "start a worker",
          "effect": "mutating",
          "handler_effects": [
            {"method": "spawn", "argv": ["sleep", "30"]}
          ]
        }
      ]
    },
    "argv": ["start"],
    "expect": {
      "exit_code": 1,
      "stdout_equals": "",
      "stderr_matches": "\\Aerror: child process [0-9]+ was still running when the handler ended and was killed: sleep 30\\n\\z"
    }
  },
  {
    "name": "unwaited child: under --json the kill is an error diagnostic and stderr stays empty",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "start",
          "help": "start a worker",
          "effect": "mutating",
          "handler_diagnostics": [
            {"level": "warn", "message": "starting"}
          ],
          "handler_effects": [
            {"method": "spawn", "argv": ["sleep", "30"]}
          ]
        }
      ]
    },
    "argv": ["--json", "start"],
    "expect": {
      "exit_code": 1,
      "stdout_matches": "\\A\\{\"interface_version\":3,\"app\":\"myapp\",\"app_version\":\"1\\.0\\.0\",\"command\":\"start\",\"exit_code\":1,\"payload\":null,\"output\":null,\"dry_run\":false,\"writes\":null,\"preview\":\\[\\{\"detail\":\"sleep 30\",\"kind\":\"proc_spawn\",\"recorded\":false,\"seq\":1,\"verb\":\"spawn\"\\}\\],\"preview_error\":null,\"diagnostics\":\\[\\{\"level\":\"warn\",\"message\":\"starting\"\\},\\{\"level\":\"error\",\"message\":\"child process [0-9]+ was still running when the handler ended and was killed: sleep 30\"\\}\\]\\}\\n\\z",
      "stderr_equals": ""
    }
  },
  {
    "name": "unwaited child: a nonzero status the handler chose is kept",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "start",
          "help": "start a worker",
          "effect": "mutating",
          "handler_effects": [
            {"method": "spawn", "argv": ["sleep", "30"]}
          ],
          "handler_returns": {"kind": "exit", "code": 3}
        }
      ]
    },
    "argv": ["start"],
    "expect": {
      "exit_code": 3,
      "stdout_equals": "",
      "stderr_matches": "\\Aerror: child process [0-9]+ was still running when the handler ended and was killed: sleep 30\\n\\z"
    }
  },
  {
    "name": "unwaited child: an early exit keeps its code and its message comes first",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "start",
          "help": "start a worker",
          "effect": "mutating",
          "handler_effects": [
            {"method": "spawn", "argv": ["sleep", "30"]}
          ],
          "handler_exit_now": {"code": 4, "message": "worker config is missing"}
        }
      ]
    },
    "argv": ["start"],
    "expect": {
      "exit_code": 4,
      "stdout_equals": "",
      "stderr_matches": "\\Aerror: worker config is missing\\nerror: child process [0-9]+ was still running when the handler ended and was killed: sleep 30\\n\\z"
    }
  },
  {
    "name": "unwaited child: every running child is named, in the order they were spawned",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "start",
          "help": "start two workers",
          "effect": "mutating",
          "handler_effects": [
            {"method": "spawn", "argv": ["sleep", "30"]},
            {"method": "spawn", "argv": ["sleep", "31"]}
          ]
        }
      ]
    },
    "argv": ["start"],
    "expect": {
      "exit_code": 1,
      "stdout_equals": "",
      "stderr_matches": "\\Aerror: child process [0-9]+ was still running when the handler ended and was killed: sleep 30\\nerror: child process [0-9]+ was still running when the handler ended and was killed: sleep 31\\n\\z"
    }
  },
  {
    "name": "unwaited child: the signal's diagnostic follows the child's and its status replaces 1",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "start",
          "help": "start a worker",
          "effect": "mutating",
          "handler_effects": [
            {"method": "spawn", "argv": ["sleep", "30"]}
          ],
          "handler_signals_self": "SIGTERM"
        }
      ]
    },
    "argv": ["start"],
    "expect": {
      "exit_code": 143,
      "stdout_equals": "",
      "stderr_matches": "\\Aerror: child process [0-9]+ was still running when the handler ended and was killed: sleep 30\\nerror: canceled by signal SIGTERM\\n\\z"
    }
  },
  {
    "name": "waited child: a child the handler waited on is not settled again, and its output streams in human mode",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "start",
          "help": "start a worker",
          "effect": "mutating",
          "handler_effects": [
            {"method": "spawn", "argv": ["echo", "hi"], "wait": true}
          ]
        }
      ]
    },
    "argv": ["start"],
    "expect": {
      "exit_code": 0,
      "stdout_equals": "hi\n",
      "stderr_equals": ""
    }
  },
  {
    "name": "waited child: under --json its stdout is in output and no diagnostic is added",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "start",
          "help": "start a worker",
          "effect": "mutating",
          "handler_effects": [
            {"method": "spawn", "argv": ["echo", "hi"], "wait": true}
          ]
        }
      ]
    },
    "argv": ["--json", "start"],
    "expect": {
      "exit_code": 0,
      "stdout_equals": "{\"interface_version\":3,\"app\":\"myapp\",\"app_version\":\"1.0.0\",\"command\":\"start\",\"exit_code\":0,\"payload\":null,\"output\":\"hi\\n\",\"dry_run\":false,\"writes\":null,\"preview\":[{\"detail\":\"echo hi\",\"kind\":\"proc_spawn\",\"recorded\":false,\"seq\":1,\"verb\":\"spawn\"}],\"preview_error\":null,\"diagnostics\":[]}\n",
      "stderr_equals": ""
    }
  },
  {
    "name": "exited child: a child that exited before the handler returned is drained, not an error",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "start",
          "help": "start a worker",
          "effect": "mutating",
          "handler_effects": [
            {"method": "spawn", "argv": ["echo", "hi"]},
            {"method": "run", "argv": ["sleep", "1"]}
          ]
        }
      ]
    },
    "argv": ["--json", "start"],
    "expect": {
      "exit_code": 0,
      "stdout_equals": "{\"interface_version\":3,\"app\":\"myapp\",\"app_version\":\"1.0.0\",\"command\":\"start\",\"exit_code\":0,\"payload\":null,\"output\":\"hi\\n\",\"dry_run\":false,\"writes\":null,\"preview\":[{\"detail\":\"echo hi\",\"kind\":\"proc_spawn\",\"recorded\":false,\"seq\":1,\"verb\":\"spawn\"},{\"detail\":\"sleep 1\",\"kind\":\"proc_mutate\",\"recorded\":false,\"seq\":2,\"verb\":\"run\"}],\"preview_error\":null,\"diagnostics\":[]}\n",
      "stderr_equals": ""
    }
  },
  {
    "name": "unwaited child: a dry run spawns nothing, so there is nothing to settle",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "start",
          "help": "start a worker",
          "effect": "mutating",
          "handler_effects": [
            {"method": "spawn", "argv": ["sleep", "30"]}
          ]
        }
      ]
    },
    "argv": ["--dry-run", "start"],
    "expect": {
      "exit_code": 0,
      "stdout_equals": "DRY RUN — no changes were made. Would do:\n  1. spawn: sleep 30\n",
      "stderr_equals": ""
    }
  }
]
