[
  {
    "name": "envelope: a plain exit emits the envelope as the sole stdout document",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "cmd",
          "help": "a command",
          "effect": "read_only"
        }
      ]
    },
    "argv": [
      "--json",
      "cmd"
    ],
    "expect": {
      "exit_code": 0,
      "stdout_equals": "{\"interface_version\":3,\"app\":\"myapp\",\"app_version\":\"1.0.0\",\"command\":\"cmd\",\"exit_code\":0,\"payload\":null,\"output\":null,\"dry_run\":false,\"writes\":null,\"preview\":[],\"preview_error\":null,\"diagnostics\":[]}\n",
      "stderr_equals": ""
    }
  },
  {
    "name": "envelope: a payload exit carries the handler's payload",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "cmd",
          "help": "a command",
          "effect": "read_only",
          "handler_returns": {
            "kind": "data",
            "data": {
              "ok": true
            }
          }
        }
      ]
    },
    "argv": [
      "--json",
      "cmd"
    ],
    "expect": {
      "exit_code": 0,
      "stdout_equals": "{\"interface_version\":3,\"app\":\"myapp\",\"app_version\":\"1.0.0\",\"command\":\"cmd\",\"exit_code\":0,\"payload\":{\"ok\":true},\"output\":null,\"dry_run\":false,\"writes\":null,\"preview\":[],\"preview_error\":null,\"diagnostics\":[]}\n",
      "stderr_equals": ""
    }
  },
  {
    "name": "envelope: a non-zero exit carries the exit code",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "cmd",
          "help": "a command",
          "effect": "read_only",
          "handler_returns": {
            "kind": "exit",
            "code": 3
          }
        }
      ]
    },
    "argv": [
      "--json",
      "cmd"
    ],
    "expect": {
      "exit_code": 3,
      "stdout_equals": "{\"interface_version\":3,\"app\":\"myapp\",\"app_version\":\"1.0.0\",\"command\":\"cmd\",\"exit_code\":3,\"payload\":null,\"output\":null,\"dry_run\":false,\"writes\":null,\"preview\":[],\"preview_error\":null,\"diagnostics\":[]}\n",
      "stderr_equals": ""
    }
  },
  {
    "name": "envelope: the handler's diagnostics ride the envelope in emission order",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "cmd",
          "help": "a command",
          "effect": "read_only",
          "handler_diagnostics": [
            {
              "level": "info",
              "message": "starting"
            },
            {
              "level": "warn",
              "message": "careful"
            },
            {
              "level": "debug",
              "message": "detail"
            },
            {
              "level": "error",
              "message": "bad"
            }
          ]
        }
      ]
    },
    "argv": [
      "--json",
      "cmd"
    ],
    "expect": {
      "exit_code": 0,
      "stdout_equals": "{\"interface_version\":3,\"app\":\"myapp\",\"app_version\":\"1.0.0\",\"command\":\"cmd\",\"exit_code\":0,\"payload\":null,\"output\":null,\"dry_run\":false,\"writes\":null,\"preview\":[],\"preview_error\":null,\"diagnostics\":[{\"level\":\"info\",\"message\":\"starting\"},{\"level\":\"warn\",\"message\":\"careful\"},{\"level\":\"debug\",\"message\":\"detail\"},{\"level\":\"error\",\"message\":\"bad\"}]}\n",
      "stderr_equals": ""
    }
  },
  {
    "name": "envelope: quiet plus machine emits the complete envelope",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "cmd",
          "help": "a command",
          "effect": "read_only",
          "handler_diagnostics": [
            {
              "level": "info",
              "message": "starting"
            },
            {
              "level": "warn",
              "message": "careful"
            },
            {
              "level": "debug",
              "message": "detail"
            },
            {
              "level": "error",
              "message": "bad"
            }
          ],
          "handler_returns": {
            "kind": "data",
