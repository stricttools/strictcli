      "stderr_equals": ""
    }
  },
  {
    "name": "envelope: a group's subcommand carries the dotted command path",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [],
      "groups": [
        {
          "name": "grp",
          "help": "a group",
          "commands": [
            {
              "name": "cmd",
              "help": "a command",
              "effect": "read_only"
            }
          ]
        }
      ]
    },
    "argv": [
      "--json",
      "grp",
      "cmd"
    ],
    "expect": {
      "exit_code": 0,
      "stdout_equals": "{\"interface_version\":3,\"app\":\"myapp\",\"app_version\":\"1.0.0\",\"command\":\"grp.cmd\",\"exit_code\":0,\"payload\":null,\"output\":null,\"dry_run\":false,\"writes\":null,\"preview\":[],\"preview_error\":null,\"diagnostics\":[]}\n",
      "stderr_equals": ""
    }
  },
  {
    "name": "envelope: an unknown command emits an envelope with a null command",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "cmd",
          "help": "a command",
          "effect": "read_only"
        }
      ]
    },
    "argv": [
      "--json",
      "nope"
    ],
    "expect": {
      "exit_code": 1,
      "stdout_equals": "{\"interface_version\":3,\"app\":\"myapp\",\"app_version\":\"1.0.0\",\"command\":null,\"exit_code\":1,\"payload\":null,\"output\":null,\"dry_run\":false,\"writes\":null,\"preview\":[],\"preview_error\":null,\"diagnostics\":[]}\n",
      "stderr_contains": "unknown command 'nope'"
    }
  },
  {
    "name": "envelope: a parse error after the machine flag emits an envelope",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "cmd",
          "help": "a command",
          "effect": "read_only"
        }
      ]
    },
    "argv": [
      "cmd",
      "--json",
      "--nope"
    ],
    "expect": {
      "exit_code": 1,
      "stdout_equals": "{\"interface_version\":3,\"app\":\"myapp\",\"app_version\":\"1.0.0\",\"command\":null,\"exit_code\":1,\"payload\":null,\"output\":null,\"dry_run\":false,\"writes\":null,\"preview\":[],\"preview_error\":null,\"diagnostics\":[]}\n",
      "stderr_contains": "unknown flag '--nope'"
    }
  },
  {
    "name": "envelope: a dry run in machine mode emits an envelope carrying the machine flag",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "cmd",
          "help": "a command",
          "effect": "read_only"
        }
      ]
    },
    "argv": [
      "--json",
      "--dry-run",
      "cmd"
    ],
    "expect": {
      "exit_code": 0,
      "stdout_equals": "{\"interface_version\":3,\"app\":\"myapp\",\"app_version\":\"1.0.0\",\"command\":\"cmd\",\"exit_code\":0,\"payload\":null,\"output\":null,\"dry_run\":true,\"writes\":null,\"preview\":[],\"preview_error\":null,\"diagnostics\":[]}\n",
      "stderr_equals": ""
    }
  },
  {
    "name": "envelope: a registration error precedes machine mode and emits no envelope",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "cmd",
          "help": "a command",
          "effect": "read_only",
          "flags": [
            {
              "name": "json",
              "type": "bool",
              "help": "should be rejected",
              "presence": "required"
            }
          ]
        }
      ]
    },
    "argv": [
      "--json",
      "cmd"
    ],
    "expect": {
      "exit_code": 1,
      "stdout_equals": "",
      "stderr_contains": "flag name 'json' is reserved by the framework: --json selects machine mode"
    }
  },
  {
    "name": "envelope: the --help flag under machine mode is refused, naming the help command, and the run owes its --json document",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "cmd",
          "help": "a command",
          "effect": "read_only"
        }
      ]
    },
    "argv": [
      "--json",
      "cmd",
      "--help"
    ],
    "expect": {
      "exit_code": 1,
      "stdout_equals": "{\"interface_version\":3,\"app\":\"myapp\",\"app_version\":\"1.0.0\",\"command\":null,\"exit_code\":1,\"payload\":null,\"output\":null,\"dry_run\":false,\"writes\":null,\"preview\":[],\"preview_error\":null,\"diagnostics\":[]}\n",
      "stderr_equals": "error: help pages are text; for the machine form use 'myapp help cmd --json'\ntry 'myapp --help'\n"
    }
  },
  {
    "name": "envelope: a dry run's preview records ride the envelope and agree with the effect log",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "build",
          "help": "build something",
          "effect": "mutating",
          "handler_effects": [
            {
              "method": "mkdir",
              "path": "build"
            },
            {
              "method": "write",
              "path": "VERSION",
              "content": "1.2.3"
            }
          ]
        }
      ]
    },
    "argv": [
      "--json",
      "--dry-run",
      "build"
    ],
    "expect": {
      "exit_code": 0,
      "stdout_equals": "{\"interface_version\":3,\"app\":\"myapp\",\"app_version\":\"1.0.0\",\"command\":\"build\",\"exit_code\":0,\"payload\":null,\"output\":null,\"dry_run\":true,\"writes\":null,\"preview\":[{\"detail\":\"build\",\"kind\":\"file_write\",\"recorded\":true,\"seq\":1,\"verb\":\"mkdir\"},{\"bytes\":5,\"detail\":\"VERSION (5 bytes)\",\"kind\":\"file_write\",\"recorded\":true,\"seq\":2,\"verb\":\"write\"}],\"preview_error\":null,\"diagnostics\":[]}\n",
      "stderr_equals": "",
      "effects_equals": [
        {
          "seq": 1,
          "kind": "file_write",
          "verb": "mkdir",
          "detail": "build",
          "recorded": true
        },
        {
          "seq": 2,
          "kind": "file_write",
          "verb": "write",
          "detail": "VERSION (5 bytes)",
          "bytes": 5,
          "recorded": true
        }
      ]
    }
  },
  {
    "name": "envelope: a live run's preview records ride the envelope and agree with the effect log",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "clean",
          "help": "remove a path that is not there",
          "effect": "mutating",
          "handler_effects": [
            {
              "method": "remove",
              "path": "no-such-path-envelope-conformance"
            }
          ]
        }
      ]
    },
    "argv": [
      "--json",
      "clean"
    ],
    "expect": {
      "exit_code": 0,
      "stdout_equals": "{\"interface_version\":3,\"app\":\"myapp\",\"app_version\":\"1.0.0\",\"command\":\"clean\",\"exit_code\":0,\"payload\":null,\"output\":null,\"dry_run\":false,\"writes\":null,\"preview\":[{\"detail\":\"no-such-path-envelope-conformance\",\"kind\":\"file_write\",\"recorded\":false,\"seq\":1,\"verb\":\"remove\"}],\"preview_error\":null,\"diagnostics\":[]}\n",
      "stderr_equals": "",
      "effects_equals": [
        {
          "seq": 1,
          "kind": "file_write",
          "verb": "remove",
          "detail": "no-such-path-envelope-conformance",
          "recorded": false
        }
      ]
    }
  },
  {
    "name": "envelope: a truncated preview carries preview_error and no stderr text",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "chain",
          "help": "branch on an unsettled result",
          "effect": "mutating",
          "handler_effects": [
            {
              "method": "run",
              "argv": [
                "git",
                "tag",
                "v1.2.3"
              ]
            },
            {
              "method": "run",
              "argv": [
                "git",
                "push",
                "origin",
                "v1.2.3"
              ]
            },
            {
              "method": "run",
              "argv": [
                "never",
                "reached"
              ],
              "extract_from": 2
            },
            {
              "method": "mkdir",
              "path": "unreachable"
            }
          ]
        }
      ]
    },
    "argv": [
      "--json",
      "--dry-run",
      "chain"
    ],
    "expect": {
      "exit_code": 1,
      "stdout_equals": "{\"interface_version\":3,\"app\":\"myapp\",\"app_version\":\"1.0.0\",\"command\":\"chain\",\"exit_code\":1,\"payload\":null,\"output\":null,\"dry_run\":true,\"writes\":null,\"preview\":[{\"detail\":\"git tag v1.2.3\",\"kind\":\"proc_mutate\",\"recorded\":true,\"seq\":1,\"verb\":\"run\"},{\"detail\":\"git push origin v1.2.3\",\"kind\":\"proc_mutate\",\"recorded\":true,\"seq\":2,\"verb\":\"run\"}],\"preview_error\":{\"kind\":\"truncated\",\"step\":3,\"command\":\"chain\",\"brand\":\"«step 2 output»\",\"message\":\"error: dry-run preview ends at step 3: chain branched on unsettled value «step 2 output» — cannot preview past this point\"},\"diagnostics\":[]}\n",
      "stderr_equals": ""
    }
  },
  {
    "name": "envelope: an aborted dispatch carries preview_error kind aborted (go)",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "build",
          "help": "build something",
          "effect": "mutating",
          "handler_effects": [
            {
              "method": "mkdir",
              "path": "build"
            },
            {
              "method": "write",
              "path": "VERSION",
              "content": "1.2.3"
            }
          ],
          "handler_aborts": true
        }
      ]
    },
    "argv": [
      "--json",
      "--dry-run",
      "build"
    ],
    "expect": {
      "exit_code": 2,
      "stdout_equals": "{\"interface_version\":3,\"app\":\"myapp\",\"app_version\":\"1.0.0\",\"command\":\"build\",\"exit_code\":2,\"payload\":null,\"output\":null,\"dry_run\":true,\"writes\":null,\"preview\":[{\"detail\":\"build\",\"kind\":\"file_write\",\"recorded\":true,\"seq\":1,\"verb\":\"mkdir\"},{\"bytes\":5,\"detail\":\"VERSION (5 bytes)\",\"kind\":\"file_write\",\"recorded\":true,\"seq\":2,\"verb\":\"write\"}],\"preview_error\":{\"kind\":\"aborted\",\"step\":3,\"command\":\"build\",\"brand\":null,\"message\":\"error: dry-run preview ends at step 3: build aborted — the preview above may be incomplete\"},\"diagnostics\":[]}\n",
      "stderr_not_contains": "dry-run preview ends at step 3"
    }
  }
]
