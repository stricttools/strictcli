[
  {
    "name": "mcp_confirmation: an unconsented consequential call asks, and the answer lets it run",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "release",
          "help": "a consequential command",
          "effect": "mutating",
          "consequential": true,
          "handler_returns": {
            "kind": "data",
            "data": {
              "released": true
            }
          }
        },
        {
          "name": "look",
          "help": "a read-only command",
          "effect": "read_only",
          "handler_returns": {
            "kind": "data",
            "data": {
              "looked": true
            }
          }
        }
      ]
    },
    "argv": [
      "--mcp"
    ],
    "protocol_script": [
      {
        "send": "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/call\",\"params\":{\"_meta\":{\"io.modelcontextprotocol/protocolVersion\":\"2026-07-28\",\"io.modelcontextprotocol/clientCapabilities\":{\"elicitation\":{\"form\":{}}},\"io.modelcontextprotocol/clientInfo\":{\"name\":\"cli\",\"version\":\"1.0.0\"}},\"name\":\"release\",\"arguments\":{}}}",
        "capture": {
          "state": "result.requestState"
        },
        "expect_line": {
          "json_equals": {
            "jsonrpc": "2.0",
            "id": 1,
            "result": {
              "resultType": "input_required",
              "inputRequests": {
                "consequential-confirmation": {
                  "method": "elicitation/create",
                  "params": {
                    "mode": "form",
                    "message": "about to run consequential command 'release'. Proceed?",
                    "requestedSchema": {
                      "type": "object",
                      "properties": {
                        "proceed": {
                          "type": "boolean",
                          "title": "Proceed",
                          "description": "Whether to run the consequential command."
                        }
                      },
                      "required": [
                        "proceed"
                      ]
                    }
                  }
                }
              },
              "requestState": "$ANY",
              "_meta": {
                "io.modelcontextprotocol/serverInfo": {
                  "name": "myapp",
                  "version": "1.0.0"
                }
              }
            }
          }
        }
      },
      {
        "send": "{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"tools/call\",\"params\":{\"_meta\":{\"io.modelcontextprotocol/protocolVersion\":\"2026-07-28\",\"io.modelcontextprotocol/clientCapabilities\":{\"elicitation\":{\"form\":{}}},\"io.modelcontextprotocol/clientInfo\":{\"name\":\"cli\",\"version\":\"1.0.0\"}},\"name\":\"release\",\"arguments\":{},\"requestState\":\"{{state}}\",\"inputResponses\":{\"consequential-confirmation\":{\"action\":\"accept\",\"content\":{\"proceed\":true}}}}}",
        "expect_line": {
          "json_equals": {
            "jsonrpc": "2.0",
            "id": 2,
            "result": {
              "resultType": "complete",
              "content": [
                {
                  "type": "text",
                  "text": "$ANY"
                }
              ],
              "_meta": {
                "io.modelcontextprotocol/serverInfo": {
                  "name": "myapp",
                  "version": "1.0.0"
                }
              }
            }
          }
        }
      },
      {
        "send": "{\"jsonrpc\":\"2.0\",\"id\":3,\"method\":\"tools/call\",\"params\":{\"_meta\":{\"io.modelcontextprotocol/protocolVersion\":\"2026-07-28\",\"io.modelcontextprotocol/clientCapabilities\":{\"elicitation\":{\"form\":{}}},\"io.modelcontextprotocol/clientInfo\":{\"name\":\"cli\",\"version\":\"1.0.0\"}},\"name\":\"look\",\"arguments\":{}}}",
        "expect_line": {
          "json_equals": {
            "jsonrpc": "2.0",
            "id": 3,
            "result": {
              "resultType": "complete",
              "content": [
                {
                  "type": "text",
                  "text": "$ANY"
                }
              ],
              "_meta": {
                "io.modelcontextprotocol/serverInfo": {
                  "name": "myapp",
                  "version": "1.0.0"
                }
              }
            }
          }
        }
      }
    ],
    "expect": {
      "exit_code": 0,
      "stderr_equals": "",
      "stdout_contains": [
        "released"
      ]
    }
  },
