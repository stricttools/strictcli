  {
    "name": "mcp_confirmation: a continuation is single-use, and does not travel to another request or client",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "release",
          "help": "a consequential command",
          "effect": "mutating",
          "consequential": true,
          "handler_returns": {
            "kind": "data",
            "data": {
              "released": true
            }
          }
        }
      ]
    },
    "argv": [
      "--mcp"
    ],
    "protocol_script": [
      {
        "send": "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/call\",\"params\":{\"_meta\":{\"io.modelcontextprotocol/protocolVersion\":\"2026-07-28\",\"io.modelcontextprotocol/clientCapabilities\":{\"elicitation\":{}},\"io.modelcontextprotocol/clientInfo\":{\"name\":\"cli\",\"version\":\"1.0.0\"}},\"name\":\"release\",\"arguments\":{}}}",
        "capture": {
          "state": "result.requestState"
        }
      },
      {
        "send": "{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"tools/call\",\"params\":{\"_meta\":{\"io.modelcontextprotocol/protocolVersion\":\"2026-07-28\",\"io.modelcontextprotocol/clientCapabilities\":{\"elicitation\":{}},\"io.modelcontextprotocol/clientInfo\":{\"name\":\"someone-else\",\"version\":\"1.0.0\"}},\"name\":\"release\",\"arguments\":{},\"requestState\":\"{{state}}\",\"inputResponses\":{\"consequential-confirmation\":{\"action\":\"accept\",\"content\":{\"proceed\":true}}}}}",
        "expect_line": {
          "json_equals": {
            "jsonrpc": "2.0",
            "id": 2,
            "error": {
              "code": -32602,
              "message": "requestState was issued to a different client"
            }
          }
        }
      },
      {
        "send": "{\"jsonrpc\":\"2.0\",\"id\":3,\"method\":\"tools/call\",\"params\":{\"_meta\":{\"io.modelcontextprotocol/protocolVersion\":\"2026-07-28\",\"io.modelcontextprotocol/clientCapabilities\":{\"elicitation\":{}},\"io.modelcontextprotocol/clientInfo\":{\"name\":\"cli\",\"version\":\"1.0.0\"}},\"name\":\"release\",\"arguments\":{\"unexpected\":1},\"requestState\":\"{{state}}\",\"inputResponses\":{\"consequential-confirmation\":{\"action\":\"accept\",\"content\":{\"proceed\":true}}}}}",
        "expect_line": {
          "json_equals": {
            "jsonrpc": "2.0",
            "id": 3,
            "error": {
              "code": -32602,
              "message": "requestState does not match this request"
            }
          }
        }
      },
      {
        "send": "{\"jsonrpc\":\"2.0\",\"id\":4,\"method\":\"tools/call\",\"params\":{\"_meta\":{\"io.modelcontextprotocol/protocolVersion\":\"2026-07-28\",\"io.modelcontextprotocol/clientCapabilities\":{\"elicitation\":{}},\"io.modelcontextprotocol/clientInfo\":{\"name\":\"cli\",\"version\":\"1.0.0\"}},\"name\":\"release\",\"arguments\":{},\"requestState\":\"{{state}}\",\"inputResponses\":{\"consequential-confirmation\":{\"action\":\"accept\",\"content\":{\"proceed\":true}}}}}",
        "expect_line": {
          "json_equals": {
            "jsonrpc": "2.0",
            "id": 4,
            "result": {
              "resultType": "complete",
              "content": [
                {
                  "type": "text",
                  "text": "$ANY"
                }
              ],
              "_meta": {
                "io.modelcontextprotocol/serverInfo": {
                  "name": "myapp",
                  "version": "1.0.0"
                }
              }
            }
          }
        }
      },
      {
        "send": "{\"jsonrpc\":\"2.0\",\"id\":5,\"method\":\"tools/call\",\"params\":{\"_meta\":{\"io.modelcontextprotocol/protocolVersion\":\"2026-07-28\",\"io.modelcontextprotocol/clientCapabilities\":{\"elicitation\":{}},\"io.modelcontextprotocol/clientInfo\":{\"name\":\"cli\",\"version\":\"1.0.0\"}},\"name\":\"release\",\"arguments\":{},\"requestState\":\"{{state}}\",\"inputResponses\":{\"consequential-confirmation\":{\"action\":\"accept\",\"content\":{\"proceed\":true}}}}}",
        "expect_line": {
          "json_equals": {
            "jsonrpc": "2.0",
            "id": 5,
            "error": {
              "code": -32602,
              "message": "requestState has already been used"
            }
          }
        }
      }
    ],
    "expect": {
      "exit_code": 0,
      "stderr_equals": ""
    }
