  {
    "name": "mcp_confirmation: a client that did not declare elicitation is told what it must declare",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "release",
          "help": "a consequential command",
          "effect": "mutating",
          "consequential": true,
          "handler_returns": {
            "kind": "data",
            "data": {
              "released": true
            }
          }
        }
      ]
    },
    "argv": [
      "--mcp"
    ],
    "protocol_script": [
      {
        "send": "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/call\",\"params\":{\"_meta\":{\"io.modelcontextprotocol/protocolVersion\":\"2026-07-28\",\"io.modelcontextprotocol/clientCapabilities\":{}},\"name\":\"release\",\"arguments\":{}}}",
        "expect_line": {
          "json_equals": {
            "jsonrpc": "2.0",
            "id": 1,
            "error": {
              "code": -32021,
              "message": "Server requires the elicitation capability for this request",
              "data": {
                "requiredCapabilities": {
                  "elicitation": {
                    "form": {}
                  }
                }
              }
            }
          }
        }
      },
      {
        "send": "{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"tools/call\",\"params\":{\"_meta\":{\"io.modelcontextprotocol/protocolVersion\":\"2026-07-28\",\"io.modelcontextprotocol/clientCapabilities\":{\"elicitation\":{\"url\":{}}}},\"name\":\"release\",\"arguments\":{}}}",
        "expect_line": {
          "json_equals": {
            "jsonrpc": "2.0",
            "id": 2,
            "error": {
              "code": -32021,
              "message": "Server requires the elicitation capability for this request",
              "data": {
                "requiredCapabilities": {
                  "elicitation": {
                    "form": {}
                  }
                }
              }
            }
          }
        }
      }
    ],
    "expect": {
      "exit_code": 0,
      "stderr_equals": "",
      "stdout_not_contains": [
        "released"
      ]
    }
  },
  {
    "name": "mcp_confirmation: an answer without the state it was issued with is not an answer",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "release",
          "help": "a consequential command",
          "effect": "mutating",
          "consequential": true,
          "handler_returns": {
            "kind": "data",
            "data": {
              "released": true
            }
          }
        }
      ]
    },
    "argv": [
      "--mcp"
    ],
    "protocol_script": [
      {
        "send": "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/call\",\"params\":{\"_meta\":{\"io.modelcontextprotocol/protocolVersion\":\"2026-07-28\",\"io.modelcontextprotocol/clientCapabilities\":{\"elicitation\":{}}},\"name\":\"release\",\"arguments\":{},\"inputResponses\":{\"consequential-confirmation\":{\"action\":\"accept\",\"content\":{\"proceed\":true}}}}}",
        "expect_line": {
          "json_equals": {
            "jsonrpc": "2.0",
            "id": 1,
            "error": {
              "code": -32602,
              "message": "parameter 'inputResponses' requires the requestState it was issued with"
            }
          }
        }
      }
    ],
    "expect": {
      "exit_code": 0,
      "stderr_equals": "",
      "stdout_not_contains": [
        "released"
      ]
    }
