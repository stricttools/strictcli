[
  {
    "name": "presence registration: a flag declaring nothing does not register (go)",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "cmd",
          "help": "a command",
          "effect": "read_only",
          "flags": [
            {
              "name": "level",
              "help": "the level"
            }
          ],
          "handler_prints": "level={level}"
        }
      ]
    },
    "argv": [
      "cmd"
    ],
    "expect": {
      "exit_code": 1,
      "stderr_equals": "error: Flag \"level\": presence is undeclared: declare exactly one of Required(), Optional(), or Default(<value>)"
    },
    "skip_schema_validation": true
  },
  {
    "name": "presence registration: an arg declaring nothing does not register (go)",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "cmd",
          "help": "a command",
          "effect": "read_only",
          "args": [
            {
              "name": "file",
              "help": "the file"
            }
          ],
          "handler_prints": "file={file}"
        }
      ]
    },
    "argv": [
      "cmd",
      "x"
    ],
    "expect": {
      "exit_code": 1,
      "stderr_equals": "error: Arg \"file\": presence is undeclared: declare exactly one of ArgRequired(), ArgOptional(), or ArgDefault(<value>)"
    },
    "skip_schema_validation": true
  },
  {
    "name": "presence registration: a flag declaring two facts does not register (go)",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "cmd",
          "help": "a command",
          "effect": "read_only",
          "flags": [
            {
              "name": "level",
              "help": "the level",
              "presence": "required",
              "default": "info"
            }
          ],
          "handler_prints": "level={level}"
        }
      ]
    },
    "argv": [
      "cmd"
    ],
    "expect": {
      "exit_code": 1,
      "stderr_equals": "error: Flag \"level\": presence is declared twice: Required() and Default(info) cannot be combined; declare exactly one"
    },
    "skip_schema_validation": true
  },
  {
    "name": "presence registration: an arg declaring two facts does not register (go)",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "cmd",
          "help": "a command",
          "effect": "read_only",
          "args": [
            {
              "name": "file",
              "help": "the file",
              "presence": "optional",
              "default": "out.txt"
            }
          ],
          "handler_prints": "file={file}"
        }
      ]
    },
    "argv": [
      "cmd"
    ],
    "expect": {
      "exit_code": 1,
      "stderr_equals": "error: Arg \"file\": presence is declared twice: ArgOptional() and ArgDefault(out.txt) cannot be combined; declare exactly one"
    },
    "skip_schema_validation": true
  },
  {
    "name": "presence registration: a null-valued flag default redirects to optional (go)",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "cmd",
          "help": "a command",
          "effect": "read_only",
          "flags": [
            {
              "name": "level",
              "help": "the level",
              "default": null
            }
          ],
          "handler_prints": "level={level}"
        }
      ]
    },
    "argv": [
      "cmd"
    ],
    "expect": {
      "exit_code": 1,
      "stderr_equals": "error: Flag \"level\": Default(nil) does not declare optionality: use Optional() (it delivers nil when the flag is absent)"
    },
    "skip_schema_validation": true
  },
  {
    "name": "presence registration: a null-valued arg default redirects to optional (go)",
