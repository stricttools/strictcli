[
  {
    "name": "selector mcp: the scoped-parameter block is appended to the tool description",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "send",
          "help": "send one notification through exactly one channel",
          "effect": "read_only",
          "handler_returns": {
            "kind": "data",
            "data": {
              "ok": true
            }
          },
          "flags": [
            {
              "name": "via",
              "help": "delivery channel",
              "presence": "required",
              "elect_by": "selector-token",
              "choices": [
                {
                  "name": "email",
                  "help": "deliver the notification as an email message",
                  "flags": [
                    {
                      "name": "subject",
                      "help": "subject line of the message",
                      "type": "str",
                      "presence": "required"
                    },
                    {
                      "name": "recipient",
                      "help": "destination email address",
                      "type": "str",
                      "presence": "required"
                    }
                  ]
                },
                {
                  "name": "user-facing",
                  "help": "post the notification to a URL",
                  "flags": [
                    {
                      "name": "url",
                      "help": "where to post",
                      "type": "str",
                      "presence": "required"
                    },
                    {
                      "name": "retries",
                      "help": "delivery attempts before giving up",
                      "type": "int",
                      "presence": "default",
                      "default": 3
                    }
                  ]
                }
              ]
            },
            {
              "name": "target",
              "help": "which profiles to operate on",
              "presence": "required",
              "elect_by": "member-flags",
              "choices": [
                {
                  "name": "profile",
                  "help": "operate on one named profile",
                  "value": {
                    "type": "str",
                    "help": "profile name"
                  }
                },
                {
                  "name": "all-profiles",
                  "help": "operate on every profile"
                }
              ]
            },
            {
              "name": "labels",
              "help": "labels to attach",
              "type": "str",
              "presence": "optional",
              "repeatable": true,
              "unique": false,
              "choices_str": [
                {
                  "value": "a",
                  "help": "the a label"
                },
                {
                  "value": "b"
                }
              ]
            }
          ]
        }
      ]
    },
    "argv": [
      "--mcp"
    ],
    "protocol_script": [
      {
        "send": "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/list\",\"params\":{\"_meta\":{\"io.modelcontextprotocol/protocolVersion\":\"2026-07-28\",\"io.modelcontextprotocol/clientCapabilities\":{}}}}",
        "expect_line": {
          "contains": "send one notification through exactly one channel\\n\\nScoped parameters (enforced at call time):\\n  via=email: subject (required), recipient (required)\\n  via=user-facing: url (required), retries (default: 3)\\n  target=profile: profile (required)\\n  target=all-profiles: (no parameters)"
        }
      }
    ],
    "expect": {
      "exit_code": 0,
      "stderr_equals": ""
    }
  },
