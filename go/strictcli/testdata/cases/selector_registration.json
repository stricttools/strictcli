[
  {
    "name": "selector registration: a choice flag cannot declare optional (go)",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "cmd",
          "help": "a command",
          "effect": "read_only",
          "handler_prints": "ok",
          "flags": [
            {
              "name": "via",
              "help": "delivery channel",
              "presence": "optional",
              "elect_by": "selector-token",
              "choices": [
                {
                  "name": "email",
                  "help": "deliver as an email message"
                },
                {
                  "name": "sms",
                  "help": "deliver as a text message"
                }
              ]
            }
          ]
        }
      ]
    },
    "argv": [
      "cmd"
    ],
    "skip_schema_validation": true,
    "expect": {
      "exit_code": 1,
      "stderr_equals": "error: Flag \"via\": a choice flag cannot declare Optional(): an absent selection is a choice nobody named, so name it as a choice of its own"
    }
  },
