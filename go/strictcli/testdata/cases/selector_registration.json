  {
    "name": "selector registration: an AllOrNone member naming a scoped flag is refused",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "cmd",
          "help": "a command",
          "effect": "read_only",
          "handler_prints": "ok",
          "flags": [
            {
              "name": "other",
              "help": "a command-level flag",
              "type": "bool",
              "presence": "default",
              "default": false
            },
            {
              "name": "via",
              "help": "delivery channel",
              "presence": "required",
              "elect_by": "selector-token",
              "choices": [
                {
                  "name": "email",
                  "help": "deliver as an email message",
                  "flags": [
                    {
                      "name": "subject",
                      "help": "subject line",
                      "type": "str",
                      "presence": "required"
                    }
                  ]
                },
                {
                  "name": "sms",
                  "help": "deliver as a text message"
                }
              ]
            }
          ],
          "constraints": [
            {
              "type": "all_or_none",
              "name": "subject-other",
              "members": [
                {
                  "name": "subject"
                },
                {
                  "name": "other",
                  "when": "true"
                }
              ]
            }
          ]
        }
      ]
    },
    "argv": [
      "cmd"
    ],
    "expect": {
      "exit_code": 1,
      "stderr_equals": "error: command \"cmd\": constraint \"subject-other\" references 'subject', which is declared under '--via email': constraints operate at root scope only"
    }
  },
