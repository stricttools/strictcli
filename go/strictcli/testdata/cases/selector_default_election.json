[
  {
    "name": "default election: the command line reports a selection nobody elected as the declaration's",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "send",
          "help": "send one notification through exactly one channel",
          "effect": "read_only",
          "handler_prints": "via={via} src={source:via} prov={provided:via}",
          "flags": [
            {
              "name": "via",
              "help": "delivery channel",
              "presence": "default",
              "default": {
                "choice": "email"
              },
              "elect_by": "selector-token",
              "choices": [
                {
                  "name": "email",
                  "help": "deliver the notification as an email message",
                  "flags": [
                    {
                      "name": "subject",
                      "help": "subject line of the message",
                      "type": "str",
                      "presence": "default",
                      "default": "hi"
                    }
                  ]
                },
                {
                  "name": "sms",
                  "help": "deliver the notification as a text message",
                  "flags": [
                    {
                      "name": "phone-number",
                      "help": "destination number",
                      "type": "str",
                      "presence": "optional"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "name": "noop",
          "help": "a command the case argv can run without output",
          "effect": "read_only",
          "handler_returns": {
            "kind": "exit",
            "code": 0
          }
        }
      ]
    },
    "argv": [
      "send"
    ],
    "expect": {
      "exit_code": 0,
      "stdout_equals": "via=email(subject=hi) src=default prov=false\n",
      "stderr_equals": ""
    }
  },
