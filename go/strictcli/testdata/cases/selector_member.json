  {
    "name": "selector member: both elected is mutually exclusive",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "cmd",
          "help": "a command",
          "effect": "read_only",
          "flags": [
            {
              "name": "mode",
              "help": "how loud to be",
              "presence": "required",
              "elect_by": "member-flags",
              "choices": [
                {
                  "name": "chatter",
                  "help": "chatter output"
                },
                {
                  "name": "muted",
                  "help": "muted output"
                }
              ]
            }
          ],
          "handler_prints": "ok"
        }
      ]
    },
    "argv": [
      "cmd",
      "--chatter",
      "--muted"
