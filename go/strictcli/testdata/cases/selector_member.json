  {
    "name": "selector member: help renders the selector's own line and its members beneath it",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "cmd",
          "help": "a command",
          "effect": "read_only",
          "flags": [
            {
              "name": "name",
              "type": "str",
              "help": "your name",
              "presence": "default",
              "default": "anon"
            },
            {
              "name": "mode",
              "help": "how loud to be",
              "presence": "required",
              "elect_by": "member-flags",
              "choices": [
                {
                  "name": "chatter",
                  "help": "chatter output"
                },
                {
                  "name": "muted",
                  "help": "muted output"
                }
              ]
            }
          ],
          "handler_prints": "ok"
        }
      ]
    },
    "argv": [
      "cmd",
      "--help"
    ],
    "expect": {
      "exit_code": 0,
      "stdout_contains": [
        "(exactly one of the following)",
        "--chatter",
        "--muted",
        "--name"
      ],
      "stdout_equals": "myapp cmd -- a command\n\nFlags:\n  --name <str>    your name [default: anon]\n  mode            how loud to be (exactly one of the following) [required]\n    --chatter     chatter output [required]\n    --muted       muted output [required]"
    }
  },
  {
    "name": "selector member A1: a negated bool member elects nothing",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "run",
          "help": "run it",
          "effect": "read_only",
          "flags": [
            {
              "name": "target",
              "help": "which profiles to operate on",
              "presence": "required",
              "elect_by": "member-flags",
              "choices": [
                {
                  "name": "profile",
                  "help": "a profile",
                  "value": {
                    "type": "str",
                    "help": "a profile"
                  }
                },
                {
                  "name": "all-profiles",
                  "help": "every profile"
                },
                {
                  "name": "current-profile",
                  "help": "the current profile"
                }
              ]
            }
          ],
          "handler_prints": "target={target}"
        }
      ]
    },
    "argv": [
      "run",
      "--no-all-profiles"
    ],
    "expect": {
      "exit_code": 1,
      "stderr_contains": [
        "is required",
        "declines an option"
      ],
      "stderr_equals": "error: one of --profile, --all-profiles, --current-profile is required (--no-all-profiles declines an option; it does not choose one)\ntry 'myapp run --help'"
    }
  },
