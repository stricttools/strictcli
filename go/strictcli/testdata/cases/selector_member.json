[
  {
    "name": "selector member: neither elected is an error",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "cmd",
          "help": "a command",
          "effect": "read_only",
          "flags": [
            {
              "name": "mode",
              "help": "how loud to be",
              "presence": "required",
              "elect_by": "member-flags",
              "choices": [
                {
                  "name": "chatter",
                  "help": "chatter output"
                },
                {
                  "name": "muted",
                  "help": "muted output"
                }
              ]
            }
          ],
          "handler_prints": "mode={mode}"
        }
      ]
    },
    "argv": [
      "cmd"
    ],
    "expect": {
      "exit_code": 1,
      "stderr_contains": [
        "one of",
        "is required"
      ],
      "stderr_equals": "error: one of --chatter, --muted is required\ntry 'myapp cmd --help'"
    }
  },
