          "flags": [
            {
              "name": "source",
              "help": "where to read from",
              "presence": "required",
              "elect_by": "member-flags",
              "choices": [
                {
                  "name": "file",
                  "help": "read from file",
                  "value": {
                    "type": "str",
                    "help": "read from file"
                  }
                },
                {
                  "name": "url",
                  "help": "read from URL",
                  "value": {
                    "type": "str",
                    "help": "read from URL"
                  }
                }
              ]
            }
          ],
          "handler_prints": "source={source}"
        }
