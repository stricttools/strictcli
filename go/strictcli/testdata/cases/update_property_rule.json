[
  {
    "name": "update rule: every property absent is a hard error naming all of them",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "update-record",
          "help": "change one DNS record in place",
          "effect": "mutating",
          "update_of": {
            "resource": "dns-record",
            "write_mode": "sparse",
            "identity": [
              "zone"
            ],
            "properties": [
              "content",
              "ttl",
              "proxied"
            ]
          },
          "flags": [
            {
              "name": "zone",
              "help": "the zone",
              "presence": "required",
              "type": "str"
            },
            {
              "name": "content",
              "help": "record content",
              "presence": "optional",
              "type": "str"
            },
            {
              "name": "ttl",
              "help": "time to live in seconds",
              "presence": "optional",
              "type": "int"
            },
            {
              "name": "proxied",
              "help": "whether the record is proxied",
              "presence": "optional",
              "type": "bool"
            }
          ],
          "handler_prints": "content={content} ttl={ttl} proxied={proxied} provided_content={provided:content} provided_proxied={provided:proxied}"
        }
      ]
    },
    "argv": [
      "update-record",
      "--zone",
      "z1"
    ],
    "expect": {
      "exit_code": 1,
      "stdout_equals": "",
      "stderr_equals": "error: update \"dns-record\": at least one property is required: --content, --ttl, --proxied\ntry 'myapp update-record --help'\n"
    }
  },
