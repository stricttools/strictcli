  {
    "name": "update rule: an implied property is a provision, the injection being caused by the invocation",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "update-record",
          "help": "change one DNS record in place",
          "effect": "mutating",
          "update_of": {
            "resource": "dns-record",
            "write_mode": "sparse",
            "identity": [
              "zone"
            ],
            "properties": [
              "content",
              "proxied"
            ]
          },
          "flags": [
            {
              "name": "zone",
              "help": "the zone",
              "presence": "required",
              "type": "str"
            },
            {
              "name": "trigger",
              "help": "the trigger",
              "presence": "optional",
              "type": "bool"
            },
            {
              "name": "content",
              "help": "record content",
              "presence": "optional",
              "type": "str"
            },
            {
              "name": "proxied",
              "help": "whether the record is proxied",
              "presence": "optional",
              "type": "bool"
            }
          ],
          "handler_prints": "proxied={proxied} source={source:proxied} provided={provided:proxied}",
          "constraints": [
            {
              "type": "implies",
              "name": "trigger-writes-proxied",
              "flag": "trigger",
              "implies": "proxied",
              "value": true
            }
          ]
        }
      ]
    },
    "argv": [
      "update-record",
      "--zone",
      "z1",
      "--trigger"
    ],
    "expect": {
      "exit_code": 0,
      "stdout_equals": "proxied=true source=implied provided=true\n",
      "stderr_equals": ""
    }
  },
  {
    "name": "update rule: it runs AFTER every declared constraint, so a command with both faults reports the constraint",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "update-record",
          "help": "change one DNS record in place",
          "effect": "mutating",
          "update_of": {
            "resource": "dns-record",
            "write_mode": "sparse",
            "identity": [
              "zone"
            ],
            "properties": [
              "content",
              "ttl",
              "proxied"
            ]
          },
          "flags": [
            {
              "name": "zone",
              "help": "the zone",
              "presence": "required",
              "type": "str"
            },
            {
              "name": "content",
              "help": "record content",
              "presence": "optional",
              "type": "str"
            },
            {
              "name": "ttl",
              "help": "time to live in seconds",
              "presence": "optional",
              "type": "int"
            },
            {
              "name": "proxied",
              "help": "whether the record is proxied",
              "presence": "optional",
              "type": "bool"
            },
            {
              "name": "trace-id",
              "help": "a trace identifier",
              "presence": "optional",
              "type": "str"
            },
            {
              "name": "sampled",
              "help": "whether this run is sampled",
              "presence": "optional",
              "type": "bool"
            }
          ],
          "handler_prints": "content={content} ttl={ttl} proxied={proxied} provided_content={provided:content} provided_proxied={provided:proxied}",
          "constraints": [
            {
              "type": "all_or_none",
              "name": "tracing-pair",
              "members": [
                {
                  "name": "trace-id"
                },
                {
                  "name": "sampled",
                  "when": "present"
                }
              ]
            }
          ]
        }
      ]
    },
    "argv": [
      "update-record",
      "--zone",
      "z1",
      "--trace-id",
      "t1"
    ],
    "expect": {
      "exit_code": 1,
      "stdout_equals": "",
      "stderr_equals": "error: constraint \"tracing-pair\": --trace-id, --sampled must be used together\ntry 'myapp update-record --help'\n"
    }
  },
