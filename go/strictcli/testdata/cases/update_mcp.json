[
  {
    "name": "update mcp: the description block, the anyOf branches and the nullable type list",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "update-record",
          "help": "change one DNS record in place",
          "effect": "mutating",
          "update_of": {
            "resource": "dns-record",
            "write_mode": "sparse",
            "identity": [
              "zone",
              "record-id"
            ],
            "properties": [
              "content",
              "ttl",
              "proxied"
            ]
          },
          "flags": [
            {
              "name": "zone",
              "help": "zone the record belongs to",
              "presence": "required",
              "type": "str"
            },
            {
              "name": "record-id",
              "help": "identifier of the record to change",
              "presence": "required",
              "type": "str"
            },
            {
              "name": "content",
              "help": "record content",
              "presence": "optional",
              "type": "str"
            },
            {
              "name": "ttl",
              "help": "time to live in seconds",
              "presence": "optional",
              "type": "int",
              "nullable": true
            },
            {
              "name": "proxied",
              "help": "whether the record is proxied",
              "presence": "optional",
              "type": "bool"
            }
          ],
          "handler_prints": "ok"
        }
      ]
    },
    "argv": [
      "--mcp"
    ],
    "protocol_script": [
      {
        "send": "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/list\",\"params\":{\"_meta\":{\"io.modelcontextprotocol/protocolVersion\":\"2026-07-28\",\"io.modelcontextprotocol/clientCapabilities\":{}}}}",
        "expect_line": {
          "json_equals": {
            "jsonrpc": "2.0",
            "id": 1,
            "result": {
              "resultType": "complete",
              "tools": [
                {
                  "name": "update-record",
                  "description": "change one DNS record in place\n\nUpdate of \"dns-record\" (write mode: sparse):\n  identifies: zone, record_id\n  writes: content, ttl, proxied -- at least one is required\n  a property that is not supplied is left unchanged; null clears ttl",
                  "effect": "mutating",
                  "inputSchema": {
                    "type": "object",
                    "properties": {
                      "zone": {
                        "type": "string",
                        "description": "zone the record belongs to"
                      },
                      "record_id": {
                        "type": "string",
                        "description": "identifier of the record to change"
                      },
                      "content": {
                        "type": "string",
                        "description": "record content"
                      },
                      "ttl": {
                        "type": [
                          "integer",
                          "null"
                        ],
                        "description": "time to live in seconds"
                      },
                      "proxied": {
                        "type": "boolean",
                        "description": "whether the record is proxied"
                      }
                    },
                    "required": [
                      "zone",
                      "record_id"
                    ],
                    "anyOf": [
                      {
                        "required": [
                          "content"
                        ]
                      },
                      {
                        "required": [
                          "ttl"
                        ]
                      },
                      {
                        "required": [
                          "proxied"
                        ]
                      }
                    ],
                    "additionalProperties": false
                  }
                }
              ],
              "ttlMs": 3600000,
              "cacheScope": "public",
              "_meta": {
                "io.modelcontextprotocol/serverInfo": {
                  "name": "myapp",
                  "version": "1.0.0"
                }
              }
            }
          }
        }
      }
    ],
    "expect": {
      "exit_code": 0,
      "stderr_equals": ""
    }
  },
