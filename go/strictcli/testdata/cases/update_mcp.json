  {
    "name": "update mcp: with a constraint beside it, both anyOf rules are wrapped and the update's comes first",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "update-record",
          "help": "change one DNS record in place",
          "effect": "mutating",
          "update_of": {
            "resource": "dns-record",
            "write_mode": "sparse",
            "identity": [
              "by-name",
              "by-id"
            ],
            "properties": [
              "content",
              "ttl"
            ]
          },
          "flags": [
            {
              "name": "by-name",
              "help": "address it by name",
              "presence": "optional",
              "type": "str"
            },
            {
              "name": "by-id",
              "help": "address it by identifier",
              "presence": "optional",
              "type": "str"
            },
            {
              "name": "content",
              "help": "record content",
              "presence": "optional",
              "type": "str"
            },
            {
              "name": "ttl",
              "help": "time to live in seconds",
              "presence": "optional",
              "type": "int",
              "nullable": true
            }
          ],
          "constraints": [
            {
              "type": "at_least_one",
              "name": "addressing",
              "members": [
                {
                  "name": "by-name"
                },
                {
                  "name": "by-id"
                }
              ]
            }
          ],
          "handler_prints": "ok"
        }
      ]
    },
    "argv": [
      "--mcp"
    ],
    "protocol_script": [
      {
        "send": "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/list\",\"params\":{\"_meta\":{\"io.modelcontextprotocol/protocolVersion\":\"2026-07-28\",\"io.modelcontextprotocol/clientCapabilities\":{}}}}",
        "expect_line": {
          "json_equals": {
            "jsonrpc": "2.0",
            "id": 1,
            "result": {
              "resultType": "complete",
              "tools": [
                {
                  "name": "update-record",
                  "description": "change one DNS record in place\n\nConstraints (enforced at call time):\n  at least one of: by_name, by_id\n\nUpdate of \"dns-record\" (write mode: sparse):\n  identifies: by_name, by_id\n  writes: content, ttl -- at least one is required\n  a property that is not supplied is left unchanged; null clears ttl",
                  "effect": "mutating",
                  "inputSchema": {
                    "type": "object",
                    "properties": {
                      "by_name": {
                        "type": "string",
                        "description": "address it by name"
                      },
                      "by_id": {
                        "type": "string",
                        "description": "address it by identifier"
                      },
                      "content": {
                        "type": "string",
                        "description": "record content"
                      },
                      "ttl": {
                        "type": [
                          "integer",
                          "null"
                        ],
                        "description": "time to live in seconds"
                      }
                    },
                    "required": [],
                    "allOf": [
                      {
                        "anyOf": [
                          {
                            "required": [
                              "content"
                            ]
                          },
                          {
                            "required": [
                              "ttl"
                            ]
                          }
                        ]
                      },
                      {
                        "anyOf": [
                          {
                            "required": [
                              "by_name"
                            ]
                          },
                          {
                            "required": [
                              "by_id"
                            ]
                          }
                        ]
                      }
                    ],
                    "additionalProperties": false
                  }
                }
              ],
              "ttlMs": 3600000,
              "cacheScope": "public",
              "_meta": {
                "io.modelcontextprotocol/serverInfo": {
