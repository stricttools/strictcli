[
  {
    "name": "scoped marker: a RelativeToRoot default inside an elected scope resolves through the declared root",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "infra_root": {
        "MYAPP_HOME": "/opt/myhome"
      },
      "commands": [
        {
          "name": "send",
          "help": "send one notification through exactly one channel",
          "effect": "read_only",
          "handler_prints": "via={via} provided={provided:via.cfg}",
          "flags": [
            {
              "name": "via",
              "help": "delivery channel",
              "presence": "required",
              "elect_by": "selector-token",
              "choices": [
                {
                  "name": "email",
                  "help": "deliver the notification as an email message",
                  "flags": [
                    {
                      "name": "subject",
                      "help": "subject line of the message",
                      "type": "str",
                      "presence": "required"
                    },
                    {
                      "name": "cfg",
                      "help": "where the channel keeps its own configuration",
                      "type": "str",
                      "presence": "default",
                      "default_relative_to_root": {
                        "env_var": "MYAPP_HOME",
                        "parts": [
                          "cfg",
                          "x.toml"
                        ]
                      }
                    }
                  ]
                },
                {
                  "name": "sms",
                  "help": "deliver the notification as a text message",
                  "flags": [
                    {
                      "name": "phone-number",
                      "help": "destination number",
                      "type": "str",
                      "presence": "required"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "name": "noop",
          "help": "a command the case argv can run without output",
          "effect": "read_only",
          "handler_returns": {
            "kind": "exit",
            "code": 0
          }
        }
      ]
    },
    "argv": [
      "send",
      "--via",
      "email",
      "--subject",
      "hi"
    ],
    "expect": {
      "exit_code": 0,
      "stdout_equals": "via=email(subject=hi, cfg=/opt/myhome/cfg/x.toml) provided=false\n",
      "stderr_equals": ""
    }
  },
