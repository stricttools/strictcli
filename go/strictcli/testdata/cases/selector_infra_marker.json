              "elect_by": "selector-token",
              "choices": [
                {
                  "name": "email",
                  "help": "deliver the notification as an email message",
                  "flags": [
                    {
                      "name": "subject",
                      "help": "subject line of the message",
                      "type": "str",
                      "presence": "required"
                    },
                    {
                      "name": "cfg",
                      "help": "where the channel keeps its own configuration",
                      "type": "str",
                      "presence": "default",
                      "default_relative_to_root": {
                        "env_var": "NOPE_HOME",
                        "parts": [
                          "cfg",
                          "x.toml"
                        ]
                      }
                    }
                  ]
                },
                {
                  "name": "sms",
                  "help": "deliver the notification as a text message",
                  "flags": [
                    {
                      "name": "phone-number",
                      "help": "destination number",
                      "type": "str",
                      "presence": "required"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "name": "noop",
          "help": "a command the case argv can run without output",
          "effect": "read_only",
          "handler_returns": {
            "kind": "exit",
            "code": 0
          }
        }
      ]
    },
    "argv": [
      "send",
      "--via",
      "email",
      "--subject",
      "hi"
    ],
    "expect": {
      "exit_code": 1,
      "stdout_equals": "",
      "stderr_equals": "error: RelativeToRoot references undeclared infra root \"NOPE_HOME\"; declare it as an infra root under '--via email'\ntry 'myapp send --help'\n"
    }
