  {
    "name": "scoped marker: the flat machine door carries the elected-by-default clause",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "infra_root": {
        "MYAPP_HOME": "/opt/myhome"
      },
      "commands": [
        {
          "name": "send",
          "help": "send one notification through exactly one channel",
          "effect": "read_only",
          "handler_returns": {
            "kind": "data",
            "data": {
              "ok": true
            }
          },
          "flags": [
            {
              "name": "via",
              "help": "delivery channel",
              "presence": "default",
              "elect_by": "selector-token",
              "choices": [
                {
                  "name": "email",
                  "help": "deliver the notification as an email message",
                  "flags": [
                    {
                      "name": "subject",
                      "help": "subject line of the message",
                      "type": "str",
                      "presence": "default",
                      "default": "hi"
                    },
                    {
                      "name": "cfg",
                      "help": "where the channel keeps its own configuration",
                      "type": "str",
                      "presence": "default",
                      "default_relative_to_root": {
                        "env_var": "NOPE_HOME",
                        "parts": [
                          "cfg",
                          "x.toml"
                        ]
                      }
                    }
                  ]
                },
                {
                  "name": "sms",
                  "help": "deliver the notification as a text message",
                  "flags": [
                    {
                      "name": "phone-number",
                      "help": "destination number",
                      "type": "str",
                      "presence": "required"
                    }
                  ]
                }
              ],
              "default": {
                "choice": "email"
              }
            }
          ]
        }
      ]
    },
    "argv": [
      "--mcp"
    ],
    "protocol_script": [
      {
        "send": "{\"jsonrpc\": \"2.0\", \"id\": 1, \"method\": \"tools/call\", \"params\": {\"name\": \"send\", \"arguments\": {}, \"_meta\": {\"io.modelcontextprotocol/protocolVersion\": \"2026-07-28\", \"io.modelcontextprotocol/clientCapabilities\": {}}}}",
        "expect_line": {
          "contains": [
            "\"isError\"",
            "declare it as an infra root under '--via email' (elected by default)"
          ]
        }
      }
    ],
    "expect": {
      "exit_code": 0,
      "stderr_equals": ""
    }
  },
