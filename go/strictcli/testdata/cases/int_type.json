    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "cmd",
          "help": "a command",
          "effect": "read_only",
          "flags": [
            {
              "name": "port",
              "type": "int",
              "help": "the port",
              "presence": "required"
            }
          ],
          "handler_prints": "port={port}"
        }
      ]
    },
    "argv": [
      "cmd",
      "--port=8080"
    ],
    "expect": {
      "exit_code": 0,
      "stdout_equals": "port=8080"
    }
  },
  {
    "name": "int: bad value via equals syntax",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "cmd",
          "help": "a command",
          "effect": "read_only",
          "flags": [
            {
              "name": "port",
              "type": "int",
              "help": "the port",
              "presence": "required"
            }
          ],
          "handler_prints": "port={port}"
        }
      ]
    },
    "argv": [
      "cmd",
      "--port=abc"
    ],
    "expect": {
      "exit_code": 1,
      "stderr_contains": "expected integer",
      "stderr_equals": "error: --port: expected integer, got 'abc'\ntry 'myapp cmd --help'"
    }
  },
  {
    "name": "int: short flag form",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "cmd",
          "help": "a command",
          "effect": "read_only",
          "flags": [
            {
              "name": "port",
              "type": "int",
              "short": "p",
              "help": "the port",
              "presence": "required"
            }
          ],
          "handler_prints": "port={port}"
        }
      ]
    },
    "argv": [
      "cmd",
      "-p",
      "8080"
    ],
    "expect": {
      "exit_code": 0,
      "stdout_equals": "port=8080"
    }
  },
  {
    "name": "int: shown as <int> in help",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "cmd",
          "help": "a command",
          "effect": "read_only",
          "flags": [
            {
              "name": "port",
              "type": "int",
              "help": "the port",
              "presence": "default",
              "default": 8000
            }
          ],
          "handler_prints": "ok"
        }
      ]
    },
    "argv": [
      "cmd",
      "--help"
    ],
    "expect": {
      "exit_code": 0,
      "stdout_contains": "<int>",
      "stdout_equals": "myapp cmd -- a command\n\nFlags:\n  --port <int>    the port [default: 8000]"
    }
  },
  {
    "name": "int: an elected int member delivers its payload under the reserved name value",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "cmd",
          "help": "a command",
          "effect": "read_only",
          "flags": [
            {
              "name": "listen",
              "help": "where to listen",
              "presence": "required",
              "elect_by": "member-flags",
              "choices": [
                {
                  "name": "port",
                  "help": "the port",
                  "value": {
                    "type": "int",
                    "help": "the port"
                  }
                },
                {
                  "name": "socket",
                  "help": "the socket path",
                  "value": {
                    "type": "str",
                    "help": "the socket path"
                  }
                }
              ]
            }
          ],
          "handler_prints": "listen={listen} value={listen.value}"
        }
      ]
    },
    "argv": [
      "cmd",
      "--port",
      "8080"
    ],
    "expect": {
      "exit_code": 0,
      "stdout_equals": "listen=port(value=8080) value=8080"
    }
  },
  {
    "name": "int: optional int arg omitted delivers None",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "cmd",
          "help": "a command",
          "effect": "read_only",
          "args": [
            {
              "name": "count",
              "type": "int",
              "help": "how many",
              "presence": "optional"
            }
          ],
          "handler_prints": "count={count}"
        }
      ]
    },
    "argv": [
      "cmd"
    ],
    "expect": {
      "exit_code": 0,
      "stdout_equals": "count=None"
    }
  }
]
