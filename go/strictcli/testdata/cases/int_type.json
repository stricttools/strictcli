[
  {
    "name": "int: basic int flag parses",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "cmd",
          "help": "a command",
          "effect": "read_only",
          "flags": [
            {
              "name": "port",
              "type": "int",
              "help": "the port",
              "presence": "required"
            }
          ],
          "handler_prints": "port={port}"
        }
      ]
    },
    "argv": [
      "cmd",
      "--port",
      "8080"
    ],
    "expect": {
      "exit_code": 0,
      "stdout_equals": "port=8080"
    }
  },
  {
    "name": "int: default value used when omitted",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "cmd",
          "help": "a command",
          "effect": "read_only",
          "flags": [
            {
              "name": "port",
              "type": "int",
              "help": "the port",
              "presence": "default",
              "default": 8000
            }
          ],
          "handler_prints": "port={port}"
        }
      ]
    },
    "argv": [
      "cmd"
    ],
    "expect": {
      "exit_code": 0,
      "stdout_equals": "port=8000"
    }
  },
  {
    "name": "int: bad value rejected",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "cmd",
          "help": "a command",
          "effect": "read_only",
          "flags": [
            {
              "name": "port",
              "type": "int",
              "help": "the port",
              "presence": "required"
            }
          ],
          "handler_prints": "port={port}"
        }
      ]
    },
    "argv": [
      "cmd",
      "--port",
      "abc"
    ],
    "expect": {
      "exit_code": 1,
      "stderr_contains": [
        "expected integer",
        "'abc'"
      ],
      "stderr_equals": "error: --port: expected integer, got 'abc'\ntry 'myapp cmd --help'"
    }
  },
  {
    "name": "int: env var coerced to int",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "env_prefix": "MYAPP",
      "commands": [
        {
          "name": "cmd",
          "help": "a command",
          "effect": "read_only",
          "flags": [
            {
              "name": "port",
              "type": "int",
              "help": "the port",
              "presence": "default",
              "default": 80,
              "env": "MYAPP_PORT"
            }
          ],
          "handler_prints": "port={port}"
        }
      ]
    },
    "argv": [
      "cmd"
    ],
    "env": {
      "MYAPP_PORT": "9090"
    },
    "expect": {
      "exit_code": 0,
      "stdout_equals": "port=9090"
    }
  },
  {
    "name": "int: bad env var value rejected",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "env_prefix": "MYAPP",
      "commands": [
        {
          "name": "cmd",
          "help": "a command",
          "effect": "read_only",
          "flags": [
            {
              "name": "port",
              "type": "int",
              "help": "the port",
              "presence": "default",
              "default": 80,
              "env": "MYAPP_PORT"
            }
          ],
          "handler_prints": "port={port}"
        }
      ]
    },
    "argv": [
      "cmd"
    ],
    "env": {
      "MYAPP_PORT": "abc"
    },
    "expect": {
      "exit_code": 1,
      "stderr_contains": [
        "expected integer",
        "'abc'"
      ],
      "stderr_equals": "error: --port: expected integer, got 'abc' (from env var 'MYAPP_PORT')\ntry 'myapp cmd --help'"
    }
  },
  {
    "name": "int: required int flag missing produces error",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "cmd",
          "help": "a command",
          "effect": "read_only",
          "flags": [
            {
              "name": "port",
              "type": "int",
              "help": "the port",
              "presence": "required"
            }
          ],
          "handler_prints": "port={port}"
        }
      ]
    },
    "argv": [
      "cmd"
    ],
    "expect": {
      "exit_code": 1,
      "stderr_contains": "required",
      "stderr_equals": "error: flag '--port' is required\ntry 'myapp cmd --help'"
    }
  },
  {
