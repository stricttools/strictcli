  {
    "name": "selector member short: a scoped flag's short with no value is named as typed",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "send",
          "help": "send it",
          "effect": "read_only",
          "handler_prints": "via={via}",
          "flags": [
            {
              "name": "via",
              "help": "delivery channel",
              "presence": "required",
              "elect_by": "selector-token",
              "choices": [
                {
                  "name": "email",
                  "help": "deliver as an email message",
                  "flags": [
                    {
                      "name": "subject",
                      "help": "subject line",
                      "type": "str",
                      "presence": "required",
                      "short": "s"
                    }
                  ]
                },
                {
                  "name": "sms",
                  "help": "deliver as a text message"
                }
              ]
            }
          ]
        }
      ]
    },
    "argv": [
      "send",
      "--via",
      "email",
      "-s"
    ],
    "expect": {
      "exit_code": 1,
      "stderr_equals": "error: flag '-s' requires a value\ntry 'myapp send --help'"
    }
  },
  {
    "name": "selector member short: two sibling members may not share one",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "launch",
          "help": "launch it",
          "effect": "read_only",
          "handler_prints": "ok",
          "flags": [
            {
              "name": "start",
              "help": "how to start",
              "presence": "required",
              "elect_by": "member-flags",
              "choices": [
                {
                  "name": "cont",
                  "help": "continue",
                  "short": "c"
                },
                {
                  "name": "clean",
                  "help": "start clean",
                  "short": "c"
                }
              ]
            }
          ]
        }
      ]
    },
    "argv": [
      "launch"
    ],
    "expect": {
      "exit_code": 1,
      "stderr_equals": "error: command \"launch\": short '-c' is reused by sibling scopes and also claimed by '--cont', which elects: an election token is read before any election has happened, so its short cannot be shared"
    }
  },
  {
    "name": "selector member short: it is claimed against a command-level flag",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "launch",
          "help": "launch it",
          "effect": "read_only",
          "handler_prints": "ok",
          "flags": [
            {
              "name": "start",
              "help": "how to start",
              "presence": "required",
              "elect_by": "member-flags",
              "choices": [
                {
                  "name": "role",
                  "help": "one role",
                  "value": {
                    "type": "str",
                    "help": "the role name",
                    "short": "r"
                  }
                },
                {
                  "name": "plain",
                  "help": "a plain session"
                }
              ]
            },
            {
              "name": "repo",
              "help": "the repo",
              "type": "str",
              "presence": "optional",
              "short": "r"
            }
          ]
        }
      ]
    },
    "argv": [
      "launch"
    ],
    "expect": {
      "exit_code": 1,
      "stderr_equals": "error: command \"launch\": short '-r' is claimed by '--role' and '--repo', which can be elected at the same time"
    }
  }
]
