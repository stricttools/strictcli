[
  {
    "name": "selector member short: a payload-carrying member elects by its short",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "launch",
          "help": "launch it",
          "effect": "read_only",
          "flags": [
            {
              "name": "start",
              "help": "how to start",
              "presence": "required",
              "elect_by": "member-flags",
              "choices": [
                {
                  "name": "role",
                  "help": "one role",
                  "value": {
                    "type": "str",
                    "help": "the role name",
                    "short": "r"
                  }
                },
                {
                  "name": "cont",
                  "help": "continue the previous session",
                  "short": "c"
                },
                {
                  "name": "plain",
                  "help": "a plain session",
                  "short": "p"
                }
              ]
            }
          ],
          "handler_prints": "start={start}"
        }
      ]
    },
    "argv": [
      "launch",
      "-r",
      "admin"
    ],
    "expect": {
      "exit_code": 0,
      "stdout_equals": "start=role(value=admin)"
    }
  },
