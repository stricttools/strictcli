{
  "version": "0.41.1",
  "description": "A CLI framework for the Era of Agents: nothing is inferred, everything is declared. First-class support for Go, Python, and TypeScript",
  "repo": "https://github.com/stricttools/strictcli",
  "source": [
    {
      "path": "python/strictcli/",
      "language": "python"
    },
    {
      "path": "go/strictcli/",
      "language": "go"
    },
    {
      "path": "typescript/src/",
      "language": "typescript"
    }
  ],
  "changelog": ".rlsbl-monorepo/releasables/py-strictcli/CHANGELOG.md",
  "base_url": "https://strictcli.smmh.dev",
  "search_engine": "pagefind",
  "author": {
    "name": "SMMH",
    "url": "https://smmh.dev",
    "same_as": [
      "https://github.com/smm-h"
    ]
  },
  "versions": [
    {
      "version": "0.41.1"
    }
  ],
  "locales": [
    {
      "code": "en",
      "label": "English",
      "default": true
    }
  ],
  "topology": {
    "slug": "strictcli",
    "docs_base": "https://smmh.dev",
    "posts_base": "https://blog.smmh.dev"
  },
  "examples": {
    "python": "uv run --directory python python {file}",
    "go": "scripts/validate-example-go.sh {file}",
    "typescript": "scripts/validate-example-ts.sh {file}"
  },
  "assembly": {
    "repo": "smm-h/selfdoc-cache"
  },
  "root_files": [
    ".stricttools/docs/_README.md",
    ".stricttools/docs/_CLAUDE.md"
  ]
}
