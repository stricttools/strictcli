{
	"name": "strictcli",
	"version": "0.41.0",
	"type": "module",
	"description": "A CLI framework for the Era of Agents: nothing is inferred, everything is declared. First-class support for Go, Python, and TypeScript (TypeScript implementation)",
	"engines": {
		"node": ">=22"
	},
	"license": "MIT",
	"homepage": "https://smmh.dev/strictcli/",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/stricttools/strictcli.git",
		"directory": "typescript"
	},
	"bugs": {
		"url": "https://github.com/stricttools/strictcli/issues"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"types": "./dist/index.d.ts",
	"files": [
		"dist"
	],
	"scripts": {
		"prebuild": "node scripts/gen-version.mjs",
		"build": "tsc",
		"test": "npm run build && tsc -p tsconfig.test.json && node --test \"dist-test/tests/**/*.test.js\"",
		"lint": "biome check .",
		"prepack": "npm run build"
	},
	"dependencies": {
		"smol-toml": "^1.7.0",
		"toml-eslint-parser": "^1.0.3",
		"typescript": "^7.0.2"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.4",
		"@hyperjump/json-schema": "^1.17.8",
		"@types/node": "^22.20.1"
	},
	"keywords": [
		"strictcli",
		"cli",
		"cli-framework",
		"command-line",
		"argument-parser",
		"argparse",
		"framework",
		"rlsbl"
	]
}
