[
  {
    "name": "selector default: a defaulted selection delivers the complete elected value",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "send",
          "help": "send one notification through exactly one channel",
          "effect": "read_only",
          "flags": [
            {
              "name": "via",
              "help": "delivery channel",
              "presence": "default",
              "default": {
                "choice": "webhook"
              },
              "elect_by": "selector-token",
              "choices": [
                {
                  "name": "email",
                  "help": "deliver the notification as an email message",
                  "flags": [
                    {
                      "name": "subject",
                      "help": "subject line of the message",
                      "type": "str",
                      "presence": "required"
                    }
                  ]
                },
                {
                  "name": "webhook",
                  "help": "post the notification to a URL",
                  "flags": [
                    {
                      "name": "url",
                      "help": "where to post",
                      "type": "str",
                      "presence": "default",
                      "default": "https://example.invalid"
                    },
                    {
                      "name": "retries",
                      "help": "delivery attempts before giving up",
                      "type": "int",
                      "presence": "default",
                      "default": 3
                    },
                    {
                      "name": "insecure",
                      "help": "skip certificate verification",
                      "type": "bool",
                      "presence": "default",
                      "default": false
                    }
                  ]
                }
              ]
            }
          ],
          "handler_prints": "via={via}"
        }
      ]
    },
    "argv": [
      "send"
    ],
    "expect": {
      "exit_code": 0,
      "stdout_equals": "via=webhook(url=https://example.invalid, retries=3, insecure=false)"
    }
  },
