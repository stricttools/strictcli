  {
    "name": "selector default: a defaulted member-spelled selector defaults to a payload-less member",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "run",
          "help": "run it",
          "effect": "read_only",
          "handler_prints": "target={target}",
          "flags": [
            {
              "name": "target",
              "help": "which profiles to operate on",
              "presence": "default",
              "default": {
                "choice": "all-profiles"
              },
              "elect_by": "member-flags",
              "choices": [
                {
                  "name": "profile",
                  "help": "one named profile",
                  "value": {
                    "type": "str",
                    "help": "the profile"
                  }
                },
                {
                  "name": "all-profiles",
                  "help": "every profile"
                }
              ]
            }
          ]
        }
      ]
    },
    "argv": [
      "run"
    ],
    "expect": {
      "exit_code": 0,
      "stdout_equals": "target=all-profiles"
    }
  }
]
