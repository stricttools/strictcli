  {
    "name": "selector default: an empty scope renders no parenthesized part at all",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "run",
          "help": "run it",
          "effect": "read_only",
          "flags": [
            {
              "name": "mode",
              "help": "how to run",
              "presence": "default",
              "default": {
                "choice": "simple"
              },
              "elect_by": "selector-token",
              "choices": [
                {
                  "name": "simple",
                  "help": "the simple way"
                },
                {
                  "name": "advanced",
                  "help": "the advanced way",
                  "flags": [
                    {
                      "name": "depth",
                      "help": "how deep to go",
                      "type": "int",
                      "presence": "required"
                    }
                  ]
                }
              ]
            }
          ],
          "handler_prints": "mode={mode}"
        }
      ]
    },
    "argv": [
      "run",
      "--help"
    ],
    "expect": {
      "exit_code": 0,
      "stdout_equals": "myapp run -- run it\n\nFlags:\n  --mode <choice>      how to run [default: simple]\n    simple             the simple way\n    advanced           the advanced way\n      --depth <int>    how deep to go [required]"
    }
  },
