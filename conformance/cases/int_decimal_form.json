[
  {
    "name": "int decimal form: command line accepts '30'",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "cmd",
          "help": "a command",
          "effect": "read_only",
          "flags": [
            {
              "name": "count",
              "type": "int",
              "help": "a count",
              "presence": "required"
            }
          ],
          "handler_prints": "count={count}"
        }
      ]
    },
    "argv": [
      "cmd",
      "--count",
      "30"
    ],
    "expect": {
      "exit_code": 0,
      "stdout_equals": "count=30"
    }
  },
