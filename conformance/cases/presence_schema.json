[
  {
    "name": "help document presence: every flag entry carries presence, and default exactly when presence is default",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "cmd",
          "help": "a command",
          "effect": "read_only",
          "args": [
            {
              "name": "a1",
              "help": "required arg",
              "presence": "required"
            },
            {
              "name": "a2",
              "help": "optional arg",
              "presence": "optional"
            },
            {
              "name": "a3",
              "help": "defaulted arg",
              "presence": "default",
              "default": "out.txt"
            }
          ],
          "flags": [
            {
              "name": "req",
              "help": "required flag",
              "presence": "required"
            },
            {
              "name": "opt",
              "help": "optional flag",
              "presence": "optional"
            },
            {
              "name": "lvl",
              "help": "level",
              "presence": "default",
              "default": "info"
            },
            {
              "name": "flagged",
              "type": "bool",
              "help": "a bool",
              "presence": "default",
              "default": false
            },
            {
              "name": "zero",
              "type": "int",
              "help": "an int",
              "presence": "default",
              "default": 0
            },
            {
              "name": "blank",
              "help": "a blank string",
              "presence": "default",
              "default": ""
            }
          ],
          "handler_prints": "x"
        }
      ]
    },
    "argv": [
      "help",
      "--json"
    ],
    "expect": {
      "exit_code": 0,
      "schema_command_keys": {
        "cmd": {
          "flags": [
            {
              "name": "req",
              "help": "required flag",
              "value_schema": {
                "type": "string"
              },
              "presence": "required"
            },
            {
              "name": "opt",
              "help": "optional flag",
              "value_schema": {
                "type": "string"
              },
              "presence": "optional"
            },
            {
              "name": "lvl",
              "help": "level",
              "value_schema": {
                "type": "string"
              },
              "presence": "default",
              "default": "info"
            },
            {
              "name": "flagged",
              "help": "a bool",
              "value_schema": {
                "type": "boolean"
              },
              "presence": "default",
              "default": false,
              "negatable": true
            },
            {
              "name": "zero",
              "help": "an int",
              "value_schema": {
                "type": "integer"
              },
              "presence": "default",
              "default": 0
            },
            {
              "name": "blank",
              "help": "a blank string",
              "value_schema": {
                "type": "string"
              },
              "presence": "default",
              "default": ""
            }
          ]
        }
      }
    }
  },
