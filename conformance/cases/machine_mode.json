    "expect": {
      "exit_code": 0,
      "stdout_equals": "{\"interface_version\":3,\"app\":\"testapp\",\"app_version\":\"1.0.0\",\"command\":\"check\",\"exit_code\":0,\"payload\":null,\"output\":null,\"dry_run\":false,\"writes\":null,\"preview\":[],\"preview_error\":null,\"diagnostics\":[{\"level\":\"info\",\"message\":\"No checks matched the given filters.\"}]}\n"
    }
  },
  {
    "name": "machine_mode: a dry check run emits one envelope carrying its plan as a diagnostic",
    "app": {
      "name": "testapp",
      "version": "1.0.0",
      "help": "test",
      "commands": [],
      "checks_toml": "app = \"testapp\"\n[checks.lint]\ntags = [\"release\"]\nseverity = \"error\"\nfast = true\npure = false\nneeds_network = false\ndepends_on = []\n",
      "checks": [
        {
          "name": "lint",
          "mint": "passed",
          "message": "all good"
