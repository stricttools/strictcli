    "expect": {
      "exit_code": 0,
      "stdout_matches": "^\\{\"interface_version\":3,[^\\n]*\\}$",
      "stdout_contains": [
        "\"command\":\"check\"",
        "\"level\":\"info\"",
        "Run project checks registered via the check framework"
      ]
    }
  },
  {
    "name": "machine_mode: check with no matching tag emits one envelope, not a second line",
    "app": {
      "name": "testapp",
      "version": "1.0.0",
      "help": "test",
      "commands": [],
      "checks_toml": "app = \"testapp\"\n[checks.lint]\ntags = [\"release\"]\nseverity = \"error\"\nfast = true\npure = true\nneeds_network = false\ndepends_on = []\n",
      "checks": [
        {
          "name": "lint",
          "mint": "passed",
          "message": "all good"
        }
      ]
    },
    "argv": [
      "--json",
      "check",
      "--tag",
      "nonexistent"
