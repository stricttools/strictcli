      "stdout_equals": "{\"interface_version\":3,\"app\":\"testapp\",\"app_version\":\"1.0.0\",\"command\":\"check\",\"exit_code\":0,\"payload\":[],\"output\":null,\"dry_run\":true,\"writes\":null,\"preview\":[],\"preview_error\":null,\"diagnostics\":[{\"level\":\"info\",\"message\":\"Would run 1 check:\\n  1. lint [impure]\"}]}\n"
    }
  }
]
