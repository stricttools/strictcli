      "start"
    ],
    "expect": {
      "exit_code": 0,
      "stdout_equals": "DRY RUN \u2014 no changes were made. Would do:\n  1. spawn: worker --daemon (granted: worker \u2014 the supervisor owns worker lifecycles)\n"
    }
  },
  {
    "name": "effects_grants: one file_write grant labels every path-mutating verb",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "layout",
          "help": "rearrange the tree",
          "effect": "mutating",
          "grants": [
            {
              "name": "tree",
              "reason": "the generator owns the build tree",
              "kind": "file_write"
            }
          ],
          "handler_effects": [
            {
              "method": "write",
              "path": "a.txt",
              "content": "hi",
              "grant": "tree"
            },
            {
              "method": "mkdir",
              "path": "d",
              "grant": "tree"
            },
            {
              "method": "remove",
              "path": "old",
              "grant": "tree"
            },
            {
              "method": "rename",
              "path": "a.txt",
              "to": "b.txt",
              "grant": "tree"
            },
            {
              "method": "chmod",
              "path": "b.txt",
              "mode": "644",
              "grant": "tree"
            }
          ]
        }
      ]
    },
    "argv": [
      "--dry-run",
      "layout"
    ],
    "expect": {
      "exit_code": 0,
      "stdout_equals": "DRY RUN \u2014 no changes were made. Would do:\n  1. write: a.txt (2 bytes) (granted: tree \u2014 the generator owns the build tree)\n  2. mkdir: d (granted: tree \u2014 the generator owns the build tree)\n  3. remove: old (granted: tree \u2014 the generator owns the build tree)\n  4. rename: a.txt -> b.txt (granted: tree \u2014 the generator owns the build tree)\n  5. chmod: b.txt 0644 (granted: tree \u2014 the generator owns the build tree)\n"
    }
  },
  {
    "name": "effects_grants: a grant on an allowlisted observe is a call-time error",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "proc_observe_allowlist": [
        [
          "git",
          "status"
        ]
      ],
      "commands": [
        {
          "name": "report",
          "help": "observe the tree",
          "effect": "mutating",
          "grants": [
            {
              "name": "inspect",
              "reason": "the auditor reads the work tree",
              "kind": "proc_mutate"
            }
          ],
          "handler_effects": [
            {
              "method": "run",
              "argv": [
                "git",
                "status"
              ],
              "grant": "inspect"
            }
          ]
        }
      ]
    },
    "argv": [
      "--dry-run",
      "report"
    ],
    "expect": {
      "exit_code": 1,
      "exit_code_by_target": {
        "go": 2
      },
      "stderr_contains": "command \"report\": grant 'inspect' cannot be used on an observe (an allowlisted effects.run changes nothing)"
    }
  },
  {
    "name": "effects_grants: grant-on-observe is decided by the argv, not the classification",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "proc_observe_allowlist": [
        [
          "git",
          "status"
        ]
      ],
      "commands": [
        {
          "name": "report",
          "help": "observe the tree",
          "effect": "read_only",
          "grants": [
            {
              "name": "inspect",
              "reason": "the auditor reads the work tree",
              "kind": "proc_mutate"
            }
          ],
          "handler_effects": [
            {
              "method": "run",
              "argv": [
                "git",
                "status"
              ],
              "grant": "inspect"
            }
          ]
        }
      ]
    },
    "argv": [
      "report"
    ],
    "expect": {
      "exit_code": 1,
      "exit_code_by_target": {
        "go": 2
      },
      "stderr_contains": "command \"report\": grant 'inspect' cannot be used on an observe (an allowlisted effects.run changes nothing)"
    }
  },
  {
