  {
    "name": "effects_grants: an invalid grant name is a registration error",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "release",
          "help": "push a release",
          "effect": "mutating",
          "grants": [
            {
              "name": "Push",
              "reason": "release engine owns remote refs",
              "kind": "proc_mutate"
            }
          ],
          "handler_prints": "released"
        }
      ]
    },
    "argv": [
      "release"
    ],
    "expect": {
      "exit_code": 1,
      "stderr_contains": "command \"release\": invalid grant name 'Push': must be lowercase kebab-case of at least two characters: [a-z][a-z0-9]*(-[a-z0-9]+)*"
    }
  },
  {
    "name": "effects_grants: an invalid grant kind is a registration error",
    "skip_schema_validation": true,
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "release",
          "help": "push a release",
          "effect": "mutating",
          "grants": [
            {
              "name": "push",
              "reason": "release engine owns remote refs",
              "kind": "cache_write"
            }
          ],
          "handler_prints": "released"
        }
      ]
    },
    "argv": [
      "release"
    ],
    "expect": {
      "exit_code": 1,
      "stderr_contains": "command \"release\": grant 'push' has invalid kind 'cache_write': must be one of proc_mutate, proc_spawn, file_write, net_mutate"
    }
