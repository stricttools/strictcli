[
  {
    "name": "effects_grants: an undeclared grant name is a call-time error",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "release",
          "help": "push a release",
          "effect": "mutating",
          "grants": [
            {
              "name": "push",
              "reason": "release engine owns remote refs",
              "kind": "proc_mutate"
            }
          ],
          "handler_effects": [
            {
              "method": "run",
              "argv": [
                "git",
                "push"
              ],
              "grant": "publish"
            }
          ]
        }
      ]
    },
    "argv": [
      "--dry-run",
      "release"
    ],
    "expect": {
      "exit_code": 1,
      "exit_code_by_target": {
        "go": 2
      },
      "stderr_contains": "command \"release\": grant 'publish' is not declared on this command"
    }
  },
  {
    "name": "effects_grants: a grant with no declarations at all is a call-time error",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "release",
          "help": "push a release",
          "effect": "mutating",
          "handler_effects": [
            {
              "method": "run",
              "argv": [
                "git",
                "push"
              ],
              "grant": "push"
            }
          ]
        }
      ]
    },
    "argv": [
      "--dry-run",
      "release"
    ],
    "expect": {
      "exit_code": 1,
      "exit_code_by_target": {
        "go": 2
      },
      "stderr_contains": "command \"release\": grant 'push' is not declared on this command"
    }
  },
  {
    "name": "effects_grants: a grant used for the wrong effect kind is a call-time error",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "release",
          "help": "push a release",
          "effect": "mutating",
          "grants": [
            {
              "name": "push",
              "reason": "release engine owns remote refs",
              "kind": "proc_mutate"
            }
          ],
          "handler_effects": [
            {
              "method": "write",
              "path": "VERSION",
              "content": "1.2.3",
              "grant": "push"
            }
          ]
        }
      ]
    },
    "argv": [
      "--dry-run",
      "release"
    ],
    "expect": {
      "exit_code": 1,
      "exit_code_by_target": {
        "go": 2
      },
      "stderr_contains": "command \"release\": grant 'push' is declared for kind proc_mutate but was used for a file_write effect"
    }
  },
  {
    "name": "effects_grants: a spawn grant does not authorize a run",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "start",
          "help": "start a worker",
          "effect": "mutating",
          "grants": [
            {
              "name": "worker",
              "reason": "the supervisor owns worker lifecycles",
              "kind": "proc_spawn"
            }
          ],
          "handler_effects": [
            {
              "method": "run",
              "argv": [
                "worker",
                "--once"
              ],
              "grant": "worker"
            }
          ]
        }
      ]
    },
    "argv": [
      "--dry-run",
      "start"
    ],
    "expect": {
      "exit_code": 1,
      "exit_code_by_target": {
        "go": 2
      },
      "stderr_contains": "command \"start\": grant 'worker' is declared for kind proc_spawn but was used for a proc_mutate effect"
    }
  },
  {
    "name": "effects_grants: a net_mutate grant labels an http effect",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "publish",
          "help": "publish a release",
          "effect": "mutating",
          "grants": [
            {
              "name": "gh-api",
              "reason": "the release bot owns GitHub releases",
              "kind": "net_mutate"
            }
          ],
          "handler_effects": [
            {
              "method": "http",
              "http_method": "POST",
              "url": "https://api.example.com/releases",
              "grant": "gh-api"
            }
          ]
        }
      ]
    },
    "argv": [
      "--dry-run",
      "publish"
    ],
    "expect": {
      "exit_code": 0,
      "stdout_equals": "DRY RUN \u2014 no changes were made. Would do:\n  1. net: POST https://api.example.com/releases (granted: gh-api \u2014 the release bot owns GitHub releases)\n"
    }
  },
  {
