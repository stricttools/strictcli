[
  {
    "name": "naming rule: an uppercase command name is refused",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "Run",
          "help": "a command",
          "effect": "read_only",
          "handler_prints": "ok"
        }
      ]
    },
    "argv": [
      "run"
    ],
    "expect": {
      "exit_code": 1,
      "stdout_equals": "",
      "stderr_equals": "error: command name \"Run\" must be lowercase kebab-case of at least two characters: [a-z][a-z0-9]*(-[a-z0-9]+)*"
    }
  },
