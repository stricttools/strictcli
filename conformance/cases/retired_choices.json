  {
    "name": "retired choices: an int-typed retired spelling formats like every other value",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "cmd",
          "help": "a command",
          "effect": "read_only",
          "handler_prints": "port={port}",
          "flags": [
            {
              "name": "port",
              "type": "int",
              "help": "the port",
              "presence": "required",
              "choices_int": [
                {
                  "value": 80
                },
                {
                  "value": 443
                }
              ],
              "retired_choices_int": [
                {
                  "value": 8080,
                  "message": "use 443 (the plaintext port was dropped)"
                }
              ]
            }
          ]
        }
      ]
    },
    "argv": [
      "cmd",
      "--port",
      "8080"
    ],
    "expect": {
      "exit_code": 1,
      "stderr_equals": "error: --port: value '8080' retired: use 443 (the plaintext port was dropped)\ntry 'myapp cmd --help'"
    }
  },
