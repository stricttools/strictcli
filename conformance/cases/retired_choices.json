[
  {
    "name": "retired choices: a retired flag value is refused, naming its replacement",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "cmd",
          "help": "a command",
          "effect": "read_only",
          "handler_prints": "format={format}",
          "flags": [
            {
              "name": "format",
              "type": "str",
              "help": "output format",
              "presence": "required",
              "choices_str": [
                {
                  "value": "text"
                },
                {
                  "value": "json"
                }
              ],
              "retired_choices_str": [
                {
                  "value": "xml",
                  "message": "use 'json' (XML output was dropped)"
                }
              ]
            }
          ]
        }
      ]
    },
    "argv": [
      "cmd",
      "--format",
      "xml"
    ],
    "expect": {
      "exit_code": 1,
      "stderr_equals": "error: --format: value 'xml' retired: use 'json' (XML output was dropped)\ntry 'myapp cmd --help'"
    }
  },
  {
    "name": "retired choices: a retired arg value is refused, naming its replacement",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "cmd",
          "help": "a command",
          "effect": "read_only",
          "handler_prints": "mode={mode}",
          "args": [
            {
              "name": "mode",
              "type": "str",
              "help": "the mode",
              "presence": "required",
              "choices_str": [
                {
                  "value": "fast"
                },
                {
                  "value": "slow"
                }
              ],
              "retired_choices_str": [
                {
                  "value": "turbo",
                  "message": "use 'fast' (turbo was renamed)"
                }
              ]
            }
          ]
        }
      ]
    },
    "argv": [
      "cmd",
      "turbo"
    ],
    "expect": {
      "exit_code": 1,
      "stderr_equals": "error: argument 'mode': value 'turbo' retired: use 'fast' (turbo was renamed)\ntry 'myapp cmd --help'"
    }
  },
