[
  {
    "name": "config set: duplicate value on unique repeatable flag",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "config": true,
      "config_content": "{}",
      "commands": [
        {
          "name": "run",
          "help": "run command",
          "effect": "read_only",
          "handler_prints": "ok",
          "flags": [
            {
              "name": "tags",
              "help": "the tags",
              "presence": "required",
              "type": "str",
              "repeatable": true,
              "unique": true
            }
          ]
        }
      ]
    },
    "argv": [
      "config",
      "set",
      "tags",
      "--value",
      "a,a"
    ],
    "expect": {
      "exit_code": 1,
      "stdout_equals": "",
      "stderr_equals": "error: config set: key 'tags': duplicate value 'a'\n"
    }
  },
  {
    "name": "config set: --clear on repeatable flag succeeds",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "config": true,
      "config_content": "{\"tags\": [\"x\", \"y\"]}",
      "commands": [
        {
          "name": "run",
          "help": "run command",
          "effect": "read_only",
          "handler_prints": "ok",
          "flags": [
            {
              "name": "tags",
              "help": "the tags",
              "presence": "required",
              "type": "str",
              "repeatable": true,
              "unique": false
            }
          ]
        }
      ]
    },
    "argv": [
      "config",
      "set",
      "tags",
      "--clear"
    ],
    "expect": {
      "exit_code": 0
    }
  },
