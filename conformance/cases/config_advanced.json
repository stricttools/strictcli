          "handler_prints": "ok",
          "flags": [
            {
              "name": "count",
              "help": "a count",
              "presence": "default",
              "type": "int",
              "default": 0
            },
            {
              "name": "debug",
              "help": "debug mode",
              "presence": "default",
              "type": "bool",
              "default": false
            },
            {
              "name": "rate",
              "help": "a rate",
              "presence": "default",
              "type": "float",
              "default": 0.0
            }
          ]
        }
      ]
    },
    "argv": [
      "config",
      "show",
      "--plain"
    ],
    "expect": {
      "exit_code": 0,
      "stdout_contains": [
        "count = 42  (source: config)",
        "rate = 3.14  (source: config)",
        "debug ="
      ]
    }
  },
  {
    "name": "config: precedence - config wins over default",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "config": true,
      "config_format": "toml",
      "config_content": "port = 9090",
      "commands": [
        {
          "name": "run",
          "help": "run command",
          "effect": "read_only",
          "handler_prints": "port={port}",
          "flags": [
            {
              "name": "port",
              "help": "port number",
              "presence": "default",
              "type": "int",
              "default": 80,
              "env": "APP_PORT"
            }
          ]
        }
      ]
    },
    "argv": [
      "run"
    ],
    "expect": {
      "exit_code": 0,
      "stdout_equals": "port=9090"
    }
  },
