[
  {
    "name": "config: TOML config loading with typed values via config show",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "config": true,
      "config_format": "toml",
      "config_content": "count = 42\ndebug = true\nrate = 3.14",
      "commands": [
        {
          "name": "run",
          "help": "run command",
          "effect": "read_only",
          "handler_prints": "ok",
          "flags": [
            {
              "name": "count",
              "help": "a count",
              "presence": "default",
              "type": "int",
              "default": 0
            },
            {
              "name": "debug",
              "help": "debug mode",
              "presence": "default",
              "type": "bool",
              "default": false
            },
            {
              "name": "rate",
              "help": "a rate",
              "presence": "default",
              "type": "float",
              "default": 0.0
            }
          ]
        }
      ]
    },
    "argv": [
      "config",
      "show",
      "--plain"
    ],
    "expect": {
      "exit_code": 0,
      "stdout_contains": [
        "count = 42",
        "(source: config)",
        "rate = 3.14",
        "debug ="
      ]
    }
  },
  {
