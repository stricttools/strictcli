  {
    "name": "config: config init refuses an existing file through the error writer",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "config": true,
      "config_format": "toml",
      "config_content": "",
      "commands": [
        {
          "name": "run",
          "help": "run command",
          "effect": "read_only",
          "handler_prints": "ok",
          "flags": [
            {
              "name": "count",
              "help": "a count",
              "presence": "default",
              "type": "int",
              "default": 0
            }
          ]
        }
      ]
    },
    "argv": [
      "config",
      "init"
    ],
    "expect": {
      "exit_code": 1,
      "stdout_equals": "",
      "stderr_matches": "\\Aerror: config init: config file already exists: [^\\n]+\\.toml\\n\\Z"
    }
  },
