      "config_format": "toml",
      "config_content": "size = 1e17",
      "commands": [
        {
          "name": "run",
          "help": "run command",
          "effect": "read_only",
          "handler_prints": "ok",
          "flags": [
            {
              "name": "size",
              "help": "how big",
              "presence": "default",
              "type": "float",
              "default": 0.0
            }
          ]
        }
      ]
    },
    "argv": [
      "config",
      "show",
      "--plain"
    ],
    "expect": {
      "exit_code": 0,
      "stdout_contains": [
