[
  {
    "name": "help document: help --json prints the document on stdout and the --json document on stderr",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "greet",
          "help": "say hello",
          "effect": "read_only",
          "handler_prints": "hello"
        }
      ]
    },
    "argv": [
      "help",
      "--json"
    ],
    "expect": {
      "exit_code": 0,
      "stdout_contains": "\"schema_version\": 2,",
      "stderr_equals": "{\"interface_version\":3,\"app\":\"myapp\",\"app_version\":\"1.0.0\",\"command\":\"help\",\"exit_code\":0,\"payload\":null,\"output\":null,\"dry_run\":false,\"writes\":null,\"preview\":[],\"preview_error\":null,\"diagnostics\":[]}\n"
    }
  },
  {
    "name": "help document: --dump-schema is refused, naming help --json",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "greet",
          "help": "say hello",
          "effect": "read_only",
          "handler_prints": "hello"
        }
      ]
    },
    "argv": [
      "--dump-schema"
    ],
    "expect": {
      "exit_code": 1,
      "stdout_equals": "",
      "stderr_equals": "error: --dump-schema is not supported; the app's help document is printed by 'myapp help --json'\ntry 'myapp --help'\n"
    }
  },
  {
    "name": "help document: a declared payload schema is published verbatim",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "report",
          "help": "produce a report",
          "effect": "read_only",
          "payload_schema": {
            "type": "object",
            "properties": {
              "name": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "counts": {
                "type": "array",
                "items": {
                  "type": "integer"
                }
              },
              "status": {
                "enum": [
                  "pass",
                  "fail"
                ]
              },
              "kind": {
                "const": "report"
              }
            },
            "required": [
              "name",
              "status"
            ],
            "additionalProperties": {
              "type": "string"
            }
          },
          "handler_prints": "reported"
        },
        {
          "name": "plain",
          "help": "declare nothing",
          "effect": "read_only",
          "handler_prints": "plain"
        }
      ]
    },
    "argv": [
      "help",
      "--json"
    ],
    "expect": {
      "exit_code": 0,
      "schema_command_keys": {
        "report": {
          "payload_schema": {
            "type": "object",
            "properties": {
              "name": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "counts": {
                "type": "array",
                "items": {
                  "type": "integer"
                }
              },
              "status": {
                "enum": [
                  "pass",
                  "fail"
                ]
              },
              "kind": {
                "const": "report"
              }
            },
            "required": [
              "name",
              "status"
            ],
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      },
      "schema_command_absent_keys": {
        "plain": [
          "payload_schema"
        ]
      }
    }
  }
]
