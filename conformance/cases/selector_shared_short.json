[
  {
    "name": "shared short: it binds to the first-declared scope's flag when that scope is elected",
    "app": {
      "name": "myapp",
      "version": "1.0.0",
      "help": "test app",
      "commands": [
        {
          "name": "send",
          "help": "send it",
          "effect": "read_only",
          "flags": [
            {
              "name": "via",
              "help": "delivery channel",
              "presence": "required",
              "elect_by": "selector-token",
              "choices": [
                {
                  "name": "email",
                  "help": "an email",
                  "flags": [
                    {
                      "name": "subject",
                      "type": "str",
                      "help": "the subject",
                      "presence": "optional",
                      "short": "x"
                    },
                    {
                      "name": "urgent",
                      "type": "bool",
                      "help": "mark urgent",
                      "presence": "default",
                      "default": false,
                      "short": "u"
                    }
                  ]
                },
                {
                  "name": "sms",
                  "help": "a text",
                  "flags": [
                    {
                      "name": "phone",
                      "type": "str",
                      "help": "destination",
                      "presence": "optional",
                      "short": "x"
                    },
                    {
                      "name": "flash",
                      "type": "bool",
                      "help": "a flash message",
                      "presence": "default",
                      "default": false,
                      "short": "u"
                    }
                  ]
                },
                {
                  "name": "post",
                  "help": "a letter",
                  "flags": [
                    {
                      "name": "street",
                      "type": "str",
                      "help": "the street",
                      "presence": "optional"
                    }
                  ]
                }
              ]
            }
          ],
          "handler_prints": "via={via}"
        }
      ]
    },
    "argv": [
      "send",
      "--via",
      "email",
      "-x",
      "2"
    ],
    "expect": {
      "exit_code": 0,
      "stdout_equals": "via=email(subject=2, urgent=false)",
      "stderr_equals": ""
    }
  },
